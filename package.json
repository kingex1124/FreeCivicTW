{
  "name": "freecivictw",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-static-assets.mjs && next dev",
    "build": "node scripts/prepare-static-assets.mjs && tsx scripts/validate-data.ts && next build",
    "build:preview": "node scripts/build-preview.mjs",
    "preview": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:dev": "playwright test --config=playwright.dev.config.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run validate:data"
  },
  "dependencies": {
    "@next/third-parties": "16.4.6",
    "@tailwindcss/postcss": "4.3.5",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
