  "journeys": [
    {
      "id": "criminal",
      "title": "一件刑事案件，怎麼走？",
      "intro": "跟著一份案件資料，認識警察、檢察官和法院的分工。",
      "notice": "這是一般公訴程序的教學示意。也可依法直接向檢察官提出告訴、告發；不起訴、緩起訴及特殊程序可能走不同分支，並非每案都會進法院。",
      "steps": [
        {
          "nodeId": "police-justice-police-stations",
          "title": "向警察說明發生什麼事",
          "text": "警察受理報案、記錄事實，依法調查及蒐集證據。受理報案不等於已經認定任何人有罪。",
          "connection": null
        },
        {
          "nodeId": "prosecution-justice-district-prosecutors",
          "title": "檢察官依法偵查",
          "text": "案件資料依法移送或由檢察官直接受理後，檢察官進行偵查，也可依法指揮司法警察調查。",
          "connection": "移送資料、依法偵查"
        },
        {
          "nodeId": "prosecution-justice-prosecutors",
          "title": "決定是否起訴",
          "text": "依案件事實與法律，可能起訴、不起訴或緩起訴。不是資料一送出，就一定會起訴。",
          "connection": "依法作成處分"
        },
        {
          "nodeId": "courts-justice-district-courts",
          "title": "起訴後，由法院審判",
          "text": "進入法院後，由法官依法獨立審判。檢察官在法庭上實行公訴；法院不必照檢察官的主張作判決。",
          "connection": "符合要件時起訴，由法院審判"
        }
      ]
    },
    {
      "id": "cabinet",
      "title": "行政團隊，是誰組成的？",
      "intro": "從選票走到任命，分清楚人民選出誰、誰再依法任命誰。",
      "notice": "以一般中央行政團隊示意。總統、副總統是一組選出；部長由行政院長提請總統任命。大法官等憲政人事另有提名與立法院同意等程序。",
      "steps": [
        {
          "nodeId": "central-role-people",
          "title": "人民依法投票",
          "text": "具資格的選民選出總統、副總統一組。這張選票不是直接選出行政院長或各部部長。",
          "connection": null
        },
        {
          "nodeId": "central-role-president",
          "title": "總統任命行政院長",
          "text": "總統依憲法程序任命行政院長。總統與副總統的職權不同，並不是兩人都能各自任命部長。",
          "connection": "依法選出總統、副總統"
        },
        {
          "nodeId": "central-role-premier",
          "title": "行政院長提請任命部長",
          "text": "行政院長領導行政團隊，提請總統任命各部部長；不是民眾另外投一張部長選票。",
          "connection": "總統任命行政院長"
        },
        {
          "nodeId": "central-role-ministers",
          "title": "各部依法推動業務、接受監督",
          "text": "各部長在自己的主管業務內施政、編列及執行預算，並依法接受立法院質詢與監督。",
          "connection": "行政院長提請，總統任命"
        },
        {
          "nodeId": "central-role-legislator",
          "title": "立法委員依法監督行政團隊",
          "text": "立委審議法律、預算並依法質詢，不能因為監督行政機關，就取代行政機關執行業務或命令法官判決。",
          "connection": "依法質詢與監督（此步是監督關係）",
          "reverse": true
        }
      ]
    },
    {
      "id": "local-life",
      "title": "地方的交通問題，可以找誰？",
      "intro": "用一個虛構的交通改善問題，認識民眾、首長、局處與議會。",
      "notice": "這是地方自治分工的假設情境，不代表所有道路都由地方政府管理。國道、省道、市區道路與交通執法的權責不同，仍須確認道路及業務主管機關。",
      "steps": [
        {
          "nodeId": "local-role-people",
          "title": "居民提出具體問題",
          "text": "把地點、時間與需要改善的狀況說清楚，可向主管機關陳情或透過民代服務處反映。選民服務不保證一定有特定結果。",
          "connection": null
        },
        {
          "nodeId": "local-agency-local-transport",
          "title": "交通單位確認權責、研議改善",
          "text": "地方交通單位依權責處理交通規劃與公共運輸等業務；若屬其他機關業務，須依實際分工處理。",
          "connection": "反映問題，確認承辦權責"
        },
        {
          "nodeId": "local-role-county-chief",
          "title": "地方首長協調施政與資源",
          "text": "縣市首長帶領地方行政團隊，依法提出施政及預算。不能跳過法律、預算與必要程序，直接保證所有改善工程。",
          "connection": "地方行政團隊依法分工"
        },
        {
          "nodeId": "local-role-county-council",
          "title": "議會審議預算、依法質詢",
          "text": "議員可就主管業務向首長與相關局處首長依法質詢，並審議預算。議員不是交通局長的上司，不能自行決標或指揮承包商。",
          "connection": "依法審議與監督（此步是監督關係）",
          "reverse": true
        }
      ]
    }
  ],
