ull\n      }\n    },\n    {\n      \"id\": \"sport\",\n      \"number\": 9,\n      \"name\": {\n        \"zh\": \"運動政策\",\n        \"en\": \"Sport\"\n      },\n      \"summary\": {\n        \"zh\": \"從自家門口到國際舞台，打造包容每個市民的運動生態系\",\n        \"en\": null\n      },\n      \"heart\": [\n        \"H\",\n        \"E\",\n        \"T\"\n      ],\n      \"heartLabel\": {\n        \"zh\": \"H、E、T\",\n        \"en\": null\n      },\n      \"url\": \"https://puma.taipei/policies/運動政策\",\n      \"sources\": [\n        \"sport\"\n      ],\n      \"sourceKind\": \"official_policy\",\n      \"axial\": [\n        -2,\n        6\n      ],\n      \"cells\": [\n        [\n          -2,\n          6\n        ]\n      ],\n      \"buildings\": [\n        {\n          \"id\": \"sport-bus\",\n          \"name\": {\n            \"zh\": \"社區運動小巴\",\n            \"en\": \"Community sport bus\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"專業運動指導\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"營養諮詢\",\n              \"en\": null\n            }\n          ],\n          \"phase\": {\n            \"label\": {\n              \"zh\": \"第 1 年試辦；第 2–3 年擴大巡迴路線\",\n              \"en\": null\n            },\n            \"stages\": [\n              \"year1\",\n              \"year2-3\"\n            ],\n            \"basis\": \"official\"\n          },\n          \"flows\": [\n            \"F1\",\n            \"F7\",\n            \"F8\",\n            \"F13\"\n          ],\n          \"sources\": [\n            \"sport\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"運動小巴開到家門口，優先照顧因距離或行動不便而放棄運動的人，並提供運動指導與營養諮詢。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"因距離或行動不便放棄運動的市民\",\n            \"en\": null\n          }\n        },\n        {\n          \"id\": \"sport-spots\",\n          \