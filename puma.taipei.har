            "size": 62800,
            "mimeType": "text/css",
            "text": ":root {\n  --coral: #db6a41;\n  --ink: #211d1d;\n  --cream: #fff8f4;\n  --yellow: #fcea8b;\n  --line: #211d1d26;\n  --muted: #78685e;\n}\n* {\n  box-sizing: border-box;\n}\nbody {\n  margin: 0;\n  background: #e7d9cd;\n  color: var(--ink);\n  font-family: \"Noto Sans TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif;\n}\nbutton,\ninput,\na {\n  font: inherit;\n}\nbutton,\na {\n  touch-action: manipulation;\n}\nbutton {\n  cursor: pointer;\n  border: 1px solid var(--line);\n  background: var(--cream);\n  color: var(--ink);\n  min-height: 44px;\n  border-radius: 9px;\n  padding: 9px 13px;\n}\nbutton:hover {\n  background: var(--yellow);\n}\nbutton:focus-visible,\na:focus-visible,\ninput:focus-visible,\nsummary:focus-visible {\n  outline: 3px solid var(--coral);\n  outline-offset: 3px;\n}\nbutton[aria-pressed=\"true\"],\nbutton.active {\n  background: var(--ink);\n  color: var(--cream);\n}\na {\n  color: inherit;\n  text-underline-offset: 4px;\n}\nh1,\nh2,\nh3,\np {\n  margin: 0;\n}\n#app {\n  position: relative;\n  width: 100%;\n  height: 100dvh;\n  min-height: 660px;\n  overflow: hidden;\n  background: radial-gradient(ellipse at 44% 35%, #fffdf9 0%, #fff8f4 44%, #edddcf 100%);\n}\n#stage {\n  position: absolute;\n  inset: 0 318px 0 0;\n  touch-action: none;\n}\n#stage canvas {\n  display: block;\n  width: 100%;\n  height: 100%;\n  outline: none;\n}\n#labels {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  overflow: hidden;\n}\n.island-label {\n  pointer-events: auto;\n  font-size: 11px;\n  padding: 3px 8px;\n  min-height: 28px;\n  border: 1px solid #211d1d35;\n  border-radius: 5px;\n  background: #fff8f4ed;\n  box-shadow: 0 2px 0 #211d1d14;\n  white-space: nowrap;\n  transition: opacity 0.2s;\n}\n.island-label strong {\n  color: var(--coral);\n  font:\n    700 10px ui-monospace,\n    monospace;\n  margin-right: 5px;\n}\n.island-label.selected {\n  background: var(--ink);\n  color: var(--cream);\n  border-color: var(--coral);\n}\n.island-label.dim {\n  opacity: 0.28;\n}\n.island-label.selected strong {\n  color: var(--yellow);\n}\n.port-label {\n  font-size: 9px;\n  background: #fff8f4dd;\n  border: 1px dashed #78685e;\n  padding: 3px 6px;\n  border-radius: 4px;\n}\n.brand {\n  position: absolute;\n  top: 28px;\n  left: 32px;\n  pointer-events: none;\n  z-index: 2;\n}\n.eyebrow {\n  font:\n    700 10px ui-monospace,\n    monospace;\n  letter-spacing: 2px;\n}\n.brand .future {\n  pointer-events: auto;\n  text-decoration: none;\n  font:\n    900 clamp(24px, 3vw, 42px) / 0.95 Arial,\n    sans-serif;\n  letter-spacing: -2px;\n  color: var(--coral);\n}\n.brand .future span {\n  display: block;\n}\n.brand h1 {\n  font-size: 19px;\n  letter-spacing: 4px;\n  margin-top: 12px;\n}\n.brand .candidate {\n  font-size: 12px;\n  margin-top: 8px;\n}\n.brand .candidate b {\n  margin-right: 10px;\n}\n.hero-note {\n  position: absolute;\n  left: 32px;\n  top: 190px;\n  max-width: 180px;\n  pointer-events: none;\n}\n.hero-note .number {\n  font:\n    italic 60px/0.95 Georgia,\n    serif;\n  color: var(--coral);\n}\n.hero-note h2 {\n  font-size: 17px;\n  line-height: 1.5;\n  margin: 8px 0;\n}\n.hero-note p {\n  font-size: 11px;\n  color: var(--muted);\n  line-height: 1.8;\n}\n.map-meta {\n  position: absolute;\n  left: 32px;\n  bottom: 236px;\n  font:\n    10px/1.8 ui-monospace,\n    monospace;\n  color: var(--muted);\n  pointer-events: none;\n}\n.toolbar {\n  position: absolute;\n  right: 338px;\n  top: 28px;\n  display: flex;\n  gap: 7px;\n  z-index: 5;\n}\n.toolbar button {\n  background: #fff8f4e8;\n  font-size: 12px;\n}\n.sidebar {\n  position: absolute;\n  right: 0;\n  top: 0;\n  bottom: 42px;\n  width: 318px;\n  background: #fff8f4e8;\n  border-left: 1px solid var(--line);\n  display: flex;\n  flex-direction: column;\n  z-index: 7;\n  backdrop-filter: blur(16px);\n}\n.side-head {\n  padding: 29px 22px 16px;\n}\n.side-head .eyebrow {\n  color: var(--coral);\n  margin-bottom: 10px;\n}\n.side-head h2 {\n  font-size: 24px;\n  font-weight: 900;\n}\n.side-head p {\n  font-size: 11px;\n  color: var(--muted);\n  margin: 9px 0 16px;\n  line-height: 1.6;\n}\n.search {\n  color: var(--ink);\n  -webkit-text-fill-color: var(--ink);\n  width: 100%;\n  height: 44px;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: #fffdfb;\n  padding: 10px 12px;\n  font-size: 13px;\n}\n.side-tabs {\n  display: flex;\n  gap: 5px;\n  margin: 12px 0 0;\n}\n.side-tabs button {\n  flex: 1;\n  font-size: 12px;\n  padding: 6px;\n}\n.tree {\n  overflow: auto;\n  padding: 0 15px 20px;\n  scrollbar-width: thin;\n}\n.tree details {\n  border-bottom: 1px solid var(--line);\n}\n.tree summary {\n  min-height: 56px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  cursor: pointer;\n  list-style: none;\n  padding: 8px;\n}\n.tree summary::-webkit-details-marker {\n  display: none;\n}\n.tree .index {\n  font:\n    italic 22px Georgia,\n    serif;\n  color: var(--coral);\n  width: 25px;\n  flex: none;\n}\n.tree .item-name {\n  font-size: 13px;\n  font-weight: 700;\n  flex: 1;\n}\n.tree .count {\n  font:\n    10px ui-monospace,\n    monospace;\n  color: var(--muted);\n}\n.tree details[open] summary {\n  background: #fcea8b55;\n  border-radius: 7px;\n}\n.tree .children {\n  padding: 0 8px 10px 40px;\n  display: grid;\n  gap: 3px;\n}\n.tree .children button {\n  font-size: 12px;\n  text-align: left;\n  border: 0;\n  background: transparent;\n  padding: 7px 9px;\n}\n.tree .children button:hover {\n  background: #fcea8b88;\n}\n.tree .island-open {\n  font-weight: 700;\n  color: var(--coral);\n}\n.flow-item {\n  width: 100%;\n  margin-bottom: 7px;\n  text-align: left;\n  font-size: 12px;\n  line-height: 1.6;\n}\n.flow-item b {\n  color: var(--coral);\n  margin-right: 7px;\n}\n.card {\n  position: absolute;\n  left: 30px;\n  top: 176px;\n  bottom: 248px;\n  width: 340px;\n  background: #fff8f4f7;\n  border: 1px solid var(--line);\n  border-radius: 14px;\n  box-shadow: 0 16px 60px #53311b18;\n  overflow: auto;\n  z-index: 6;\n  padding: 24px;\n  backdrop-filter: blur(20px);\n  scrollbar-width: thin;\n}\n.card[hidden] {\n  display: none;\n}\n.card .close {\n  position: absolute;\n  right: 10px;\n  top: 9px;\n  width: 44px;\n  padding: 0;\n  border: 0;\n  background: transparent;\n  font-size: 22px;\n}\n.card .eyebrow {\n  color: var(--coral);\n  margin-bottom: 15px;\n  padding-right: 20px;\n}\n.card h2 {\n  font-size: 24px;\n  line-height: 1.35;\n  letter-spacing: -0.5px;\n  margin-bottom: 14px;\n}\n.card p,\n.card li {\n  font-size: 13px;\n  line-height: 1.8;\n}\n.card ul {\n  padding-left: 18px;\n}\n.chips {\n  display: flex;\n  gap: 5px;\n  flex-wrap: wrap;\n  margin: 10px 0;\n}\n.chip {\n  border: 1px solid var(--line);\n  border-radius: 4px;\n  font-size: 10px;\n  padding: 4px 7px;\n}\n.card h3 {\n  font-size: 10px;\n  letter-spacing: 1px;\n  margin: 22px 0 8px;\n  color: var(--muted);\n}\n.card .phase {\n  padding: 12px;\n  border-left: 3px solid var(--coral);\n  background: #f2e5dc;\n  font-size: 12px;\n  line-height: 1.8;\n}\n.card .sources a {\n  display: flex;\n  min-height: 44px;\n  align-items: center;\n  font-size: 12px;\n  line-height: 1.6;\n}\n.card .small {\n  font-size: 10px;\n  line-height: 1.8;\n  color: var(--muted);\n}\n.card .quote {\n  border-left: 2px solid var(--coral);\n  padding: 8px 12px;\n  margin: 12px 0;\n}\n.card-footer {\n  border-top: 1px solid var(--line);\n  margin-top: 20px;\n  padding-top: 12px;\n}\n.controls {\n  position: absolute;\n  left: 30px;\n  right: 348px;\n  bottom: 65px;\n  z-index: 5;\n  max-width: 930px;\n  background: #fff8f4ee;\n  border: 1px solid var(--line);\n  border-radius: 14px;\n  padding: 13px 19px;\n  box-shadow: 0 8px 24px #5436200a;\n  backdrop-filter: blur(12px);\n}\n.control-tabs {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  border-bottom: 1px solid var(--line);\n  padding-bottom: 9px;\n  margin-bottom: 10px;\n}\n.control-tabs button {\n  min-height: 44px;\n  border: 0;\n  background: transparent;\n  font-size: 12px;\n  padding: 8px 13px;\n}\n.control-tabs button.active {\n  background: var(--ink);\n}\n.control-tabs .guide {\n  margin-left: auto;\n  color: var(--muted);\n  font-size: 10px;\n}\n.panel {\n  display: none;\n}\n.panel.active {\n  display: block;\n}\n.day-row {\n  display: flex;\n  gap: 13px;\n  align-items: center;\n}\n.day-row output {\n  font:\n    22px ui-monospace,\n    monospace;\n  min-width: 70px;\n}\n.day-row input {\n  width: 100%;\n  accent-color: var(--coral);\n  height: 44px;\n}\n.play {\n  min-width: 44px;\n  padding: 8px;\n}\n.ticks {\n  display: flex;\n  justify-content: space-between;\n  margin-left: 125px;\n  font:\n    9px ui-monospace,\n    monospace;\n  color: var(--muted);\n}\n.control-note {\n  font-size: 10px;\n  color: var(--muted);\n  margin-top: 7px;\n  line-height: 1.7;\n  min-height: 17px;\n}\n.term-buttons,\n.heart-buttons {\n  display: flex;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n.term-buttons button {\n  flex: 1;\n  white-space: nowrap;\n  font-size: 11px;\n  padding: 8px;\n}\n.heart-buttons button {\n  width: 47px;\n  font:\n    700 18px Arial,\n    sans-serif;\n}\n.heart-buttons .reset {\n  width: auto;\n  font-size: 12px;\n}\n.footer {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  z-index: 12;\n  background: var(--ink);\n  color: var(--cream);\n  min-height: 42px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 8px 24px;\n  font-size: 9px;\n  gap: 15px;\n}\n.footer span:last-child {\n  color: var(--yellow);\n}\n.legend {\n  position: absolute;\n  right: 342px;\n  bottom: 245px;\n  font-size: 10px;\n  line-height: 1.9;\n  color: var(--muted);\n  background: #fff8f4c9;\n  border-radius: 8px;\n  padding: 10px;\n  pointer-events: none;\n}\n.legend b {\n  color: var(--ink);\n  font-weight: 500;\n}\n.legend i {\n  display: inline-block;\n  width: 20px;\n  border-top: 2px solid var(--coral);\n  vertical-align: middle;\n  margin-right: 6px;\n}\n.legend i.dash {\n  border-top-style: dashed;\n}\n.legend i.dot {\n  border-top-style: dotted;\n}\n.mascot {\n  position: absolute;\n  right: 345px;\n  bottom: 280px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 10px;\n  color: var(--muted);\n  pointer-events: none;\n}\n.mascot .face {\n  background: #708f68;\n  border: 2px solid #43533d;\n  outline: 3px dotted #708f68;\n  width: 30px;\n  height: 28px;\n  border-radius: 45% 50% 42% 44%;\n  color: white;\n  text-align: center;\n  font: bold 15px/25px monospace;\n  transform: rotate(-8deg);\n}\n.intro {\n  position: absolute;\n  inset: 0;\n  z-index: 30;\n  display: grid;\n  place-items: center;\n  background: #211d1d38;\n  backdrop-filter: blur(5px);\n}\n.intro[hidden] {\n  display: none;\n}\n.intro-box {\n  width: min(440px, calc(100% - 36px));\n  background: var(--cream);\n  border-radius: 18px;\n  padding: 32px;\n  box-shadow: 0 30px 100px #211d1d33;\n}\n.intro-box .eyebrow {\n  color: var(--coral);\n}\n.intro-box h2 {\n  font-size: 28px;\n  line-height: 1.45;\n  margin: 18px 0;\n}\n.intro-box p {\n  font-size: 13px;\n  color: var(--muted);\n  line-height: 1.8;\n}\n.intro-actions {\n  display: flex;\n  justify-content: space-between;\n  margin-top: 25px;\n  gap: 10px;\n}\n.intro-actions .next {\n  background: var(--ink);\n  color: var(--cream);\n}\n.tour-caption {\n  display: none;\n  position: absolute;\n  bottom: 12%;\n  left: 8%;\n  right: 8%;\n  text-align: center;\n  pointer-events: none;\n  z-index: 15;\n}\n.tour-caption .caption {\n  font-size: clamp(24px, 3vw, 42px);\n  font-weight: 900;\n  line-height: 1.5;\n  letter-spacing: 2px;\n}\n.tour-caption .quote-text {\n  font-size: clamp(17px, 2.3vw, 28px);\n  line-height: 1.7;\n  background: #fff8f4f2;\n  padding: 20px;\n  border-radius: 12px;\n}\n.tour-caption .quote-source {\n  font-size: 11px;\n  background: var(--yellow);\n  display: inline-block;\n  padding: 7px 12px;\n  margin-top: 10px;\n}\n.tour-caption .tour-stage {\n  font-size: 11px;\n  margin-top: 10px;\n}\n.tour-controls {\n  display: none;\n  position: absolute;\n  top: 28px;\n  right: 22px;\n  z-index: 20;\n  gap: 6px;\n  align-items: center;\n  font-size: 11px;\n}\n.tour-controls button {\n  font-size: 12px;\n}\n.tour .sidebar,\n.tour .toolbar,\n.tour .hero-note,\n.tour .map-meta,\n.tour .controls,\n.tour .legend,\n.tour .mascot,\n.tour .card {\n  display: none;\n}\n.tour #stage {\n  right: 0;\n}\n.tour .tour-caption {\n  display: block;\n}\n.tour .tour-controls {\n  display: flex;\n}\n.tour #stage canvas {\n  cursor: none;\n}\n.tour .island-label {\n  pointer-events: none;\n}\n.tour.capture .tour-controls {\n  opacity: 0;\n}\n.tour.capture .tour-controls:focus-within,\n.tour.capture .tour-controls:hover {\n  opacity: 1;\n}\n.tour .brand {\n  top: 38px;\n}\n.tour .brand h1 {\n  font-size: 17px;\n}\n.tour .footer {\n  font-size: 10px;\n}\n.loading {\n  position: absolute;\n  inset: 0;\n  z-index: 40;\n  background: var(--cream);\n  display: grid;\n  place-content: center;\n  text-align: center;\n  padding: 30px;\n}\n.loading h2 {\n  font-size: 28px;\n  color: var(--coral);\n}\n.loading p {\n  font-size: 13px;\n  line-height: 1.8;\n  margin: 15px 0;\n}\n.loading[hidden] {\n  display: none;\n}\n.mobile-toggle,\n.mobile-close {\n  display: none;\n}\n.sidebar-hidden .sidebar {\n  display: none;\n}\n.sidebar-hidden #stage {\n  right: 0;\n}\n.sidebar-hidden .toolbar {\n  right: 24px;\n}\n.sidebar-hidden .controls {\n  right: 30px;\n}\n.sidebar-hidden .legend,\n.sidebar-hidden .mascot {\n  right: 30px;\n}\nbody.ratio {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: 100dvh;\n  background: var(--ink);\n}\nbody.ratio #app {\n  width: min(100vw, 56.25dvh);\n  height: min(100dvh, 177.777vw);\n  min-height: 0;\n}\nbody.ratio .brand {\n  left: 6%;\n  top: 4%;\n}\nbody.ratio .brand .future {\n  font-size: 30px;\n}\nbody.ratio .brand h1 {\n  font-size: 14px;\n}\nbody.ratio .brand .candidate {\n  font-size: 10px;\n}\nbody.ratio .footer {\n  font-size: 8px;\n  padding: 8px 12px;\n  flex-wrap: wrap;\n  gap: 3px;\n}\nbody.ratio .tour-controls {\n  top: 2%;\n  right: 3%;\n  transform: scale(0.85);\n  transform-origin: right top;\n}\nbody.ratio .tour-caption {\n  bottom: 15%;\n  left: 6%;\n  right: 6%;\n}\nbody.ratio .tour-caption .caption {\n  font-size: 24px;\n}\nbody.ratio .tour-caption .quote-text {\n  font-size: 17px;\n  padding: 14px;\n}\nbody.ratio .tour-caption .quote-source {\n  font-size: 9px;\n}\nbody.ratio .island-label {\n  font-size: 9px;\n  padding: 2px 5px;\n  min-height: 22px;\n}\nbody.ratio .island-label strong {\n  font-size: 8px;\n}\n@media (max-width: 800px) {\n  #app {\n    min-height: 580px;\n  }\n  #stage {\n    right: 0;\n  }\n  .brand {\n    top: 21px;\n    left: 19px;\n  }\n  .brand .future {\n    font-size: 27px;\n    letter-spacing: -1.5px;\n  }\n  .brand .future span {\n    display: inline;\n    margin-right: 4px;\n  }\n  .brand h1 {\n    font-size: 15px;\n    letter-spacing: 2px;\n    margin-top: 8px;\n  }\n  .brand .candidate {\n    font-size: 10px;\n  }\n  .hero-note {\n    top: 117px;\n    left: 20px;\n    max-width: 150px;\n  }\n  .hero-note .number {\n    font-size: 34px;\n    float: left;\n    margin-right: 8px;\n  }\n  .hero-note h2 {\n    font-size: 11px;\n    margin: 0;\n    padding-top: 2px;\n  }\n  .hero-note p {\n    font-size: 9px;\n    clear: both;\n    padding-top: 6px;\n  }\n  .toolbar {\n    right: 15px;\n    top: 20px;\n    flex-direction: column;\n    gap: 5px;\n  }\n  .toolbar button {\n    font-size: 11px;\n    min-width: 44px;\n    padding: 7px;\n  }\n  .toolbar .wide {\n    display: none;\n  }\n  .sidebar {\n    width: 100%;\n    top: 18%;\n    bottom: 42px;\n    border-radius: 18px 18px 0 0;\n    transform: translateY(110%);\n    transition: transform 0.25s;\n    box-shadow: 0 -10px 50px #211d1d22;\n  }\n  .sidebar.mobile-open {\n    transform: translateY(0);\n  }\n  .side-head {\n    padding: 20px;\n  }\n  .side-head p {\n    margin: 5px 0 10px;\n  }\n  .side-head h2 {\n    font-size: 20px;\n  }\n  .mobile-close {\n    display: block;\n    position: absolute;\n    right: 18px;\n    top: 15px;\n  }\n  .mobile-toggle {\n    display: block;\n  }\n  .controls {\n    left: 12px;\n    right: 12px;\n    bottom: 63px;\n    padding: 10px 12px;\n  }\n  .control-tabs {\n    gap: 2px;\n    margin-bottom: 6px;\n    padding-bottom: 5px;\n  }\n  .control-tabs button {\n    font-size: 11px;\n    padding: 7px 10px;\n  }\n  .control-tabs .guide {\n    display: none;\n  }\n  .day-row {\n    gap: 6px;\n  }\n  .day-row output {\n    font-size: 19px;\n    min-width: 57px;\n  }\n  .ticks {\n    margin-left: 107px;\n  }\n  .control-note {\n    font-size: 9px;\n  }\n  .map-meta {\n    left: 17px;\n    bottom: 250px;\n    font-size: 8px;\n  }\n  .map-meta .extra {\n    display: none;\n  }\n  .legend {\n    right: 14px;\n    bottom: 247px;\n    font-size: 8px;\n    padding: 5px;\n    line-height: 1.6;\n  }\n  .mascot {\n    display: none;\n  }\n  .footer {\n    padding: 7px 12px;\n    font-size: 8px;\n    gap: 3px;\n    flex-wrap: wrap;\n    min-height: 44px;\n  }\n  .island-label {\n    font-size: 9px;\n    min-height: 25px;\n    padding: 3px 5px;\n  }\n  .island-label strong {\n    font-size: 8px;\n    margin-right: 3px;\n  }\n  .card {\n    left: 12px;\n    right: 12px;\n    width: auto;\n    top: auto;\n    bottom: 61px;\n    max-height: 56%;\n    padding: 22px;\n    z-index: 10;\n  }\n  .card h2 {\n    font-size: 22px;\n  }\n  .term-buttons {\n    gap: 4px;\n  }\n  .term-buttons button {\n    font-size: 10px;\n    padding: 6px;\n  }\n  .tour .brand .future {\n    font-size: 26px;\n  }\n  .tour .brand h1 {\n    font-size: 13px;\n  }\n  .tour-controls {\n    top: 100px;\n    right: 15px;\n  }\n  .tour-caption {\n    bottom: 13%;\n  }\n  .tour-caption .caption {\n    font-size: 25px;\n  }\n  .tour-caption .quote-text {\n    font-size: 17px;\n  }\n  .sidebar-hidden .controls {\n    right: 12px;\n  }\n  .sidebar-hidden .toolbar {\n    right: 15px;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    scroll-behavior: auto !important;\n    transition: none !important;\n    animation: none !important;\n  }\n}\n#stage {\n  bottom: 220px;\n  isolation: isolate;\n}\n.tour #stage {\n  bottom: 0;\n}\n.island-label {\n  min-height: 44px !important;\n  min-width: 44px;\n}\n@media (max-width: 800px) {\n  #stage {\n    bottom: 220px;\n  }\n}\n.scene-note {\n  padding: 12px;\n  background: #f2e5dc;\n  border-radius: 8px;\n}\n.scene-note small {\n  color: var(--muted);\n}\n/* ---- second visual pass ---- */\n.ghost-label{display:flex;flex-direction:column;align-items:center;gap:1px;font:700 11px/1.2 \"Noto Sans TC\",sans-serif;color:#a5442a;background:#fff8f4f0;border:1px dashed #db6a41;border-radius:8px;padding:3px 7px;white-space:nowrap;pointer-events:none}\n.ghost-label small{font-weight:500;font-size:9px;color:#78685e}\n.site-sign{display:flex;flex-direction:column;gap:1px;background:#fffdf9;border:2px solid #211d1d;border-top:6px solid #db6a41;border-radius:6px;padding:4px 8px;font:500 10px/1.3 \"Noto Sans TC\",sans-serif;box-shadow:0 4px 10px #211d1d22;pointer-events:none;white-space:nowrap}\n.site-sign b{font-size:12px}\n\n/* ===== W8: cards, HUD, dock, log (second visual pass) ===== */\n.card{background:#fffdfaeb;border:1px solid #ffffff;border-radius:22px;box-shadow:0 1px 0 #ffffff inset,0 2px 6px #4a2a1414,0 22px 60px #4a2a1424;padding:20px 20px 18px;backdrop-filter:blur(22px) saturate(1.2);width:360px}\n.card .close{right:8px;top:8px;border-radius:12px}\n.card-head{display:flex;gap:12px;align-items:center;margin:0 0 12px;padding-right:34px}\n.card-head h2{margin:2px 0 0!important;font-size:21px!important;line-height:1.3!important;font-weight:800}\n.card-head .eyebrow{margin:0!important;font-size:9.5px;letter-spacing:1.6px}\n.icon-tile{flex:0 0 52px;height:52px;border-radius:15px;display:grid;place-items:center;background:linear-gradient(150deg,#fff3e9,#f7dcc8);color:var(--coral);box-shadow:0 1px 0 #fff inset,0 3px 8px #db6a4124}\n.icon-tile .ico{width:28px;height:28px}\n.icon-tile.flow{background:linear-gradient(150deg,#e6f1f1,#cfe2e2);color:#2f6170;font:800 15px ui-monospace,monospace}\n.icon-tile.role{background:linear-gradient(150deg,#eef4e7,#d9e7cd);color:#4e7a55;font:800 20px \"Noto Sans TC\",sans-serif}\n.ico{fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}\n.ico.sm{width:15px;height:15px;flex:0 0 15px}\n.card .lede{font-size:13.5px!important;line-height:1.7!important;color:#3d3431;margin:0 0 10px}\n.pills{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0 4px}\n.pill{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 10px;font-size:11px;font-weight:600;background:#f4ece4;color:#4b403b;border:1px solid #ecdccf}\n.pill.heart i{width:7px;height:7px;border-radius:50%;background:var(--c)}\n.pill.heart{color:color-mix(in srgb,var(--c) 70%,#000);background:color-mix(in srgb,var(--c) 10%,#fff);border-color:color-mix(in srgb,var(--c) 28%,#fff)}\n.pill.soft{background:#fff;color:#78685e}\n.pill.status{background:#211d1d;color:#fff8f4;border-color:#211d1d}\n.pill.flow{background:#e6f1f1;color:#2f6170;border-color:#cfe2e2;font-family:ui-monospace,monospace}\n.card h3{font-size:10px!important;letter-spacing:1.6px!important;color:#9a8679!important;margin:18px 0 8px!important;font-weight:700;text-transform:uppercase}\n.stat-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(96px,1fr));gap:8px;margin:12px 0 2px}\n.stat{background:#fff;border-radius:14px;padding:10px 11px 9px 12px;border:1px solid #f0e4da;box-shadow:inset 3px 0 0 var(--accent),0 2px 6px #4a2a140d;display:flex;flex-direction:column;gap:3px;min-width:0}\n.stat b{font-size:20px;font-weight:800;color:#211d1d;font-variant-numeric:tabular-nums;line-height:1.15;word-break:keep-all}\n.stat .lbl{font-size:10.5px;line-height:1.45;color:#78685e;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}\n.rows{display:flex;flex-direction:column;gap:6px}\n.row{display:grid;grid-template-columns:10px 1fr auto 12px;align-items:center;gap:9px;text-align:left;background:#fff;border:1px solid #f0e4da;border-radius:12px;padding:9px 11px;min-height:44px;font-size:13px}\n.row:hover{background:#fff6ec;border-color:#f2c9b3}\n.row .dot{width:8px;height:8px;border-radius:50%;background:var(--coral)}\n.row .ph{font-size:10px;color:#9a8679;white-space:nowrap}\n.row i{color:#c4b3a6;font-style:normal;font-size:16px}\n.flow-chips{display:flex;flex-wrap:wrap;gap:6px}\n.flow-chip{display:inline-flex;align-items:center;gap:7px;border-radius:999px;padding:6px 12px 6px 6px;min-height:36px;background:#fff;border:1px solid #e3d5ca;font-size:12px}\n.flow-chip b{background:#e6f1f1;color:#2f6170;border-radius:999px;padding:2px 7px;font:700 11px ui-monospace,monospace}\n.flow-chip i{font-style:normal;color:#b19f92}\n.flow-chip:hover{background:#fff6ec;border-color:#db6a41}\n.card ul.facts{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:6px}\n.card ul.facts li{position:relative;padding:8px 10px 8px 26px;background:#fbf6f1;border-radius:10px;font-size:12.5px;line-height:1.65}\n.card ul.facts li::before{content:\"\";position:absolute;left:11px;top:15px;width:6px;height:6px;border-radius:2px;background:var(--coral)}\n.timeline{display:grid;grid-template-columns:repeat(5,1fr);gap:3px;margin-bottom:6px}\n.timeline span{font-size:9.5px;text-align:center;padding:16px 2px 4px;position:relative;color:#9a8679;line-height:1.25}\n.timeline span::before{content:\"\";position:absolute;left:0;right:0;top:4px;height:7px;border-radius:4px;background:#efe4da}\n.timeline span.on{color:#a5442a;font-weight:700}\n.timeline span.on::before{background:repeating-linear-gradient(135deg,#db6a41 0 6px,#e98a66 6px 12px)}\n.timeline.unknown span::before{background:repeating-linear-gradient(135deg,#e6ddd5 0 5px,#f4eee8 5px 10px)}\n.card .phase{border-radius:10px;border-left:3px solid var(--coral);background:#fbf3ec}\n.scene-note{display:flex;gap:9px;align-items:flex-start;margin-top:14px;padding:10px 12px;background:#f3f6f0;border-radius:12px;font-size:11.5px;line-height:1.6;color:#4f5a4a}\n.scene-note small{display:block;color:#7d8778;font-size:10px}\n.route{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px;margin:12px 0;background:#fbf6f1;border-radius:14px;padding:10px}\n.route>div{display:flex;flex-direction:column;gap:5px}\n.route>i{font-style:normal;color:#db6a41;font-size:18px}\n.route .stop{display:flex;align-items:center;gap:6px;background:#fff;border-radius:9px;padding:5px 8px;font-size:11.5px;border:1px solid #f0e4da;color:#3d3431}\n.route .stop .ico{color:var(--coral)}\n.meter{height:9px;border-radius:6px;background:#efe4da;overflow:hidden}\n.meter i{display:block;height:100%;background:linear-gradient(90deg,#3e7c8c,#7fb3bd);border-radius:6px}\n.card .sources a{background:#fff;border:1px solid #f0e4da;border-radius:10px;padding:6px 10px;margin-bottom:6px;text-decoration:none}\n.card .sources a:hover{border-color:#db6a41}\n.card-footer{font-size:10px;color:#9a8679}\n\n.hud{position:absolute;left:232px;right:calc(318px + 286px);top:24px;z-index:4;display:flex;flex-direction:column;gap:8px;align-items:center;pointer-events:none}\n.status{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;pointer-events:auto}\n.st{display:inline-flex;align-items:center;gap:6px;background:#fffdfae6;border:1px solid #fff;border-radius:999px;padding:5px 11px;font-size:11px;color:#6a5d56;box-shadow:0 2px 8px #4a2a1414;backdrop-filter:blur(10px)}\n.st i{width:7px;height:7px;border-radius:50%;background:var(--c)}\n.st b{font-size:13px;color:#211d1d;font-variant-numeric:tabular-nums}\n.st.time b{font-family:ui-monospace,monospace}\n.toggles{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;pointer-events:auto}\n.toggles .seg{display:flex;background:#fffdfae6;border:1px solid #fff;border-radius:999px;padding:3px;box-shadow:0 2px 8px #4a2a1414}\n.toggles .seg button{min-height:36px;width:38px;padding:0;border:0;border-radius:999px;background:transparent;display:grid;place-items:center;color:#8a7a70}\n.toggles .seg button[aria-pressed=true]{background:#fff1d6;color:#c06a1b;box-shadow:0 1px 3px #4a2a1420}\n.toggles svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}\n.toggles .tg{display:inline-flex;align-items:center;gap:6px;min-height:42px;padding:6px 12px;border-radius:999px;background:#fffdfae6;border:1px solid #fff;font-size:12px;color:#5d514b;box-shadow:0 2px 8px #4a2a1414}\n.toggles .tg[aria-pressed=true]{background:#211d1d;color:#fff8f4;border-color:#211d1d}\n.toggles .tg:hover{background:#fff1d6}\n.toggles .tg[aria-pressed=true]:hover{background:#3a3332}\n.dock{position:absolute;right:calc(318px + 14px);top:96px;z-index:4;display:flex;flex-direction:column;gap:5px;background:#fffdfad9;border:1px solid #fff;border-radius:20px;padding:6px;box-shadow:0 6px 20px #4a2a141f;backdrop-filter:blur(12px)}\n.dock-btn{position:relative;width:38px;height:36px;min-height:36px;padding:0;border:0;border-radius:12px;background:transparent;color:#a5442a;display:grid;place-items:center}\n.dock-btn .ico{width:20px;height:20px}\n.dock-btn:hover,.dock-btn:focus-visible{background:#fff1e6}\n.dock-btn .tip{position:absolute;right:46px;top:50%;transform:translateY(-50%);white-space:nowrap;background:#211d1d;color:#fff8f4;font-size:11px;padding:4px 8px;border-radius:7px;opacity:0;pointer-events:none;transition:opacity .15s}\n.dock-btn:hover .tip,.dock-btn:focus-visible .tip{opacity:1}\n.mascot{right:calc(318px + 70px)!important}\n.log{position:absolute;right:calc(318px + 66px);top:96px;bottom:250px;width:330px;z-index:5;background:#fffdfaf0;border:1px solid #fff;border-radius:20px;box-shadow:0 20px 50px #4a2a1426;backdrop-filter:blur(18px);display:none;flex-direction:column;padding:14px 14px 10px}\n.log.open{display:flex}\n.log-head{display:flex;justify-content:space-between;align-items:flex-start}\n.log-head .eyebrow{color:var(--coral);font-size:9px}\n.log-head h3{font-size:15px;margin-top:2px}\n.log-head button{border:0;background:transparent;font-size:20px;width:44px;padding:0}\n.log-filters{display:flex;gap:8px;align-items:center;margin:8px 0}\n.log-filters .live{display:inline-flex;align-items:center;gap:5px;font:700 10px ui-monospace,monospace;color:#3d7a52}\n.log-filters .live i{width:7px;height:7px;border-radius:50%;background:#5ebd7a;box-shadow:0 0 0 3px #5ebd7a33}\n.log-filters select{flex:1;min-height:36px;border-radius:10px;border:1px solid #e3d5ca;background:#fff;font-size:12px;padding:0 8px}\n#log-list{list-style:none;margin:0;padding:0;overflow:auto;flex:1;display:flex;flex-direction:column;gap:4px}\n#log-list li{display:grid;grid-template-columns:44px 1fr;gap:8px;align-items:start;font-size:11.5px;line-height:1.5;padding:6px 4px;border-bottom:1px dashed #efe4da}\n.lp{display:inline-block;text-align:center;border-radius:999px;padding:2px 0;font-size:10px;font-weight:700}\n.lp.depart{background:#e6f1f1;color:#2f6170}.lp.arrive{background:#fff1d6;color:#7f520a}.lp.handoff{background:#f6e3ec;color:#9a3a63}\n.lt b{font-family:ui-monospace,monospace;color:#db6a41}\n.log-note{font-size:9.5px;color:#9a8679;line-height:1.5;margin-top:6px}\n.name-tag{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;background:#fffdfaf2;border:1px solid #fff;border-radius:999px;padding:2px 8px 2px 3px;font-size:10px;min-height:22px;box-shadow:0 2px 6px #4a2a1424;color:#3d3431;pointer-events:auto}\n.name-tag i{font-style:normal;width:16px;height:16px;border-radius:50%;background:#eef4e7;display:grid;place-items:center;font-size:9px;color:#4e7a55}\n.name-tag b{font:700 9px ui-monospace,monospace;color:#2f6170;background:#e6f1f1;border-radius:999px;padding:1px 5px}\n.name-tag.ambient{opacity:.85}\n.island-label{border-radius:999px!important;background:#fffdfaf2!important;border:1px solid #fff!important;box-shadow:0 3px 10px #4a2a1424!important;padding:4px 11px!important;font-weight:600}\n.island-label.selected{background:#211d1d!important;color:#fff8f4!important}\n.debug .hud,.debug .dock,.debug .log,.debug .card,.debug .controls,.debug .sidebar,.debug .toolbar,.debug .brand,.debug .hero-note,.debug .map-meta,.debug .mascot,.debug .footer,.debug #labels,.debug .intro{display:none!important}\n.debug #stage{inset:0!important}\n.debug #app{background:transparent!important}\n.tour .hud,.tour .dock,.tour .log{display:none}\n@media (max-width:1680px){.toggles .tg span{display:none}.toggles .tg{padding:0;width:42px;justify-content:center}}\n.toggles .tg{position:relative}\n.toggles .tg::after,.toggles .seg button::after{content:attr(title);position:absolute;top:calc(100% + 6px);left:50%;transform:translateX(-50%);background:#211d1d;color:#fff8f4;font-size:11px;padding:3px 8px;border-radius:6px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .15s}\n.toggles .tg:hover::after,.toggles .tg:focus-visible::after,.toggles .seg button:hover::after{opacity:1}\n.toggles .seg button{position:relative}\n@media (max-width:800px){\n.hud{left:12px;right:64px;top:auto;bottom:228px;align-items:flex-start}\n.status .st:not(.time){display:none}\n.toggles{justify-content:flex-start;flex-wrap:nowrap;overflow-x:auto;max-width:100%}\n.toggles .tg span{display:none}\n.dock{right:auto;left:0;top:auto;bottom:180px;flex-direction:row;overflow-x:auto;max-width:100vw;border-radius:0;width:100%;display:none}\n.log{left:10px;right:10px;width:auto;top:90px;bottom:240px}\n.card{width:auto;border-radius:22px 22px 0 0}\n.mascot{display:none}\n}\n\n/* night legibility for text that sits on the 3D canvas */\n\nbody.night .brand,body.night .hero-note,body.night .map-meta{background:#fffaf5e6;border-radius:16px;padding:10px 12px;box-shadow:0 6px 20px #0003;margin-left:-12px}\nbody.night .hero-note{top:200px}\n\n@media (max-width:800px){\n.island-label{min-height:30px!important;min-width:30px;font-size:10px!important;padding:2px 8px!important}\n.hero-note,.map-meta{display:none}\n\n.hud{bottom:224px}\n}\n\n#labels.compact .island-label{font-size:10.5px;padding:2px 9px!important;min-height:26px!important;box-shadow:0 2px 6px #4a2a141f!important}\n#labels.compact .island-label strong{font-size:9px}\n\n.icon-tile.thumb{flex:0 0 72px;height:72px;border-radius:18px;padding:0;overflow:visible;position:relative;background:#f4ece4}\n.icon-tile.thumb img{width:72px;height:72px;border-radius:18px;object-fit:cover;display:block;box-shadow:0 0 0 2px #fff,0 4px 12px #4a2a1426}\n.icon-tile .badge-ico{position:absolute;right:-6px;bottom:-6px;width:26px;height:26px;border-radius:9px;background:#fff;display:grid;place-items:center;color:var(--coral);box-shadow:0 2px 6px #4a2a1426}\n\n/* ---- iteration 12: legibility & declutter ---- */\n.control-tabs .status{margin-left:auto;display:flex;gap:5px;flex-wrap:nowrap;justify-content:flex-end;pointer-events:auto}\n.control-tabs .st{box-shadow:none;border:1px solid #efe2d6;background:#fff;padding:4px 9px;font-size:10.5px}\n.control-tabs .st b{font-size:12px}\n.hud{top:22px;right:calc(318px + 280px)}\n.brand{background:#fffaf5d9;border-radius:18px;padding:12px 14px 10px;margin-left:-14px;margin-top:-10px;box-shadow:0 6px 20px #4a2a141a;backdrop-filter:blur(10px)}\n.hero-note{background:#fffaf5d9;border-radius:16px;padding:10px 12px;margin-left:-12px;box-shadow:0 6px 20px #4a2a141a;backdrop-filter:blur(10px)}\n.map-meta{background:#fffaf5c7;border-radius:12px;padding:6px 10px;margin-left:-10px}\nbody.card-open .hero-note,body.card-open .map-meta{display:none}\n.dock{display:none}\n.sidebar-hidden .dock{display:flex}\n.tour-caption .caption{background:#fffaf5ee;border-radius:16px;padding:10px 18px;display:inline-block;box-shadow:0 8px 24px #4a2a1426}\n.tour-caption .tour-stage{background:#fffaf5ee;display:inline-block;border-radius:999px;padding:4px 12px}\n.log-filters select{min-width:0;max-width:100%}\n.log-filters{min-width:0}\n.row .ph{white-space:normal;text-align:right;max-width:120px;line-height:1.3}\n.flow-chip span{white-space:normal}\n.site-board{display:none}\n@media (max-width:1300px){.control-tabs .st:not(.time){display:none}}\n@media (max-width:800px){\n.control-tabs .status{display:none}\n.toggles{max-width:calc(100vw - 80px);overflow-x:auto;scrollbar-width:none;-webkit-mask-image:linear-gradient(90deg,#000 85%,transparent)}\nbody.card-open .brand{display:none}\n.brand{padding:8px 10px;margin:0}\n}\n.doing{display:flex;align-items:center;gap:8px;background:#eef4e7;border-radius:10px;padding:7px 10px;font-size:12px!important;color:#3d5a41;margin-top:10px}\n.doing i{width:8px;height:8px;border-radius:50%;background:#5ebd7a;box-shadow:0 0 0 3px #5ebd7a33}\n\n/* iteration 13: full-height canvas behind translucent panels */\n#stage{bottom:0!important}\n.controls{background:#fffaf5e8!important;backdrop-filter:blur(14px)}\n@media (max-width:800px){\n#stage{bottom:0!important}\n.hud{top:auto;bottom:226px;left:10px;right:10px}\n}\n.route-tag{font:700 11px \"Noto Sans TC\",sans-serif;background:#fffaf5f2;border:1px solid #fff;border-left:4px solid #3e7c8c;border-radius:8px;padding:3px 8px;box-shadow:0 3px 8px #4a2a1424;pointer-events:none;white-space:nowrap}\n\n.log-tabs{display:flex;gap:4px;background:#f4ece4;border-radius:12px;padding:3px;margin:8px 0 4px}\n.log-tabs button{flex:1;min-height:34px;border:0;border-radius:9px;background:transparent;font-size:12px;color:#78685e;padding:0}\n.log-tabs button[aria-selected=true]{background:#fff;color:#211d1d;box-shadow:0 1px 3px #4a2a1420;font-weight:700}\n#log-body{display:flex;flex-direction:column;min-height:0;flex:1}\n#log-body[hidden],.overview-panel[hidden]{display:none}\n.overview-panel{overflow:auto;flex:1;padding-right:2px}\n.overview-panel h4{font-size:10px;letter-spacing:1.6px;color:#9a8679;margin:14px 0 6px}\n.stat-row.four{grid-template-columns:repeat(2,1fr)}\n.heart-bars{display:flex;flex-direction:column;gap:6px}\n.heart-bars>div{display:grid;grid-template-columns:52px 1fr 20px;align-items:center;gap:8px}\n.heart-bars .bar{display:block;height:8px;background:#efe4da;border-radius:5px;overflow:hidden}\n.heart-bars .bar b{display:block;height:100%;border-radius:5px}\n.heart-bars em{font-style:normal;font-size:12px;font-weight:700;text-align:right}\n.mini-list{display:grid;grid-template-columns:1fr 1fr;gap:5px}\n.mini-list button{display:grid;grid-template-columns:16px 1fr auto;gap:6px;align-items:center;min-height:34px;padding:4px 8px;border-radius:9px;font-size:11.5px;text-align:left;background:#fff;border:1px solid #f0e4da}\n.mini-list button .ico{color:var(--coral)}\n.mini-list em{font-style:normal;font-weight:700;color:#78685e}\n#log-list li .lt time{font:600 10px ui-monospace,monospace;color:#76645a;margin-right:6px}\n#log-list li .lt .ico{color:var(--coral);vertical-align:-3px;margin-right:4px}\nbody.interacted .mascot{display:none}\n.mascot{background:#fffaf5e6;border-radius:999px;padding:4px 10px 4px 4px;box-shadow:0 3px 10px #4a2a141f}\n.pill.soft{white-space:normal}\n.row .ph{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;max-width:130px;font-size:9.5px}\n.pills .pill.soft{max-width:100%;line-height:1.4}\n.name-tag .carry{font-size:9.5px;color:#a5442a;border-left:1px solid #efe2d6;padding-left:5px}\nbody.card-open .mascot,body.flows-on .mascot{display:none}\n.tour-controls #tour-time{background:#fffaf5ee;border-radius:999px;padding:4px 10px}\n@media (max-width:800px){.toggles{flex-wrap:wrap;max-width:none;overflow:visible;-webkit-mask-image:none}.toggles .tg,.toggles .seg button{min-height:38px}.toggles .tg{width:38px}}\n.card::after{content:\"\";position:sticky;display:block;bottom:-18px;height:28px;margin:0 -20px -18px;background:linear-gradient(#fffdfa00,#fffdfa);pointer-events:none}\n\n/* iteration 17: card open → time panel collapses to its tab row */\n@media (min-width:801px){\nbody.card-open .controls .panel,body.card-open .controls .control-note{display:none!important}\nbody.card-open .controls{padding:8px 14px}\nbody.card-open .card{bottom:150px}\n}\n.route-tag{font-size:13px;padding:5px 11px;border-left-width:5px}\n.route-tag::before{content:\"⚑ \";color:#3e7c8c}\n.shared-phase{font-size:11.5px!important;background:#fbf3ec;border-left:3px solid var(--coral);border-radius:8px;padding:7px 10px;margin:0 0 8px;line-height:1.55!important}\n.shared-phase b{display:block;font-size:10px;color:#9a8679;letter-spacing:1px}\n\n/* iteration 19 */\n.name-tag{font-size:11px;min-height:24px}\n.name-tag b{font-size:10px}\n.name-tag .carry{font-size:10.5px}\n@media (min-width:801px){.log{right:12px;top:12px;bottom:auto;max-height:calc(100% - 300px);width:300px;z-index:12}}\n.toggles .seg2 .tg{box-shadow:none;border:0;background:transparent;min-height:36px;width:40px;padding:0;justify-content:center}\n.toggles .seg2 .tg[aria-pressed=true]{background:#211d1d;color:#fff8f4}\nbody.zoomed .map-meta,body.zoomed .hero-note,body.zoomed .mascot{display:none}\nbody.log-open #sidebar .tree,body.log-open #sidebar .side-tabs,body.log-open #sidebar .search{visibility:hidden}\n@media (min-width:801px){.log{max-height:calc(100% - 60px)!important}}\n@media (max-width:800px){.card{max-height:48vh!important}}\n.island-label.dim{opacity:.78!important;filter:saturate(.6)}\n\n/* iteration 24: renewal planned-use labels with icons; tag route chip */\n.ghost-label{flex-direction:row;gap:5px;color:var(--g,#a5442a);border:1.5px solid var(--g,#db6a41);border-style:solid;background:#fffdf9f5;box-shadow:0 2px 6px #4a2a1420}\n.ghost-label i{display:grid;place-items:center;width:16px;height:16px;border-radius:50%;background:var(--g,#db6a41);color:#fff}\n.ghost-label svg{width:11px;height:11px}\n.name-tag b{font:600 9.5px \"Noto Sans TC\",sans-serif;color:#2f6170;background:#e6f1f1;border-radius:999px;padding:1px 6px}\n.lt .nw{white-space:nowrap}\n.icon-tile.role.portrait{flex-basis:64px;height:64px;position:relative;overflow:visible;padding:0;border:2px solid #fff;box-shadow:0 0 0 2px #db6a41,0 4px 10px #4a2a1430}\n.icon-tile.role.portrait img{width:100%;height:100%;object-fit:cover;border-radius:13px;display:block}\n.icon-tile.role.portrait .glyph{position:absolute;right:-6px;bottom:-6px;width:22px;height:22px;border-radius:50%;background:#211d1d;color:#fff8f4;font:700 11px \"Noto Sans TC\",sans-serif;display:grid;place-items:center;border:2px solid #fff}\n\n/* iteration 26: activity bubbles, current theme row, legend, title fit */\n.name-tag.bubble{position:relative;border-radius:12px;padding:3px 9px 3px 3px;background:#fffdfa;border:1.5px solid #f0d9c8;margin-bottom:7px}\n.name-tag.bubble::after{content:\"\";position:absolute;left:50%;bottom:-7px;margin-left:-6px;border:6px solid transparent;border-top-color:#fffdfa;border-bottom:0;filter:drop-shadow(0 1.5px 0 #f0d9c8)}\n.name-tag.bubble .doing{font-size:11px;color:#5d4f49}\n.name-tag.bubble .doing b{font:700 11px \"Noto Sans TC\",sans-serif;color:#a5442a;background:none;padding:0}\n#tree details.current>summary{background:#fff1e8;box-shadow:inset 3px 0 0 #db6a41;border-radius:10px}\n#tree details.current>summary .item-name{color:#a5442a;font-weight:700}\n.legend{background:#fffaf6f5!important;box-shadow:0 2px 8px #4a2a141a}\n.card h2{font-size:clamp(19px,2.1vw,24px);word-break:keep-all;overflow-wrap:anywhere}\n.island-label.selected{z-index:3}\n/* iteration 27: mobile keeps one toolbar row (time is on the slider below) */\n@media (max-width:800px){.toggles .seg:not(.seg2){display:none}.toggles{flex-wrap:nowrap}}\n\n/* v3 content: plain sentence, vision quote */\n.card .plain{font-size:14.5px;line-height:1.65;color:#2e2724;background:#fff6ef;border-radius:12px;padding:10px 12px;margin:10px 0 12px}\n.card blockquote.vision{margin:6px 0 10px;padding:2px 0 2px 10px;border-left:3px solid #db6a41;color:#6b5a52;font-size:12.5px;line-height:1.6}\n\n/* A4: layer toolbar — icon over a single-line label, width follows content */\n@media (min-width:801px){\n.toggles{max-width:none;overflow:visible;-webkit-mask-image:none}\n.toggles .seg2 .tg{width:auto;min-width:46px;min-height:46px;padding:4px 9px;flex-direction:column;justify-content:center;gap:2px}\n.toggles .seg2 .tg span{display:block!important;white-space:nowrap;font-size:11px;line-height:1.2;letter-spacing:.02em}\n.toggles .seg button{min-height:46px;width:42px}\n}\n\n/* A6: card frame clips; inner content scrolls with an inset, thin, brand-tinted scrollbar */\n.card{overflow:hidden!important;padding:0!important;display:flex;flex-direction:column}\n.card[hidden]{display:none!important}\n.card::after{display:none!important}\n#card-content{flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:hidden;padding:20px 12px 40px 20px;margin:8px 6px 8px 0;scrollbar-width:thin;scrollbar-color:#e8c9b6 transparent;overscroll-behavior:contain}\n#card-content::-webkit-scrollbar{width:6px}\n#card-content::-webkit-scrollbar-track{background:transparent;margin:10px 0}\n#card-content::-webkit-scrollbar-thumb{background:#e8c9b6;border-radius:6px}\n#card-content::-webkit-scrollbar-thumb:hover{background:#db6a41}\n.card .close{z-index:2}\n/* A5: tiles never overflow */\n.stat-row{grid-template-columns:repeat(auto-fit,minmax(0,1fr))!important}\n.stat{min-width:0;overflow:hidden}\n.stat b{font-size:clamp(14px,1.25vw,19px)!important;overflow-wrap:anywhere;word-break:normal!important;min-width:0;max-width:100%}\n.stat .lbl{overflow-wrap:anywhere}\n\n/* A7: item pins on the map + numbered sidebar items */\n.item-pin{display:inline-flex;align-items:center;gap:5px;padding:3px 9px 3px 3px;border-radius:999px;background:#fffdfa;border:1.5px solid #db6a41;box-shadow:0 3px 10px #4a2a1430;font:600 11.5px/1.2 \"Noto Sans TC\",sans-serif;color:#2e2724;white-space:nowrap;pointer-events:auto;cursor:pointer;transform:translateY(-50%);transition:transform .15s}\n.item-pin b{display:grid;place-items:center;width:20px;height:20px;border-radius:50%;background:#db6a41;color:#fff;font-size:12px;font-weight:800}\n.item-pin.hot,.item-pin:hover{transform:translateY(-50%) scale(1.14);background:#211d1d;color:#fff8f4;border-color:#211d1d;z-index:5}\n.item-pin.sel{background:#db6a41;color:#fff;border-color:#fff}\n.item-pin.sel b{background:#fff;color:#db6a41}\n#tree .children button .pin-no{display:inline-grid;place-items:center;width:18px;height:18px;border-radius:50%;background:#fff1e8;color:#db6a41;font-size:11px;margin-right:8px;font-weight:800}\n#tree .children button.hot{background:#fff1e8;color:#a5442a}\n#tree .children button.hot .pin-no{background:#db6a41;color:#fff}\n.item-pin.mini{padding:2px}\n.item-pin.mini span{display:none}\n.item-pin.mini:hover span{display:inline}\n.stat.long b{font-size:clamp(12.5px,1.05vw,15px)!important;letter-spacing:-.02em}\n.item-pin.compact.mini:hover,.item-pin.compact.hot{padding:3px 9px 3px 3px}\n.item-pin.compact.mini:hover span{display:inline}\n/* scroll cue at the bottom of the card */\n.card::before{content:\"\";position:absolute;left:1px;right:14px;bottom:1px;height:34px;border-radius:0 0 20px 20px;background:linear-gradient(#fffdfa00,#fffdfaf2);pointer-events:none;z-index:1}\n.item-pin{z-index:4}\n.item-pin.slid{border-style:dashed}\n.control-note{color:#5f514a!important}\n\n/* brand card: same left edge as the detail card, never overlapping it */\n@media (min-width:801px){\n  .brand{left:30px!important;top:18px!important;margin:0!important}\n  .card{left:30px!important;top:calc(var(--brand-bottom,190px) + 12px)!important}\n  body.card-open .brand{display:block!important}\n}\n.island-label.numonly{font-size:0!important;padding:4px 7px!important}.island-label.numonly strong{font-size:11px}.island-label.numonly:hover{font-size:12px!important}\n\n/* ===== release fixes (2026-10-11) ===== */\n/* page footer removed: reclaim the strip */\n.footer{display:none!important}\n.sidebar{bottom:0!important}\n@media (min-width:801px){\n  .controls{bottom:23px!important}\n  body.card-open .card{bottom:108px!important}\n  .card{bottom:120px}\n}\n/* CSS2D labels must never transition transform (the renderer sets it every frame) */\n.item-pin,.island-label,.name-tag,.route-tag,.ghost-label{transition:none!important}\n.item-pin.hot,.item-pin:hover{transform:none}\n.mob-only{display:none!important}\n@media (hover:none){\n  .item-pin.mini:hover span,.item-pin.compact.mini:hover span{display:none}\n  .toggles .tg::after,.toggles .seg button::after{display:none}\n}\n\n/* ---------- mobile layout ---------- */\n@media (max-width:800px){\n  .mob-only{display:block!important}\n  .sheet-handle.mob-only{display:flex!important}\n  #stage{bottom:0!important;right:0!important}\n  .map-meta,.dock,.hero-note{display:none!important}\n  .toolbar{z-index:15}\n  .toolbar button[aria-pressed=true]{background:#211d1d;color:#fff8f4}\n  /* time panel: on demand, docked to the bottom edge */\n  .controls{display:none!important}\n  body.m-time .controls{display:block!important;left:0!important;right:0!important;bottom:0!important;border-radius:18px 18px 0 0!important;padding:12px 14px calc(12px + env(safe-area-inset-bottom,0px))!important;z-index:14}\n  /* layers bar: not shown on phones */\n  .hud{display:none!important}\n  /* detail card: bottom sheet flush with the screen edge, thin side margins */\n  .card{left:8px!important;right:8px!important;bottom:0!important;top:auto!important;width:auto!important;max-height:60%!important;border-radius:20px 20px 0 0!important;padding-bottom:env(safe-area-inset-bottom,0px)!important;z-index:16!important}\n  body.card-open .card{bottom:0!important}\n  #card-content{padding-bottom:calc(24px + env(safe-area-inset-bottom,0px))}\n  /* index sheet: half height by default, full on handle tap / swipe up */\n  .sidebar{top:auto!important;height:52%!important;bottom:0!important;transition:transform .25s,height .25s!important;z-index:17;padding-top:18px}\n  .sidebar.full{height:calc(100% - 16px)!important}\n  .sheet-handle{position:absolute;top:0;left:50%;transform:translateX(-50%);width:96px;height:22px;border:0;background:transparent;display:flex!important;align-items:center;justify-content:center;padding:0;cursor:pointer;z-index:2}\n  .sheet-handle i{display:block;width:44px;height:5px;border-radius:5px;background:#211d1d40}\n  .sidebar .side-head{padding-top:10px}\n  /* half sheet: drop the intro copy so the list itself gets the room; full sheet shows everything */\n  .sidebar:not(.full) .side-head .eyebrow,.sidebar:not(.full) .side-head h2,.sidebar:not(.full) .side-head p{display:none}\n  .sidebar:not(.full) .side-head{padding-top:14px!important;padding-right:60px!important}\n  .sidebar:not(.full) .side-head .search{margin-top:0}\n  .sidebar:not(.full) .mobile-close{top:16px}\n}\n\n/* search field: always dark text (dark-mode browsers default inputs to white text) */\n.search,.search:focus{color:#211d1d!important;-webkit-text-fill-color:#211d1d;caret-color:#db6a41;color-scheme:light}\n.search::placeholder{color:#9a8b82;-webkit-text-fill-color:#9a8b82}\n@media (max-width:800px){.search{font-size:16px!important}}\n\n/* map badges are not toolbar buttons: no 44px touch minimum (it stretched the number badges into tall pills) */\n.item-pin{min-height:0!important;min-width:0!important}\n.item-pin.mini,.item-pin.compact.mini{width:26px;height:26px;justify-content:center;padding:2px!important}\n/* night only recolours the brand card; its size and position stay the same at every time of day */\nbody.night .brand{padding:12px 14px 10px;margin-left:-14px;margin-top:-10px}\n@media (min-width:801px){body.night .brand{margin:0!important}}\n@media (max-width:800px){body.night .brand{padding:8px 10px!important;margin:0!important}}\n/* partner-city tags: quiet place-name captions, only while exploring city diplomacy */\n.route-tag{font:500 10px/1.3 \"Noto Sans TC\",sans-serif!important;color:#4f6266;background:#fffaf5b3!important;border:0!important;border-radius:999px!important;padding:2px 8px!important;box-shadow:none!important;letter-spacing:.04em}\n.route-tag::before{content:\"↗ \"!important;color:#7a9a9f!important}\n/* mid widths (tablet / small laptop): the layer bar no longer fits between brand and toolbar — dock it under the brand */\n@media (min-width:801px) and (max-width:1279px){\n  .hud{left:30px!important;right:auto!important;top:calc(var(--brand-bottom,180px) + 10px)!important;align-items:flex-start!important}\n  .hud .toggles{justify-content:flex-start!important;flex-wrap:wrap!important;max-width:calc(100vw - 318px - 60px)!important}\n  body.card-open .hud{display:none!important}\n  .hero-note{display:none!important}\n}\n/* easter egg: Puma's tag — small, warm, a little playful; grows a speech line while he stops on his soapbox */\n.name-tag.puma-tag{background:#211d1d;color:#fff8f4;border:1.5px solid #db6a41;padding:2px 9px 2px 4px;gap:5px;box-shadow:0 3px 10px #4a2a1440;cursor:pointer;opacity:1!important}\n.name-tag.puma-tag i{background:#db6a41;color:#fff;width:16px;height:16px;font-size:10px}\n.name-tag.puma-tag .pn{font:800 11px/1 \"Noto Sans TC\",sans-serif;color:#fcea8b;background:none;padding:0;letter-spacing:.04em}\n.name-tag.puma-tag .stop{font-size:10.5px;color:#fff8f4}\n.name-tag.puma-tag .stop:empty{display:none}\n.name-tag.puma-tag.talking{border-color:#fcea8b}\n.icon-tile.puma-tile{background:linear-gradient(150deg,#211d1d,#3a3332);color:#fcea8b;font-size:24px}\n/* phone detail card: fixed one-third height by default, full screen on demand */\n#card-size{display:none}\n@media (max-width:800px){\n  .card{height:34%!important;max-height:none!important;min-height:220px;transition:height .25s ease!important}\n  .card.full{height:calc(100% - 10px)!important}\n  .card #card-handle{position:absolute;top:0;left:50%;transform:translateX(-50%);z-index:3}\n  #card-size{display:inline-flex!important;position:absolute;top:10px;right:54px;z-index:3;min-height:32px;height:32px;padding:0 11px;border-radius:999px;border:1px solid #ecdccf;background:#fff;font-size:12px;font-weight:600;color:#5d514b;align-items:center}\n  #card-size[aria-pressed=true]{background:#211d1d;color:#fff8f4;border-color:#211d1d}\n  #card-content{padding-top:30px!important}\n  .card .card-head{padding-right:40px}\n}\n@media (prefers-reduced-motion:reduce){.card{transition:none!important}}\n/* toolbar overview arrow: one drawn icon on every device (the ↗ character turns into an emoji on phones) */\n.tb-ico{width:13px;height:13px;vertical-align:-2px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}\n/* sheet handles: no button hover/tap fill — only the grab bar shows */\n.sheet-handle,.sheet-handle:hover,.sheet-handle:active,.sheet-handle:focus{background:transparent!important;box-shadow:none!important;border:0!important;-webkit-tap-highlight-color:transparent}\n.sheet-handle:focus:not(:focus-visible){outline:none}\n/* removed: map caption and mascot hint */\n.map-meta,.mascot{display:none!important}\n/* removed: the \"14 一格政見\" hero note */\n.hero-note{display:none!important}\n/* 2026-10-14: resident speech tags — one clean pill: role badge centred on the left, \"正在搬 + item\" on one line */\n.name-tag.bubble{align-items:center;gap:6px;padding:3px 10px 3px 3px;border-radius:999px;min-height:26px;border:1.5px solid #f0d9c8;box-shadow:0 3px 10px #4a2a1426}\n.name-tag.bubble>i{flex:0 0 20px;width:20px;height:20px;font-size:10px;line-height:1;align-self:center}\n.name-tag.bubble .doing{display:inline-flex!important;align-items:baseline;gap:4px;margin:0!important;padding:0!important;background:none!important;border-radius:0;font-size:11px!important;line-height:1.2;color:#5d4f49}\n.name-tag.bubble .doing::before,.name-tag.bubble .doing i{display:none}\n.name-tag.bubble .doing b{font:700 11.5px/1.2 \"Noto Sans TC\",sans-serif;color:#a5442a}\n/* island icon column: never shown (also not when the index is closed) */\n.dock,.sidebar-hidden .dock{display:none!important}\n/* index list: no divider lines between themes */\n.tree details,.tree .flow-item{border-bottom:0!important}\n/* 2026-10-15: bottom time panel (台北人的一天／任期時間軸／HEART) removed — the clock runs by itself;\n   light presets and 暫停 live in the layer bar (desktop) or behind the 時間 button (phone) */\n.controls,body.m-time .controls{display:none!important}\n@media (min-width:801px){\n  .card,body.card-open .card{bottom:24px!important}\n}\n@media (max-width:800px){\n  body.m-time .hud{display:flex!important;position:absolute;left:0!important;right:0!important;bottom:0!important;top:auto!important;width:auto!important;z-index:14;padding:10px 12px calc(12px + env(safe-area-inset-bottom,0px))!important;background:#fff8f4f2;border-radius:18px 18px 0 0;box-shadow:0 -8px 30px #211d1d1f;justify-content:center;align-items:center!important}\n  body.m-time .hud .toggles{display:flex!important;flex-direction:row!important;flex-wrap:nowrap!important;justify-content:center;gap:8px!important;max-width:none!important;width:auto!important}\n  body.m-time .hud .toggles .seg{width:auto!important}\n  body.m-time .hud .toggles .seg button{width:46px!important;min-height:40px!important;height:40px!important;flex:0 0 46px!important}\n  body.m-time .hud .seg2 .tg:not([data-toggle=freeze]){display:none!important}\n  body.m-time .hud .status{display:none!important}\n}\n@media (max-width:800px){body.m-time .hud .toggles .seg{display:flex!important}}\n\n/* ===== brand block v2 (2026-10-15): HEART 政策島 ===== */\n.brand .candidate{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:10px;padding-top:9px;border-top:1.5px solid #db6a4140;font-size:12px;line-height:1}\n.brand .candidate .proj{display:inline-flex;align-items:baseline;gap:5px;font-weight:800;font-size:15px;letter-spacing:.06em;color:var(--ink,#211D1D)}\n.brand .candidate .proj em{font-style:normal;font:900 15px/1 Arial,sans-serif;letter-spacing:.04em;color:var(--coral,#DB6A41)}\n.brand .candidate b{margin:0;font-weight:600;font-size:11.5px;letter-spacing:.12em;color:#6b5a52;white-space:nowrap}\n@media (max-width:800px){\n  .brand .candidate{margin-top:7px;padding-top:6px;gap:10px}\n  .brand .candidate .proj,.brand .candidate .proj em{font-size:12px}\n  .brand .candidate b{font-size:10px;letter-spacing:.08em}\n}\n\n/* ===== brand block v3 (2026-10-15): landscape — FUTURE SOON. left, title stack right ===== */\n.brand{display:flex!important;align-items:center;gap:16px}\nbody.card-open .brand{display:none!important}\n@media (min-width:801px){body.card-open .brand{display:flex!important}}\n.brand .future{font:900 40px/.9 Arial,sans-serif!important;letter-spacing:-1.8px!important;white-space:nowrap}\n.brand .future span{display:block!important;margin:0!important}\n.brand .brand-r{display:flex;flex-direction:column;gap:9px;padding-top:2px}\n.brand h1{margin:0!important;font-size:20px!important;font-weight:800;letter-spacing:.2em!important;line-height:1;white-space:nowrap}\n.brand .candidate{margin:0!important;padding:0!important;border:0!important;display:block}\n.brand .candidate .proj{display:inline-flex;align-items:baseline;gap:6px;font-size:14px;font-weight:700;letter-spacing:.14em;line-height:1;white-space:nowrap}\n.brand .candidate .proj em{font-size:14px;letter-spacing:.06em}\n@media (max-width:800px){\n  .brand{gap:11px}\n  .brand .future{font-size:25px!important;letter-spacing:-1.1px!important}\n  .brand .brand-r{gap:6px;padding-top:1px}\n  .brand h1{font-size:14px!important;letter-spacing:.16em!important}\n  .brand .candidate .proj,.brand .candidate .proj em{font-size:11px}\n  .brand .candidate .proj{letter-spacing:.1em}\n}\n@media (min-width:1280px){.hud{left:calc(var(--brand-left,30px) + var(--brand-w,320px) + 18px)!important}}\n.brand .brand-r{align-items:flex-start}\n.brand .candidate{text-align:left}\n\n/* 2026-10-23: the top bar ends 16px before the right-hand button group, whatever its width (「我的角色」 widened it) */\n@media (min-width:1280px){.hud{right:calc(100vw - var(--toolbar-left, calc(100vw - 598px)) + 16px)!important}}\n\n/* 2026-10-24: 「協作關係・依據」圖例移除 */\n#legend{display:none!important}\n\n/* 2026-10-25: Puma 的思考雲與「市政建言」按鈕（CSS2D，錨點在頭頂上方；內容往上長） */\n.puma-extra{width:0;height:0;overflow:visible;pointer-events:none}\n.puma-extra .px-col{position:absolute;left:0;bottom:20px;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:30px;width:max-content} /* 錨點與 Puma 名牌相同：往上推 20px，落在名牌上方 */\n.puma-extra .px-col:has(.puma-advice[hidden]) .puma-cloud{margin-bottom:26px} /* 只有雲時，留出小圓點的位置 */\n.puma-cloud{position:relative;max-width:210px;padding:9px 14px;border-radius:22px;background:#fffdf9;color:#211d1d;border:1.5px solid #211d1d1f;box-shadow:0 6px 18px #4a2a1430;font:600 12.5px/1.5 \"Noto Sans TC\",sans-serif;text-align:center;white-space:normal;animation:pumaCloudIn .45s ease-out}\n.puma-cloud[hidden],.puma-advice[hidden]{display:none!important}\n.puma-cloud .q{display:block}\n.puma-cloud .src{display:block;margin-top:3px;font:500 10px/1.3 \"Noto Sans TC\",sans-serif;color:#8a7a70;letter-spacing:.02em}\n.puma-cloud .src:empty{display:none}\n.puma-cloud i{position:absolute;border-radius:50%;background:#fffdf9;border:1.5px solid #211d1d1f;box-shadow:0 3px 8px #4a2a1420}\n.puma-cloud .d1{width:12px;height:12px;left:calc(50% - 4px);bottom:-14px}\n.puma-cloud .d2{width:7px;height:7px;left:calc(50% + 4px);bottom:-24px}\n.puma-advice{pointer-events:auto;display:inline-flex;align-items:center;gap:4px;padding:6px 12px;border-radius:999px;background:#db6a41;color:#fff!important;border:2px solid #fff;box-shadow:0 4px 14px #4a2a1440;font:800 12.5px/1.2 \"Noto Sans TC\",sans-serif;text-decoration:none;letter-spacing:.04em;white-space:nowrap;cursor:pointer}\n.puma-advice:hover{background:#c85a33}\n.puma-advice:focus-visible{outline:3px solid #fcea8b;outline-offset:2px}\n@keyframes pumaCloudIn{from{opacity:0;transform:translateY(6px) scale(.92)}to{opacity:1;transform:none}}\n@media (prefers-reduced-motion:reduce){.puma-cloud{animation:none}}\n/* 島主名牌與角色卡 */\n.name-tag.puma-tag.lord-tag{border-color:#e9e1cc}\n.name-tag.puma-tag.lord-tag i{background:#f5d33a;color:#211d1d}\n.icon-tile.puma-tile.lord-tile{background:linear-gradient(150deg,#f5d33a,#e9e1cc);color:#211d1d}\n.lord-link{display:inline-block;padding:8px 14px;border-radius:999px;background:#211d1d;color:#fff8f4!important;font-weight:800;text-decoration:none}\n.lord-link:hover{background:#3a3332}\n/* 2026-11-12 族群與語言: one name plate for the joined island, small sub-category tags on its three cells */\n.island-label.group{font-size:12.5px}\n.island-label.sub{font-size:10px!important;padding:2px 8px!important;min-height:22px!important;background:#fff8f4e6!important;color:#5a3a2a;font-weight:600}\n.island-label.sub.numonly{font-size:10px!important;padding:2px 8px!important}\n.island-label.sub.selected{background:#211d1d!important;color:#fff8f4!important}\n.tree details.group>.subs{padding:2px 0 8px 24px;gap:0}\n.tree details.group>.subs>.island-open{margin:0 8px 4px 16px}\n.tree details.sub{border-bottom:0;border-top:1px dashed var(--line)}\n.tree details.sub>summary{min-height:42px;padding:6px 8px 6px 10px}\n.tree details.sub>summary::before{content:\"\";width:6px;height:6px;border-radius:50%;background:var(--coral);flex:none}\n.tree details.sub>.children{padding-left:26px}\n#tree details.group.current>summary{background:#fff1e8;box-shadow:inset 3px 0 0 #db6a41;border-radius:10px}\n.card .group-up{border:0;background:#fff1e8;color:#a5442a;font-weight:700;font-size:12px;border-radius:999px;padding:5px 12px;margin:2px 0 8px;cursor:pointer}\n.card .group-up:hover{background:#fcea8b}\n/* 2026-11-12 市民大道 video (self-hosted <video>) */\n.video-modal{position:fixed;inset:0;z-index:80;display:grid;place-items:center;background:#211d1dd9;padding:max(16px,env(safe-area-inset-top)) max(16px,env(safe-area-inset-right)) max(16px,env(safe-area-inset-bottom)) max(16px,env(safe-area-inset-left))}\n.video-modal[hidden]{display:none}\n.video-box{width:min(1040px,100%,calc((100dvh - 120px) * 16 / 9));background:#fff8f4;border-radius:18px;overflow:hidden;box-shadow:0 24px 64px #0009}\n.video-head{display:flex;align-items:center;gap:12px;padding:10px 10px 10px 20px}\n.video-title{flex:1;min-width:0}\n.video-head .eyebrow{font:10px ui-monospace,monospace;color:#db6a41;letter-spacing:.1em;margin:0 0 2px}\n.video-head h3{margin:0;font-size:16px;line-height:1.3;color:#211d1d}\n.video-modal .video-close{flex:0 0 auto;width:44px;height:44px;min-width:44px;min-height:44px;padding:0;margin:0;border:0;border-radius:50%;background:#211d1d;color:#fff8f4;display:grid;place-items:center;line-height:0;box-sizing:border-box;cursor:pointer;transition:background .15s}\n.video-modal .video-close:hover{background:#db6a41}\n.video-modal .video-close svg{width:18px;height:18px;stroke:currentColor;stroke-width:2.4;stroke-linecap:round;fill:none}\n.video-frame{position:relative;aspect-ratio:16/9;background:#000}\n.video-frame video{position:absolute;inset:0;width:100%;height:100%;display:block;background:#000;object-fit:contain}\n.video-msg{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);margin:0;color:#fff8f4;font-size:14px;background:#211d1dcc;padding:8px 14px;border-radius:999px}\n@media (max-width:600px){.video-modal{padding:12px}.video-box{border-radius:14px}.video-head{padding:8px 8px 8px 16px}}\n.viaduct-tip{position:fixed;z-index:30;pointer-events:none;background:#211d1d;color:#fff8f4;font-size:12px;font-weight:600;border-radius:999px;padding:5px 11px;transform:translate(12px,12px);white-space:nowrap}\n.viaduct-tip[hidden]{display:none}\n/* 2026-11-12 市民大道 as index entry 18: hub name plates, index entry, policy link beside the video title */\n.video-title-row{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 14px}\n.video-link{font-size:13px;font-weight:700;color:#a5442a;text-decoration:none;border-bottom:1.5px solid #db6a4166;padding-bottom:1px;white-space:nowrap}\n.video-link:hover{color:#db6a41;border-bottom-color:#db6a41}\n.tree details.road .children{gap:6px}\n.tree .road-video{font-weight:700}\n.tree .road-link{font-size:12px;color:#a5442a;padding:7px 9px;text-decoration:none}\n.tree .road-link:hover{background:#fcea8b88;border-radius:7px}\n"
