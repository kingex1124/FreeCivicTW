            "text": "// 市民大道高架橋 (2026-11-10, visual only): an elevated road running east–west across the middle of the archipelago,\n// between the 3rd and 4th rows of islands.\n// v59 (2026-11-11): each end comes down onto its own hexagonal island set in the island grid — one left of\n// 親子同行卡, one right of 原住民族 — so the road starts and ends on land. On each of these hub islands the road\n// arrives on a curving S-shaped ramp, runs on at grade past a bus stop and a zebra crossing, and ends in a roundabout\n// (迴轉道) where the traffic turns back. The ramps are checked so the deck clears every walkway, footbridge and\n// policy model they pass over.\n// The viaduct has its own meshes and materials so it can fade to a ghost when the camera looks at an island it passes\n// over (otherwise it would hide what is under it); the hub islands are land and never fade.\n// Decorative: no policy content, no counts or dates.\nimport { R, TOP, SPACING } from \"./world.js?v=20261112-1\";\nimport { WATER_Y } from \"./environment.js?v=20261026-1\";\n\nconst SQ3 = Math.sqrt(3);\n\n// how far a point is outside a pointy-top hex of circumradius r (negative = inside)\nfunction hexOutside(px, pz, c, r) {\n  const dx = Math.abs(px - c.x),\n    dz = Math.abs(pz - c.z);\n  const a = (r * SQ3) / 2;\n  return Math.max(dx - a, (dz + dx / SQ3 - r) * (SQ3 / 2));\n}\n\n// the row boundary just south of the middle row: rows sit 1.5·S apart, so halfway between two rows\nexport function viaductLine(centers) {\n  const zs = [...new Set([...centers.values()].map((c) => +c.z.toFixed(3)))].sort((a, b) => a - b);\n  const zMid = (zs[0] + zs[zs.length - 1]) / 2;\n  let Z = zs[0];\n  for (let k = 1; k < zs.length; k++) {\n    const m = (zs[k - 1] + zs[k]) / 2;\n    if (Math.abs(m - zMid - 1) < Math.abs(Z - zMid - 1)) Z = m;\n  }\n  return Z;\n}\n\n// the two hub islands: in the island grid, next to the outermost islands of the row just north of the road\nexport function viaductHubs(centers) {\n  const Z = viaductLine(centers);\n  const row = [...centers.values()].filter((c) => c.z < Z && Z - c.z < 2.5);\n  const step = SQ3 * SPACING;\n  const w = row.reduce((a, c) => (c.x < a.x ? c : a)),\n    e = row.reduce((a, c) => (c.x > a.x ? c : a));\n  return [\n    { x: w.x - step, z: w.z, sgn: -1 },\n    { x: e.x + step, z: e.z, sgn: 1 },\n  ];\n}\n\nconst smooth = (u) => (u <= 0 ? 0 : u >= 1 ? 1 : u * u * (3 - 2 * u)); // S-curve: flat at both ends\n\nexport function buildViaduct({ THREE, scene, kit, centers, bridges, colors, debug, tree }) {\n  const list = [...centers.values()];\n  const idOf = new Map([...centers.entries()].map(([id, c]) => [c, id]));\n  const Z = viaductLine(centers);\n  const W = 0.96, // deck width\n    T = 0.12, // deck thickness\n    HALF = W / 2 + 0.1; // half-width of the band that has to stay clear below the deck\n  const LAND_Y = TOP; // hub island top, same height as the policy islands\n  const END_T = LAND_Y + 0.035; // road surface at grade\n\n  const band = list.filter((c) => Math.abs(c.z - Z) < R);\n  const bandIds = new Set(band.map((c) => idOf.get(c)));\n\n  // ---------- what has to stay clear under the deck ----------\n  const WALK = TOP + 0.5;\n  const obs = [];\n  for (const items of kit.batches.values())\n    for (const e of items) {\n      if (!e.pos || !e.scale) continue;\n      const r = Math.max(e.scale.x, e.scale.z) / 2;\n      if (r > 2.5 || Math.abs(e.pos.z - Z) > 4) continue;\n      // footprint half-sizes along x and z (exact for parts turned by a multiple of 90°, a circle otherwise)\n      const yaw = ((((e.rotation?.[1] || 0) % Math.PI) + Math.PI) % Math.PI) / (Math.PI / 2);\n      const square = Math.abs(yaw - Math.round(yaw)) < 0.02 && !e.rotation?.[0] && !e.rotation?.[2];\n      const [rx, rz] = !square ? [r, r] : Math.round(yaw) % 2 ? [e.scale.z / 2, e.scale.x / 2] : [e.scale.x / 2, e.scale.z / 2];\n      obs.push({ x: e.pos.x, z: e.pos.z, r: rx, rz, top: e.pos.y + e.scale.y / 2 + 0.06, bot: e.pos.y - e.scale.y / 2, e });\n    }\n  for (const c of list)\n    if (Math.abs(c.z - Z) < 4)\n      for (let k = 0; k < 6; k++)\n        for (let t = 0; t < 1; t += 0.1) {\n          const a0 = Math.PI / 2 + (k * Math.PI) / 3,\n            a1 = a0 + Math.PI / 3;\n          obs.push({ x: c.x + Math.cos(a0) * 1.8 * (1 - t) + Math.cos(a1) * 1.8 * t, z: c.z + Math.sin(a0) * 1.8 * (1 - t) + Math.sin(a1) * 1.8 * t, r: 0.08, rz: 0.08, top: WALK, walk: true });\n        }\n  for (const b of bridges || []) for (let t = 0; t <= 1; t += 0.125) obs.push({ x: b.pa.x + (b.pb.x - b.pa.x) * t, z: b.pa.z + (b.pb.z - b.pa.z) * t, r: 0.18, rz: 0.18, top: TOP + 0.62 });\n\n  // ---------- plan: hubs, ramps, the straight span ----------\n  const hubs = viaductHubs(centers);\n  const RB = 0.62; // roundabout: asphalt radius\n  for (const h of hubs) {\n    h.rc = { x: h.x + h.sgn * 0.55, z: h.z + 0.35 }; // roundabout centre, on the outer half of the hub island\n    h.xr = h.rc.x - h.sgn * (RB - 0.12); // where the road joins the roundabout\n    h.xg = h.x - h.sgn * 0.3; // foot of the ramp (road at grade between here and the roundabout)\n    h.zl = h.rc.z;\n  }\n  const [hw, he] = hubs;\n  // flat span height: clear the tallest thing along the straight middle part\n  let Y = 1.7;\n  for (const o of obs) if (Math.abs(o.z - Z) < HALF + o.rz && o.x > hw.x + 2 && o.x < he.x - 2) Y = Math.max(Y, o.top + 0.04);\n  Y = Math.max(1.85, Y);\n  const YT = Y + T;\n\n  const rampOf = (h, L) => ({\n    u: (x) => ((x - h.xg) * -h.sgn) / L,\n    top: (x) => END_T + (YT - END_T) * smooth(((x - h.xg) * -h.sgn) / L),\n    zc: (x) => h.zl + (Z - h.zl) * smooth(((x - h.xg) * -h.sgn) / L),\n  });\n  // the ramp: gentlest length whose deck clears everything it passes over (the hub island itself has nothing to clear)\n  function fit(h) {\n    const hub = { x: h.x, z: h.z };\n    for (let L = 4.2; L >= 2.6; L -= 0.1) {\n      const r = rampOf(h, L);\n      let ok = true;\n      for (const o of obs) {\n        const u = r.u(o.x);\n        if (u < 0 || u > 1.05) continue;\n        if (hexOutside(o.x, o.z, hub, R) < 0.05) continue;\n        let lo = 9,\n          hi = -9;\n        for (const dx of [-o.r, 0, o.r]) {\n          const x = o.x + dx;\n          if (Math.abs(o.z - r.zc(x)) < HALF + o.rz) (lo = Math.min(lo, r.top(x) - T)), (hi = Math.max(hi, r.top(x)));\n        }\n        // something hanging in the air well above the road surface (2026-11-12: the paper planes over 青年's stage, now\n        // that 青年 sits next to the west hub) passes over the ramp, it does not block it\n        if (o.bot != null && o.bot > hi + 0.25) continue;\n        // small or string-thin decor (bunting and its line, a lamp, a planter: no policy model, nothing a person walks on) gives way to the road\n        // and is cleared from under it below; policy models, walkways and bridges still decide the ramp\n        if (o.e && !o.e.owner && (Math.max(o.r, o.rz) < 0.35 || Math.min(o.e.scale.x, o.e.scale.y, o.e.scale.z) < 0.03)) {\n          o.under = true;\n          continue;\n        }\n        if (lo < o.top) {\n          ok = false;\n          if (!h.blocked) h.blocked = { L: +L.toFixed(1), x: +o.x.toFixed(2), z: +o.z.toFixed(2), top: +o.top.toFixed(2), deck: +lo.toFixed(2), what: o.e ? (o.e.owner || \"decor\") : o.walk ? \"walkway\" : \"bridge\" };\n          break;\n        }\n      }\n      if (ok) return { L, ...r };\n    }\n    return { L: 3.4, ...rampOf(h, 3.4), fallback: true };\n  }\n  hw.ramp = fit(hw);\n  he.ramp = fit(he);\n  const X0 = hw.xr,\n    X1 = he.xr;\n  const inRamp = (h, x) => (x - h.xg) * -h.sgn >= 0 && (x - h.xg) * -h.sgn <= h.ramp.L;\n  const deckTop = (x) => {\n    for (const h of hubs) {\n      if ((x - h.xg) * -h.sgn < 0) return END_T;\n      if (inRamp(h, x)) return h.ramp.top(x);\n    }\n    return YT;\n  };\n  const zc = (x) => {\n    for (const h of hubs) {\n      if ((x - h.xg) * -h.sgn < 0) return h.zl;\n      if (inRamp(h, x)) return h.ramp.zc(x);\n    }\n    return Z;\n  };\n  const dzdx = (x) => (zc(x + 0.01) - zc(x - 0.01)) / 0.02;\n  const slopeAt = (x) => Math.atan2(deckTop(x + 0.01) - deckTop(x - 0.01), 0.02);\n  const yawAt = (x) => -Math.atan(dzdx(x));\n  // a point `off` to the side of the centre line (perpendicular to the road, + = south), y absolute\n  const at = (x, off, y) => {\n    const d = dzdx(x),\n      l = Math.hypot(1, d);\n    return [x - (d / l) * off, y, zc(x) + off / l];\n  };\n\n  // ---------- materials (own, so the whole road can fade) ----------\n  const mats = [];\n  const mat = (color, extra = {}) => {\n    const m = new THREE.MeshStandardMaterial({ color, roughness: 0.78, metalness: 0, ...extra });\n    mats.push(m);\n    return m;\n  };\n  const CON = mat(0xd8d2c8),\n    CON_D = mat(0xbdb6ab),\n    PARA = mat(0xf2efe8),\n    ASPH = mat(0x55555c, { roughness: 0.9 }),\n    STRIPE = mat(colors.coral),\n    MED = mat(0xe6e1d8),\n    WHITE = mat(0xffffff),\n    STEEL = mat(0x5f6b72, { roughness: 0.5 }),\n    STONE_W = mat(0xcfc6b8),\n    LAMP = mat(0xfff4cf, { emissive: 0xffc777, emissiveIntensity: 0 });\n  const group = new THREE.Group();\n  group.name = \"viaduct\";\n  const boxes = [],\n    cyls = [];\n  const box = (x, y, z, w, h, d, m, rz = 0, ry = 0) => boxes.push({ x, y, z, w, h, d, m, rz, ry });\n  const cyl = (x, y, z, dia, h, m) => cyls.push({ x, y, z, dia, h, m });\n\n  // ---------- the deck, swept along the (curving) centre line ----------\n  const xs = [];\n  for (let x = X0; x < X1; x += 0.08) xs.push(x);\n  xs.push(X1);\n  function sweep(z0, z1, y0, y1, m, x0 = X0, x1 = X1) {\n    const pts = xs.filter((x) => x >= x0 - 1e-6 && x <= x1 + 1e-6);\n    if (pts.length < 2) return null;\n    const pos = [],\n      idx = [];\n    const face = (corner) => {\n      const base = pos.length / 3;\n      for (const x of pts) {\n        const t = deckTop(x);\n        for (const [z, y] of corner) pos.push(...at(x, z, t + y));\n      }\n      for (let k = 0; k < pts.length - 1; k++) {\n        const a = base + k * 2;\n        idx.push(a, a + 2, a + 1, a + 1, a + 2, a + 3);\n      }\n    };\n    face([[z1, y1], [z0, y1]]);\n    face([[z0, y0], [z1, y0]]);\n    face([[z0, y1], [z0, y0]]);\n    face([[z1, y0], [z1, y1]]);\n    for (const x of [pts[0], pts[pts.length - 1]]) {\n      const t = deckTop(x),\n        base = pos.length / 3;\n      pos.push(...at(x, z0, t + y0), ...at(x, z1, t + y0), ...at(x, z1, t + y1), ...at(x, z0, t + y1));\n      if (x === pts[0]) idx.push(base, base + 1, base + 2, base, base + 2, base + 3);\n      else idx.push(base, base + 2, base + 1, base, base + 3, base + 2);\n    }\n    const g = new THREE.BufferGeometry();\n    g.setAttribute(\"position\", new THREE.Float32BufferAttribute(pos, 3));\n    g.setIndex(idx);\n    g.computeVertexNormals();\n    const mesh = new THREE.Mesh(g, m);\n    mesh.receiveShadow = true;\n    group.add(mesh);\n    return mesh;\n  }\n  // where the road is up in the air: from the foot of one ramp to the foot of the other\n  const E0 = hw.xg + 0.05,\n    E1 = he.xg - 0.05;\n  const deckMesh = sweep(-W / 2, W / 2, -T, 0.1, CON, E0, E1); // hit test for hovering (raised to the parapet tops)\n  deckMesh.visible = false;\n  sweep(-W / 2, W / 2, -T, 0, CON, E0, E1);\n  sweep(-W / 2 + 0.05, W / 2 - 0.05, 0, 0.012, ASPH, E0, E1);\n  for (const s of [-1, 1]) {\n    const zo = s * (W / 2);\n    sweep(Math.min(zo, zo - s * 0.04), Math.max(zo, zo - s * 0.04), 0, 0.1, PARA, E0, E1);\n    sweep(Math.min(zo, zo + s * 0.004), Math.max(zo, zo + s * 0.004), -0.085, -0.055, STRIPE, E0, E1);\n  }\n  sweep(-0.0175, 0.0175, 0, 0.05, MED, E0 + 0.3, E1 - 0.3);\n  // on the hub islands the road is at grade: asphalt between low kerbs\n  for (const h of hubs) {\n    const a = Math.min(h.xr, h.xg),\n      b = Math.max(h.xr, h.xg);\n    sweep(-W / 2 + 0.03, W / 2 - 0.03, -0.03, 0.0, ASPH, a - 0.02, b + 0.08);\n    for (const s of [-1, 1]) sweep(s < 0 ? -W / 2 : W / 2 - 0.035, s < 0 ? -W / 2 + 0.035 : W / 2, -0.03, 0.02, PARA, h.sgn < 0 ? a + 0.2 : a, h.sgn < 0 ? b : b - 0.2);\n  }\n  // under the low part of each ramp, while it is still over its hub island: a stone retaining wall\n  for (const h of hubs)\n    for (let u = 0; u < h.ramp.L; u += 0.08) {\n      const x = h.xg - h.sgn * (u + 0.04),\n        under = deckTop(x) - T;\n      const [px, , pz] = at(x, 0, 0);\n      if (under - LAND_Y > 0.45 || under <= LAND_Y || hexOutside(px, pz, { x: h.x, z: h.z }, R) > -0.12) continue;\n      box(px, (LAND_Y + under) / 2, pz, 0.085, under - LAND_Y, W - 0.06, STONE_W, slopeAt(x), yawAt(x));\n    }\n  // dashed lane lines on the elevated part\n  for (let x = E0 + 0.3; x < E1 - 0.3; x += 0.36)\n    for (const s of [-1, 1]) {\n      const [px, , pz] = at(x, s * 0.21, 0);\n      box(px, deckTop(x) + 0.0135, pz, 0.16, 0.003, 0.012, WHITE, slopeAt(x), yawAt(x));\n    }\n\n  // ---------- piers: in open water or canals, never on an island or on a footbridge ----------\n  const BASE = WATER_Y - 0.3;\n  const bridgeMids = (bridges || []).map((b) => ({ x: (b.pa.x + b.pb.x) / 2, z: (b.pa.z + b.pb.z) / 2 }));\n  const hubC = hubs.map((h) => ({ x: h.x, z: h.z }));\n  const clearAt = (x, z, m = 0.1) => [...list, ...hubC].every((c) => hexOutside(x, z, c, R) > m);\n  // portal piers straddle the footbridges the road passes over: a column in the canal each side, a beam across\n  const portals = [];\n  for (const b of bridges || []) {\n    const mx = (b.pa.x + b.pb.x) / 2,\n      mz = (b.pa.z + b.pb.z) / 2;\n    if (Math.abs(mz - zc(mx)) > 0.3 || mx < E0 || mx > E1) continue;\n    const ax = b.pb.x - b.pa.x,\n      az = b.pb.z - b.pa.z,\n      al = Math.hypot(ax, az);\n    const ex = az / al,\n      ez = -ax / al;\n    const cols = [-1, 1].map((s) => [mx + ex * 0.33 * s, mz + ez * 0.33 * s]);\n    if (cols.every(([x, z]) => clearAt(x, z, 0.12))) portals.push({ mx, mz, ex, ez, cols });\n  }\n  const piers = [];\n  const nearPortal = (x) => portals.some((p) => Math.abs(p.mx - x) < 1.2);\n  const okPier = (x) => clearAt(x, zc(x)) && bridgeMids.every((m) => Math.hypot(m.x - x, m.z - zc(x)) >= 0.55) && !nearPortal(x);\n  let last = -1e9;\n  for (let x = E0 + 0.4; x <= E1 - 0.4; x += 0.02) {\n    if (x - last < 1.5 || !okPier(x) || deckTop(x) - T < 0.45) continue;\n    let x2 = x;\n    while (x2 + 0.02 <= E1 - 0.4 && okPier(x2 + 0.02) && x2 - x < 1.2) x2 += 0.02;\n    const px = (x + x2) / 2;\n    piers.push(px);\n    last = px;\n    x = x2;\n  }\n  for (const px of piers) {\n    const top = deckTop(px) - T;\n    cyl(px, (BASE + top) / 2, zc(px), 0.26, top - BASE, CON_D);\n    box(px, top - 0.06, zc(px), 0.34, 0.12, W * 0.9, CON, slopeAt(px), yawAt(px));\n  }\n  for (const p of portals) {\n    const top = deckTop(p.mx) - T;\n    for (const [x, z] of p.cols) cyl(x, (BASE + top) / 2, z, 0.2, top - BASE, CON_D);\n    box(p.mx, top - 0.07, p.mz, 0.9, 0.14, 0.24, CON, 0, Math.atan2(-p.ez, p.ex));\n  }\n  // street lamps along both parapets of the elevated part\n  let k = 0;\n  for (let x = E0 + 0.7; x < E1 - 0.6; x += 1.25, k++) {\n    const s = k % 2 ? 1 : -1,\n      yb = deckTop(x) + 0.1;\n    const [px, , pz] = at(x, s * (W / 2 - 0.02), 0),\n      [ax, , az] = at(x, s * (W / 2 - 0.09), 0),\n      [hx, , hz] = at(x, s * (W / 2 - 0.16), 0);\n    cyl(px, yb + 0.17, pz, 0.036, 0.34, STEEL);\n    box(ax, yb + 0.34, az, 0.016, 0.016, 0.15, STEEL, 0, yawAt(x));\n    box(hx, yb + 0.325, hz, 0.06, 0.02, 0.05, LAMP, 0, yawAt(x));\n  }\n  // an overhead sign gantry near the middle with the road's name\n  const gx = (hw.x + he.x) / 2 - 1.1;\n  for (const s of [-1, 1]) cyl(gx, YT + 0.22, Z + s * (W / 2 - 0.03), 0.06, 0.44, STEEL);\n  box(gx, YT + 0.44, Z, 0.04, 0.04, W - 0.04, STEEL);\n  const sc = document.createElement(\"canvas\");\n  sc.width = 512;\n  sc.height = 160;\n  const g2 = sc.getContext(\"2d\");\n  g2.fillStyle = \"#1f6b4a\";\n  g2.fillRect(0, 0, 512, 160);\n  g2.strokeStyle = \"#ffffff\";\n  g2.lineWidth = 6;\n  g2.strokeRect(10, 10, 492, 140);\n  g2.fillStyle = \"#ffffff\";\n  g2.font = \"900 82px 'Noto Sans TC','PingFang TC',sans-serif\";\n  g2.textAlign = \"center\";\n  g2.fillText(\"市民大道\", 256, 112);\n  const tex = new THREE.CanvasTexture(sc);\n  tex.colorSpace = THREE.SRGBColorSpace;\n  tex.anisotropy = 4;\n  const signMat = mat(0xffffff, { map: tex, roughness: 0.6, emissive: 0xffffff, emissiveMap: tex, emissiveIntensity: 0.35 });\n  for (const s of [1, -1]) {\n    const m = new THREE.Mesh(new THREE.PlaneGeometry(0.62, 0.2), signMat);\n    m.position.set(gx + s * 0.03, YT + 0.36, Z);\n    m.rotation.y = (s * Math.PI) / 2;\n    group.add(m);\n  }\n  const back = new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.21, 0.63), mat(0x1f6b4a, { roughness: 0.7 }));\n  back.position.set(gx, YT + 0.36, Z);\n  group.add(back);\n\n  // ---------- the hub islands (land: built like the other islands, never fades) ----------\n  const hubGroup = new THREE.Group();\n  hubGroup.name = \"viaduct-hubs\";\n  const PAVE = 0xe8ddcb,\n    GRASS = 0xa8c48c,\n    CURB = 0xe4d6c3,\n    ASPH_C = 0x55555c;\n  const before = new Map([...kit.batches.entries()].map(([kk, v]) => [kk, v.length]));\n  const curbMat = new THREE.MeshStandardMaterial({ color: CURB, roughness: 0.85, side: THREE.DoubleSide });\n  for (const h of hubs) {\n    // body: a hex prism like the other islands, with strata and a sandy foot\n    const depth = LAND_Y - (WATER_Y - 0.5);\n    const cliff = new THREE.MeshStandardMaterial({ color: 0xc2a07a, roughness: 0.95 });\n    const bm = new THREE.Mesh(new THREE.CylinderGeometry(R, R, depth, 6, 1), [cliff, new THREE.MeshStandardMaterial({ color: PAVE, roughness: 0.92 }), cliff]);\n    bm.position.set(h.x, LAND_Y - depth / 2, h.z);\n    bm.receiveShadow = true;\n    hubGroup.add(bm);\n    for (const [y, rr, hh, c] of [[LAND_Y - 0.22, R + 0.012, 0.05, 0xa98760], [LAND_Y - 0.48, R + 0.02, 0.05, 0x8f7564], [WATER_Y + 0.02, R + 0.13, 0.06, 0xead9b8]]) {\n      const st = new THREE.Mesh(new THREE.CylinderGeometry(rr, rr, hh, 6, 1), new THREE.MeshStandardMaterial({ color: c, roughness: 0.95 }));\n      st.position.set(h.x, y, h.z);\n      hubGroup.add(st);\n    }\n    // rim kerb round the top edge\n    for (const rr of [R, R - 0.07]) {\n      const rim = new THREE.Mesh(new THREE.CylinderGeometry(rr, rr, 0.05, 6, 1, true), curbMat);\n      rim.position.set(h.x, LAND_Y + 0.02, h.z);\n      hubGroup.add(rim);\n    }\n    const rimTop = new THREE.Mesh(new THREE.RingGeometry(R - 0.07, R, 6, 1, Math.PI / 2), curbMat);\n    rimTop.rotation.x = -Math.PI / 2;\n    rimTop.position.set(h.x, LAND_Y + 0.045, h.z);\n    hubGroup.add(rimTop);\n\n    const s = h.sgn,\n      { rc } = h;\n    // lawns on the island's inner corner and its far corner\n    kit.cyl(h.x - s * 0.5, LAND_Y + 0.006, h.z - 0.95, 1.5, 0.012, GRASS);\n    kit.cyl(h.x + s * 0.2, LAND_Y + 0.006, h.z + 1.3, 1.0, 0.012, GRASS);\n    // roundabout (迴轉道): asphalt disc on a paved ring, dashed lane ring, kerbed central island with a tree\n    kit.cyl(rc.x, LAND_Y + 0.008, rc.z, (RB + 0.14) * 2, 0.016, PAVE);\n    kit.cyl(rc.x, LAND_Y + 0.016, rc.z, RB * 2, 0.022, ASPH_C);\n    for (let a = 0; a < Math.PI * 2 - 0.01; a += Math.PI / 12) kit.hbox(rc.x + Math.cos(a) * 0.43, LAND_Y + 0.028, rc.z + Math.sin(a) * 0.43, 0.012, 0.003, 0.07, 0xffffff, null, [0, -a, 0]);\n    kit.cyl(rc.x, LAND_Y + 0.035, rc.z, 0.56, 0.05, CURB);\n    kit.cyl(rc.x, LAND_Y + 0.061, rc.z, 0.48, 0.01, 0x86a56c);\n    for (let j = 0; j < 10; j++) {\n      const a = (j / 10) * Math.PI * 2;\n      kit.part(\"sphere\", [rc.x + Math.cos(a) * 0.19, LAND_Y + 0.075, rc.z + Math.sin(a) * 0.19], [0.05, 0.04, 0.05], j % 2 ? colors.coral : 0xf2d06b);\n    }\n    if (tree) tree(rc.x, rc.z, 0.4);\n    // arrows on the ring, one way round\n    for (let j = 0; j < 4; j++) {\n      const a = (j / 4) * Math.PI * 2 + 0.4;\n      kit.part(\"tetra\", [rc.x + Math.cos(a) * 0.52, LAND_Y + 0.03, rc.z + Math.sin(a) * 0.52], [0.07, 0.004, 0.05], 0xffffff, null, [0, -a, 0]);\n    }\n    // zebra crossing across the at-grade road, and a give-way line where it meets the roundabout\n    const zx = h.xr - s * 0.36;\n    for (let j = 0; j < 7; j++) {\n      const [px, , pz] = at(zx, -W / 2 + 0.11 + j * ((W - 0.22) / 6), 0);\n      kit.hbox(px, END_T + 0.004, pz, 0.15, 0.003, 0.06, 0xffffff);\n    }\n    const [sx0, , sz0] = at(h.xr - s * 0.06, -0.24, 0);\n    kit.hbox(sx0, END_T + 0.004, sz0, 0.025, 0.003, 0.44, 0xffffff);\n    // pavements either side of the road, a lamp on each\n    const a0 = Math.min(h.xr, h.xg),\n      b0 = Math.max(h.xr, h.xg);\n    for (const side of [-1, 1]) {\n      kit.hbox((a0 + b0) / 2, LAND_Y + 0.01, h.zl + side * (W / 2 + 0.17), b0 - a0, 0.02, 0.3, PAVE);\n      const lx = (a0 + b0) / 2;\n      kit.cyl(lx, LAND_Y + 0.19, h.zl + side * (W / 2 + 0.08), 0.03, 0.38, 0x5f6b72);\n      kit.part(\"glowsphere\", [lx, LAND_Y + 0.39, h.zl + side * (W / 2 + 0.08)], [0.065, 0.065, 0.065], 0xfff4cf);\n    }\n    // a bus stop on the south pavement: shelter roof, posts, back panel, bench, sign pole\n    const bx = (a0 + b0) / 2 + s * 0.25,\n      bz = h.zl + W / 2 + 0.25;\n    kit.hbox(bx, LAND_Y + 0.25, bz + 0.03, 0.42, 0.025, 0.2, 0x3e7c8c);\n    for (const dx of [-0.18, 0.18]) kit.hbox(bx + dx, LAND_Y + 0.125, bz + 0.1, 0.025, 0.25, 0.025, 0x5f6b72);\n    kit.hbox(bx, LAND_Y + 0.12, bz + 0.11, 0.38, 0.2, 0.01, 0xcfe0e6);\n    kit.hbox(bx, LAND_Y + 0.06, bz + 0.05, 0.3, 0.025, 0.07, 0xc98a5c);\n    kit.cyl(bx - s * 0.28, LAND_Y + 0.18, bz - 0.06, 0.02, 0.36, 0x5f6b72);\n    kit.hbox(bx - s * 0.28, LAND_Y + 0.33, bz - 0.06, 0.1, 0.07, 0.015, 0xdb6a41);\n    // the 「市民大道」 name stone north of the roundabout, lamps round it\n    kit.hbox(rc.x, LAND_Y + 0.07, rc.z - RB - 0.3, 0.42, 0.14, 0.09, 0xcfc6b8);\n    kit.hbox(rc.x, LAND_Y + 0.08, rc.z - RB - 0.252, 0.34, 0.06, 0.01, 0x1f6b4a);\n    for (const a of [-Math.PI / 2 - 0.9, -Math.PI / 2 + 0.9, Math.PI / 2 + s * 0.9]) {\n      const lx = rc.x + Math.cos(a) * (RB + 0.1),\n        lz = rc.z + Math.sin(a) * (RB + 0.1);\n      kit.cyl(lx, LAND_Y + 0.19, lz, 0.03, 0.38, 0x5f6b72);\n      kit.part(\"glowsphere\", [lx, LAND_Y + 0.39, lz], [0.065, 0.065, 0.065], 0xfff4cf);\n    }\n    // trees and benches on the lawns\n    if (tree)\n      for (const [dx, dz2, size] of [[0.55, -1.25, 0.42], [0.05, -1.2, 0.36], [-0.45, -1.05, 0.4], [0.95, -0.72, 0.34], [0.15, 1.55, 0.34], [0.6, 1.3, 0.32]]) tree(h.x - s * dx, h.z + dz2, size);\n    // a small car park on the outer north corner: bays, kerb stops, two parked cars\n    const px0 = h.x + s * 0.85,\n      pz0 = h.z - 1.0;\n    kit.hbox(px0, LAND_Y + 0.009, pz0, 0.78, 0.014, 0.5, 0x6a6a70);\n    for (let j = 0; j < 5; j++) kit.hbox(px0 - 0.36 + j * 0.18, LAND_Y + 0.018, pz0 + 0.02, 0.012, 0.003, 0.4, 0xffffff);\n    for (let j = 0; j < 4; j++) kit.hbox(px0 - 0.27 + j * 0.18, LAND_Y + 0.025, pz0 - 0.17, 0.1, 0.02, 0.025, 0xcfc6b8);\n    for (const [j, c] of [[0, 0x3e7c8c], [2, 0xe8c547]]) {\n      const cx = px0 - 0.27 + j * 0.18;\n      kit.hbox(cx, LAND_Y + 0.045, pz0 + 0.03, 0.085, 0.055, 0.17, c);\n      kit.hbox(cx, LAND_Y + 0.09, pz0 + 0.05, 0.075, 0.045, 0.09, 0xcfe0e6);\n    }\n    // a row of planters along the outer rim, between the car park and the south lawn\n    for (let j = 0; j < 5; j++) {\n      const a = -0.55 + j * 0.28; // angle across the outer side\n      const rx = h.x + s * Math.cos(a) * 1.62,\n        rz = h.z + Math.sin(a) * 1.62;\n      if (Math.hypot(rx - rc.x, rz - rc.z) < RB + 0.25 || Math.hypot(rx - px0, rz - pz0) < 0.5) continue;\n      kit.hbox(rx, LAND_Y + 0.05, rz, 0.16, 0.1, 0.16, 0xc98a5c);\n      kit.part(\"leaf\", [rx, LAND_Y + 0.15, rz], [0.17, 0.14, 0.17], 0x7f9a6a);\n    }\n    // direction arrows painted on the at-grade lanes\n    for (const side of [-1, 1]) {\n      const ax = (h.xg + h.xr) / 2 + s * side * 0.1;\n      const [px, , pz] = at(ax, side * 0.21, 0);\n      kit.part(\"tetra\", [px, END_T + 0.004, pz], [0.09, 0.004, 0.06], 0xffffff, null, [0, side > 0 ? 0 : Math.PI, 0]);\n      kit.hbox(px - side * 0.07, END_T + 0.004, pz, 0.1, 0.003, 0.02, 0xffffff);\n    }\n    for (const [dx, dz2] of [[0.25, -0.82], [0.3, 1.2]]) {\n      kit.hbox(h.x - s * dx, LAND_Y + 0.05, h.z + dz2, 0.24, 0.02, 0.08, 0xc98a5c);\n      kit.hbox(h.x - s * dx, LAND_Y + 0.02, h.z + dz2, 0.2, 0.04, 0.05, 0x5f6b72);\n    }\n  }\n  // decor of the neighbouring islands that spilled over onto the hub sites (ledges, edge items) goes\n  let cleared = 0;\n  for (const [kk, items] of kit.batches.entries())\n    for (const e of items.slice(0, before.get(kk) ?? 0))\n      if (!e.owner && e.pos && e.scale && Math.max(e.scale.x, e.scale.z) < 2.5 && hubC.some((c) => hexOutside(e.pos.x, e.pos.z, c, R) < 0.12) && list.every((c) => hexOutside(e.pos.x, e.pos.z, c, R) > 0)) {\n        e.scale.set(0, 0, 0);\n        cleared++;\n      }\n  // small decor the ramps now pass through (see fit): cleared, so nothing pokes through the deck\n  for (const o of obs) {\n    if (!o.under || !o.e.scale.x) continue;\n    const hit = [-o.r, 0, o.r].some((dx) => {\n      const x = o.x + dx;\n      if (x < hw.xg - 0.05 || x > he.xg + 0.05) return false;\n      return Math.abs(o.z - zc(x)) < HALF + o.rz && o.top > deckTop(x) - T && o.bot < deckTop(x) + 0.1;\n    });\n    if (hit) {\n      o.e.scale.set(0, 0, 0);\n      cleared++;\n    }\n  }\n\n  // ---------- instance everything collected above ----------\n  const m4 = new THREE.Matrix4(),\n    q = new THREE.Quaternion(),\n    eu = new THREE.Euler(),\n    v3 = new THREE.Vector3(),\n    sc3 = new THREE.Vector3();\n  const byMat = (arr) => {\n    const g = new Map();\n    for (const o of arr) (g.get(o.m) || g.set(o.m, []).get(o.m)).push(o);\n    return g;\n  };\n  const unitBox = new THREE.BoxGeometry(1, 1, 1),\n    unitCyl = new THREE.CylinderGeometry(0.5, 0.5, 1, 12);\n  for (const [m, arr] of byMat(boxes)) {\n    const im = new THREE.InstancedMesh(unitBox, m, arr.length);\n    arr.forEach((o, i) => {\n      eu.set(0, o.ry, o.rz, \"YZX\");\n      im.setMatrixAt(i, m4.compose(v3.set(o.x, o.y, o.z), q.setFromEuler(eu), sc3.set(o.w, o.h, o.d)));\n    });\n    im.castShadow = m === CON || m === STONE_W;\n    im.receiveShadow = true;\n    group.add(im);\n  }\n  for (const [m, arr] of byMat(cyls)) {\n    const im = new THREE.InstancedMesh(unitCyl, m, arr.length);\n    arr.forEach((o, i) => im.setMatrixAt(i, m4.compose(v3.set(o.x, o.y, o.z), q.identity(), sc3.set(o.dia, o.h, o.dia))));\n    im.castShadow = true;\n    im.receiveShadow = true;\n    group.add(im);\n  }\n\n  // ---------- traffic: two closed loops (inner and outer lane), turning back round each roundabout ----------\n  function lanePath(off) {\n    const pts = [];\n    const onRoad = (x, o) => {\n      const [px, , pz] = at(x, o, 0);\n      return [px, deckTop(x), pz];\n    };\n    // eastbound on the south side (driving on the right), westbound on the north side\n    for (let x = X0; x <= X1; x += 0.05) pts.push(onRoad(x, off));\n    // each lane keeps its own circle on the roundabout (inner 0.35, outer 0.53, either side of the dashed ring).\n    // A lane bends onto its circle with a cubic curve that starts along the road and ends along the circle, and bends\n    // off it the same way, so the turn is smooth at both joins.\n    const ringR = off < 0.2 ? 0.35 : 0.53;\n    const bez = (p0, p1, p2, p3, n) => {\n      for (let i = 1; i < n; i++) {\n        const t = i / n,\n          u = 1 - t;\n        const w = [u * u * u, 3 * u * u * t, 3 * u * t * t, t * t * t];\n        pts.push([0, 2].reduce((o, k) => ((o[k] = w[0] * p0[k] + w[1] * p1[k] + w[2] * p2[k] + w[3] * p3[k]), o), [0, END_T, 0]));\n      }\n    };\n    const arc = (h, from, to) => {\n      const c = h.rc,\n        dIn = h.sgn; // travel along x when arriving at this hub\n      const a0 = Math.atan2(from[2] - c.z, from[0] - c.x),\n        a1 = Math.atan2(to[2] - c.z, to[0] - c.x);\n      // right-hand traffic goes anticlockwise as seen from above, which in these coordinates is a falling angle\n      let sweep = a1 - a0;\n      while (sweep >= 0) sweep -= Math.PI * 2;\n      while (sweep < -Math.PI * 2) sweep += Math.PI * 2;\n      const lead = 0.85,\n        aE = a0 - lead,\n        aX = a0 + sweep + lead;\n      const onRing = (a) => [c.x + Math.cos(a) * ringR, END_T, c.z + Math.sin(a) * ringR];\n      const tan = (a) => [Math.sin(a), 0, -Math.cos(a)]; // direction of travel round the ring at angle a\n      const pE = onRing(aE),\n        pX = onRing(aX);\n      const kE = Math.hypot(pE[0] - from[0], pE[2] - from[2]) * 0.42,\n        kX = Math.hypot(to[0] - pX[0], to[2] - pX[2]) * 0.42;\n      const tE = tan(aE),\n        tX = tan(aX);\n      bez(from, [from[0] + dIn * kE, 0, from[2]], [pE[0] - tE[0] * kE, 0, pE[2] - tE[2] * kE], pE, 14);\n      pts.push(pE);\n      const steps = Math.ceil(Math.abs(aX - aE) / 0.08);\n      for (let i = 1; i < steps; i++) pts.push(onRing(aE + ((aX - aE) * i) / steps));\n      pts.push(pX);\n      bez(pX, [pX[0] + tX[0] * kX, 0, pX[2] + tX[2] * kX], [to[0] + dIn * kX, 0, to[2]], to, 14);\n    };\n    arc(he, onRoad(X1, off), onRoad(X1, -off));\n    for (let x = X1; x >= X0; x -= 0.05) pts.push(onRoad(x, -off));\n    arc(hw, onRoad(X0, -off), onRoad(X0, off));\n    const cum = [0];\n    for (let i = 1; i <= pts.length; i++) {\n      const a = pts[i - 1],\n        b = pts[i % pts.length];\n      cum.push(cum[i - 1] + Math.hypot(b[0] - a[0], b[1] - a[1], b[2] - a[2]));\n    }\n    return { pts, cum, len: cum[cum.length - 1] };\n  }\n  const loops = [lanePath(0.12), lanePath(0.31)];\n  const N = 24;\n  const bodyMat = mat(0xffffff, { roughness: 0.55 });\n  const cabMat = mat(0xcfe0e6, { roughness: 0.3, emissive: 0xfff0c2, emissiveIntensity: 0 });\n  const bodies = new THREE.InstancedMesh(new THREE.BoxGeometry(0.17, 0.055, 0.085), bodyMat, N);\n  const cabs = new THREE.InstancedMesh(new THREE.BoxGeometry(0.09, 0.045, 0.075), cabMat, N);\n  const palette = [0xdb6a41, 0xf2efe8, 0x3e7c8c, 0xe8c547, 0x5f6b72, 0xf6efe3, 0x9fc4e6, 0x2f3a46];\n  const cars = [];\n  for (let c = 0; c < N; c++) {\n    const loop = loops[c % 2];\n    // every car on a lane runs at that lane's speed, evenly spaced, so none can catch up with the one ahead\n    cars.push({ loop, s: ((Math.floor(c / 2) + (c % 2) * 0.5) / (N / 2)) * loop.len, v: c % 2 ? 0.9 : 0.8 });\n    bodies.setColorAt(c, new THREE.Color(palette[c % palette.length]));\n  }\n  group.add(bodies, cabs);\n  const pointAt = (loop, s) => {\n    let lo = 0,\n      hi = loop.cum.length - 1;\n    while (hi - lo > 1) {\n      const mid = (lo + hi) >> 1;\n      if (loop.cum[mid] <= s) lo = mid;\n      else hi = mid;\n    }\n    const a = loop.pts[lo],\n      b = loop.pts[(lo + 1) % loop.pts.length];\n    const t = (s - loop.cum[lo]) / Math.max(1e-6, loop.cum[lo + 1] - loop.cum[lo]);\n    return [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, b[0] - a[0], b[1] - a[1], b[2] - a[2]];\n  };\n  function place(dt) {\n    for (let c = 0; c < N; c++) {\n      const car = cars[c];\n      car.s = (car.s + car.v * dt) % car.loop.len;\n      // look a little ahead so cars turn smoothly through the roundabout\n      const [x, y, z] = pointAt(car.loop, car.s);\n      const [x2, y2, z2] = pointAt(car.loop, (car.s + 0.12) % car.loop.len);\n      const dx = x2 - x,\n        dz2 = z2 - z,\n        hl = Math.hypot(dx, dz2) || 1;\n      eu.set(0, Math.atan2(-dz2, dx), Math.atan2(y2 - y, hl), \"YZX\");\n      q.setFromEuler(eu);\n      sc3.setScalar(1);\n      bodies.setMatrixAt(c, m4.compose(v3.set(x, y + 0.035, z), q, sc3));\n      cabs.setMatrixAt(c, m4.compose(v3.set(x - (dx / hl) * 0.01, y + 0.08, z - (dz2 / hl) * 0.01), q, sc3));\n    }\n    bodies.instanceMatrix.needsUpdate = true;\n    cabs.instanceMatrix.needsUpdate = true;\n  }\n  place(0);\n  group.traverse((o) => {\n    if (o.isMesh && !o.isInstancedMesh) o.castShadow = false; // the deck: no dark strip over the islands\n  });\n  bodies.castShadow = cabs.castShadow = false;\n  if (!debug) {\n    scene.add(group);\n    scene.add(hubGroup);\n  }\n\n  // ---------- fading ----------\n  let opacity = 1;\n  function setOpacity(o) {\n    const solid = o > 0.995;\n    for (const m of mats) {\n      if (m.transparent === solid) {\n        m.transparent = !solid; // depth writes stay on: only the nearest surface of the ghost shows\n        m.needsUpdate = true;\n      }\n      m.opacity = solid ? 1 : o;\n    }\n    group.visible = o > 0.02;\n    for (const o2 of group.children) o2.renderOrder = solid ? 0 : 5;\n  }\n  const GHOST = 0.14;\n\n  return {\n    z: Z,\n    y: Y,\n    span: [X0, X1],\n    hubs: hubs.map((h) => ({ x: +h.x.toFixed(2), z: +h.z.toFixed(2), ramp: +h.ramp.L.toFixed(2), fallback: !!h.ramp.fallback, blocked: h.ramp.L < 4.2 ? h.blocked : undefined })),\n    cleared,\n    piers,\n    portals: portals.map((p) => +p.mx.toFixed(2)),\n    bandIds,\n    // QA: run the traffic for one long cycle without drawing; closest gap between any two cars, and the sharpest turn per 0.05 of travel\n    trafficCheck(dt = 0.02, steps = 1500) {\n      const s0 = cars.map((c) => c.s);\n      const box = (c) => {\n        const [x, , z] = pointAt(c.loop, c.s),\n          [x2, , z2] = pointAt(c.loop, (c.s + 0.12) % c.loop.len);\n        const l = Math.hypot(x2 - x, z2 - z) || 1;\n        return { x, z, ux: (x2 - x) / l, uz: (z2 - z) / l };\n      };\n      // separating-axis test for two 0.17 × 0.085 car footprints; returns the clearance (negative = overlapping)\n      const clear = (A, B) => {\n        let best = -Infinity;\n        for (const [ax, az] of [[A.ux, A.uz], [-A.uz, A.ux], [B.ux, B.uz], [-B.uz, B.ux]]) {\n          const half = (C) => 0.085 * Math.abs(C.ux * ax + C.uz * az) + 0.0425 * Math.abs(-C.uz * ax + C.ux * az);\n          best = Math.max(best, Math.abs((B.x - A.x) * ax + (B.z - A.z) * az) - half(A) - half(B));\n        }\n        return best;\n      };\n      let gap = Infinity,\n        turn = 0;\n      for (let k = 0; k < steps; k++) {\n        cars.forEach((c) => (c.s = (c.s + c.v * dt) % c.loop.len));\n        const b = cars.map(box);\n        for (let i = 0; i < N; i++) for (let j = i + 1; j < N; j++) gap = Math.min(gap, clear(b[i], b[j]));\n      }\n      for (const loop of loops)\n        for (let s = 0; s < loop.len; s += 0.05) {\n          const a = pointAt(loop, s),\n            b = pointAt(loop, (s + 0.05) % loop.len);\n          const d = Math.atan2(b[5], b[3]) - Math.atan2(a[5], a[3]);\n          turn = Math.max(turn, Math.abs(Math.atan2(Math.sin(d), Math.cos(d))));\n        }\n      cars.forEach((c, i) => (c.s = s0[i]));\n      // gap: the smallest clearance between any two cars over the run; turnDeg: the sharpest change of heading in 0.05 of travel\n      return { gap: +gap.toFixed(3), turnDeg: +((turn * 180) / Math.PI).toFixed(1), lens: loops.map((l) => +l.len.toFixed(2)) };\n    },\n    deckTop,\n    zc,\n    get opacity() {\n      return opacity;\n    },\n    // carDt moves the cars (0 while paused); fadeDt eases the ghost in and out (0 = at once, for reduced motion).\n    // ghost: true while the viewer is looking at something the road would hide. Returns true when a redraw is needed.\n    update(carDt, fadeDt, night, ghost) {\n      if (carDt > 0) place(carDt);\n      cabMat.emissiveIntensity = night * 0.8;\n      LAMP.emissiveIntensity = night * 1.6;\n      const target = ghost ? GHOST : 1;\n      if (opacity === target) return carDt > 0;\n      const next = fadeDt > 0 ? opacity + (target - opacity) * Math.min(1, fadeDt * 6) : target;\n      opacity = Math.abs(next - target) < 0.01 ? target : next;\n      setOpacity(opacity);\n      return true;\n    },\n    // is the pointer over the road? (a mouse resting on the road shows what is under it)\n    hit(ray) {\n      deckMesh.visible = true;\n      const h = ray.intersectObject(deckMesh, false).length > 0;\n      deckMesh.visible = false;\n      return h;\n    },\n    // 2026-11-12: what a click or tap on 市民大道 lands on — the deck (while it is drawn solid or hovered) or one of the\n    // two hub islands — with its distance along the ray, so the caller can let anything nearer win\n    hitRoad(ray) {\n      deckMesh.visible = true;\n      const d = ray.intersectObject(deckMesh, false)[0];\n      deckMesh.visible = false;\n      if (d) return { kind: \"deck\", dist: d.distance };\n      const o = ray.ray.origin,\n        v = ray.ray.direction;\n      if (Math.abs(v.y) < 1e-6) return null;\n      const t = (LAND_Y + 0.02 - o.y) / v.y;\n      if (t <= 0) return null;\n      const x = o.x + v.x * t,\n        z = o.z + v.z * t;\n      return hubs.some((h) => hexOutside(x, z, { x: h.x, z: h.z }, R) < 0) ? { kind: \"hub\", dist: t } : null;\n    },\n    noGhost: false, // review screenshots only\n    // the camera is looking at something under or right next to the road (the hub islands have nothing to hide)\n    shouldGhost(selectedIsland, target, camDist) {\n      if (this.noGhost) return false;\n      if (selectedIsland && bandIds.has(selectedIsland)) return true;\n      return camDist < 17 && Math.abs(target.z - Z) < 3.6 && target.x > hw.x + 1.2 && target.x < he.x - 1.2;\n    },\n  };\n}\n"
