            "size": 43444,
            "mimeType": "application/javascript",
            "text": "// Island bodies, ground materials, bridges, pedestrian graph and building layout.\n// Decorative geometry adds no policy, location or schedule claim.\nimport { mergeGeometries } from \"three/addons/utils/BufferGeometryUtils.js\";\nimport { WATER_Y, mulberry } from \"./environment.js?v=20261026-1\";\n\nexport const R = 2.02; // hex circumradius (pointy-top, vertex toward ±z)\nexport const SPACING = 2.28;\nexport const TOP = 0.65;\nexport const RING_R = 1.8; // pedestrian walking line (circumradius)\nexport const INNER = 1.4; // building zone inradius\nconst SQ3 = Math.sqrt(3);\nexport const NEIGHBORS = [\n  [1, 0],\n  [-1, 0],\n  [0, 1],\n  [0, -1],\n  [1, -1],\n  [-1, 1],\n];\n\n// Ground style per policy theme (decorative surface only)\nconst BRIDGE_PRIORITY = [\"civil\", \"forest\", \"institute\", \"lunch\", \"family\", \"youth\", \"card\", \"welfare\", \"trails\", \"transport\", \"sport\", \"education\", \"renewal\", \"newcomer\", \"indigenous\", \"hakka\", \"water\", \"ai\", \"diplomacy\"];\nconst BRIDGE_STYLE = {\n  default: { deck: [0xb48560, 0xa77a55], post: 0xfff8f4, handrail: 0x9a7454, arch: 0.09 },\n  civil: { deck: [0xd6cbb8, 0xcabfab], post: 0xe6dccb, handrail: 0xe6dccb, arch: 0.07, rail: \"wall\" },\n  trails: { deck: [0xb7a993, 0xa89a84], post: 0x9c8a7a, handrail: 0x9c8a7a, arch: 0.1, rail: \"wall\" },\n  institute: { deck: [0xf2f4f3, 0xe3ebea], post: 0x3e7c8c, handrail: 0xbfe0e2, arch: 0.05, rail: \"glass\" },\n  transport: { deck: [0x6d6a66, 0x5f5c58], post: 0xe8c547, handrail: 0xe8c547, arch: 0.04 },\n  forest: { deck: [0x8a6a4e, 0x7a5c42], post: 0x7a5c42, handrail: 0x6b5038, arch: 0.06, log: true },\n  lunch: { deck: [0xc9b27a, 0xb89f68], post: 0x9c7a4e, handrail: 0x9c7a4e, arch: 0.06, log: true },\n  family: { deck: [0xc9dbe6, 0xb9cfdd], post: 0xffffff, handrail: 0xf2b5c6, arch: 0.08, rail: \"planter\" },\n  welfare: { deck: [0xb48560, 0xa77a55], post: 0xffffff, handrail: 0x8db86f, arch: 0.08, rail: \"planter\" },\n  youth: { deck: [0xdb6a41, 0xf3e2c6], post: 0x211d1d, handrail: 0xe8b04a, arch: 0.1 },\n  card: { deck: [0xd4a07e, 0xe6c3a5], post: 0xfff8f4, handrail: 0xdb6a41, arch: 0.09 },\n  hakka: { deck: [0xc77b5c, 0xb86e52], post: 0xf2e8d8, handrail: 0x3f5a8a, arch: 0.08, rail: \"wall\" },\n  water: { deck: [0x9fb8b4, 0x8faaa6], post: 0xfff8f4, handrail: 0x3e7c8c, arch: 0.11, rail: \"glass\" },\n  ai: { deck: [0xe9ecea, 0xdbe2e0], post: 0x2f5a6a, handrail: 0x5f9aa6, arch: 0.05, rail: \"glass\" },\n  renewal: { deck: [0xc7b08f, 0xb89f80], post: 0xf2efe8, handrail: 0xdb6a41, arch: 0.07 },\n  newcomer: { deck: [0xc98a6c, 0xb97d61], post: 0xf6efe3, handrail: 0x58a6a6, arch: 0.08, rail: \"planter\" },\n  indigenous: { deck: [0x9c7a54, 0x8a6b48], post: 0x6e5a44, handrail: 0x8a6b48, arch: 0.08, log: true },\n};\nexport const GROUND = {\n  civil: \"granite\",\n  institute: \"lawn\",\n  renewal: \"gravel\",\n  transport: \"street\",\n  education: \"schoolyard\",\n  lunch: \"farmland\",\n  family: \"softpad\",\n  card: \"terracotta\",\n  welfare: \"garden\",\n  sport: \"meadow\",\n  trails: \"meadow\",\n  forest: \"forest\",\n  youth: \"rubber\",\n  diplomacy: \"boardwalk\",\n  hakka: \"courtyard\",\n  water: \"wetland\",\n  ai: \"techpad\",\n  newcomer: \"lane\",\n  indigenous: \"meadow\",\n};\nconst GROUND_TONE = {\n  granite: 0xd9cbb4,\n  lawn: 0xb9cd98,\n  gravel: 0xc7b08f,\n  street: 0xcfc3b2,\n  meadow: 0xbccf9c,\n  terracotta: 0xdcb79a,\n  garden: 0xb4c993,\n  forest: 0x9fb683,\n  rubber: 0xe2a46f,\n  boardwalk: 0xc9a27c,\n  ringtile: 0xf4f1ec,\n  schoolyard: 0xc9785a,\n  farmland: 0xa9b878,\n  softpad: 0xb9d6e6,\n  courtyard: 0xd9b08c,\n  wetland: 0xb3cfa4,\n  techpad: 0xc9d3cf,\n  lane: 0xe6d6c6,\n};\n\nconst SHALLOW_TONE = { hakka: 0xb9c6d6, civil: 0xb9d9d6, institute: 0xa9d6e0, renewal: 0xc9c4a8, transport: 0x9fc7cf, education: 0xd8d4a4, lunch: 0xb6caa0, family: 0xd9cfc6, card: 0xd9c3a8, welfare: 0xa9cfa8, sport: 0x9fcfbf, trails: 0xb4b8a8, forest: 0x8fb89a, youth: 0xbfd0e6, diplomacy: 0x8fc0d6, water: 0x8ec9d4, ai: 0xb6d4dc, newcomer: 0xc9c9b4, indigenous: 0xa9c9a4 };\n// Walking-ring paving and cliff strata per island (decorative identity only)\nexport const RING_TINT = {\n  civil: 0xe3d3b8,\n  institute: 0xbfd6df,\n  renewal: 0xc9b89a,\n  transport: 0xb9b3ab,\n  education: 0xf1dc9a,\n  lunch: 0xcdb08a,\n  family: 0xf2d2d6,\n  card: 0xe6b796,\n  welfare: 0xdfe6cf,\n  sport: 0xd9866a,\n  trails: 0xc8bba4,\n  forest: 0xa98e6c,\n  youth: 0x8fc6c4,\n  diplomacy: 0xc9a27c,\n  hakka: 0xe6cfb0,\n  water: 0xcfe3dc,\n  ai: 0xd5e2e4,\n  newcomer: 0xe9d6c4,\n  indigenous: 0xd2bc98,\n};\nconst CLIFF = {\n  default: [0xb98c68, 0xa77b59, 0x977059, 0x8f8172],\n  civil: [0xcbbfae, 0xb9ab97, 0xa89a86, 0x928676],\n  institute: [0xbfc8c2, 0xaab5ae, 0x98a39d, 0x86908a],\n  trails: [0xa59a8a, 0x8f8576, 0x7d7466, 0x6c6458],\n  forest: [0x7d8a5a, 0x8a6e52, 0x775f48, 0x6a5747],\n  youth: [0xe0a77c, 0xd59670, 0xc98a66, 0xb37a5c],\n  diplomacy: [0x9a7a5a, 0x8a6b4e, 0x7a5d44, 0x6a5040],\n  sport: [0xb79572, 0xa9845f, 0x9a7655, 0x8a6a4e],\n  education: [0xc77b5c, 0xb86e52, 0xa86449, 0x8f7564],\n  lunch: [0x7a5a42, 0x6c4f3a, 0x5f4533, 0x7d7064],\n  family: [0xe7c9b8, 0xdcb8a6, 0xcfa996, 0xa89484],\n  card: [0xd08a64, 0xc27c58, 0xb26f4f, 0x9a7a66],\n  welfare: [0x8d9b6a, 0x9a7e5e, 0x8a6f52, 0x7d7468],\n  transport: [0xa7a29b, 0x96918a, 0x86817a, 0x77736d],\n  renewal: [0xb8a07e, 0xa58d6c, 0x93805f, 0x857766],\n  hakka: [0xc77b5c, 0xb46c50, 0xa05f47, 0x8c7466],\n  water: [0x8fa38c, 0x7d927c, 0x6f8470, 0x7d7468],\n  ai: [0xc4ccca, 0xb2bcba, 0xa1aba9, 0x8f9896],\n  newcomer: [0xc98a6c, 0xb67b5f, 0xa26e55, 0x8c7466],\n  indigenous: [0x8f7a5c, 0x806c50, 0x6f5e46, 0x625446],\n};\nexport function axialToWorld(THREE, q, r) {\n  return new THREE.Vector3(SQ3 * SPACING * (q + r / 2) - 2, TOP, 1.5 * SPACING * r - 10.26);\n}\n// unit direction (xz) from axial neighbour delta\nexport function dirOf(dq, dr) {\n  const x = SQ3 * (dq + dr / 2),\n    z = 1.5 * dr;\n  const l = Math.hypot(x, z);\n  return [x / l, z / l];\n}\n// pointy-top hex vertices (angle 90° = +z)\nexport function hexVertex(cx, cz, r, k) {\n  const a = Math.PI / 2 + (k * Math.PI) / 3;\n  return [cx + Math.cos(a) * r, cz + Math.sin(a) * r];\n}\n// is local point (x,z) inside pointy-top hex with inradius ri\nexport function insideHex(x, z, ri) {\n  const ax = Math.abs(x),\n    az = Math.abs(z);\n  return ax <= ri && ax * 0.5 + az * 0.8660254 <= ri;\n}\n\n// 2026-11-12: islands in the same `group` (族群與語言) are one landmass: the channel between two of them is land, not a\n// footbridge. joinedEdges gives, per island, the hex edges (0–5, edge k runs from vertex k to k+1) that face a groupmate.\nexport function sameGroup(D, a, b) {\n  const ga = D.islands.find((i) => i.id === a)?.group;\n  return !!ga && ga === D.islands.find((i) => i.id === b)?.group;\n}\nexport function edgeToward(dq, dr) {\n  const [x, z] = dirOf(dq, dr);\n  const a = (Math.atan2(z, x) * 180) / Math.PI; // edge k's outward normal points at 120° + 60k\n  return (((Math.round((a - 120) / 60) % 6) + 6) % 6);\n}\n// the land pieces that fill the channels of a group: one quad per joined pair, one triangle where three meet\nexport function groupLand(THREE, D, centers) {\n  const pieces = [];\n  const byAxial = new Map(D.islands.map((i) => [i.axial.join(\",\"), i]));\n  const near = (id, g) => {\n    const c = centers.get(id);\n    let best = null;\n    for (let k = 0; k < 6; k++) {\n      const v = hexVertex(c.x, c.z, R, k);\n      if (!best || Math.hypot(v[0] - g[0], v[1] - g[1]) < Math.hypot(best[0] - g[0], best[1] - g[1])) best = v;\n    }\n    return best;\n  };\n  for (const i of D.islands) {\n    if (!i.group) continue;\n    for (const [dq, dr] of NEIGHBORS) {\n      const j = byAxial.get([i.axial[0] + dq, i.axial[1] + dr].join(\",\"));\n      if (!j || j.group !== i.group || j.id < i.id) continue;\n      const a = centers.get(i.id),\n        b = centers.get(j.id);\n      const ea = edgeToward(dq, dr),\n        eb = (ea + 3) % 6;\n      pieces.push({ kind: \"join\", ids: [i.id, j.id], pts: [hexVertex(a.x, a.z, R, ea), hexVertex(a.x, a.z, R, ea + 1), hexVertex(b.x, b.z, R, eb), hexVertex(b.x, b.z, R, eb + 1)] });\n      // a third groupmate next to both closes a triangle of water between the three corners\n      for (const [eq, er] of NEIGHBORS) {\n        const k = byAxial.get([i.axial[0] + eq, i.axial[1] + er].join(\",\"));\n        if (!k || k.group !== i.group || k.id <= j.id) continue;\n        const adj = NEIGHBORS.some(([fq, fr]) => j.axial[0] + fq === k.axial[0] && j.axial[1] + fr === k.axial[1]);\n        if (!adj) continue;\n        const ck = centers.get(k.id);\n        const g = [(a.x + b.x + ck.x) / 3, (a.z + b.z + ck.z) / 3];\n        pieces.push({ kind: \"corner\", ids: [i.id, j.id, k.id], pts: [near(i.id, g), near(j.id, g), near(k.id, g)] });\n      }\n    }\n  }\n  // counter-clockwise (seen from above, +y up: x right, z toward the viewer) so the caps face up\n  for (const p of pieces) {\n    const area = p.pts.reduce((s, q, n) => s + (q[0] * p.pts[(n + 1) % p.pts.length][1] - p.pts[(n + 1) % p.pts.length][0] * q[1]), 0);\n    if (area > 0) p.pts.reverse();\n  }\n  return pieces;\n}\nexport function insidePoly(x, z, pts, pad = 0) {\n  // convex polygon test with an outward pad\n  const n = pts.length;\n  let sign = 0;\n  for (let k = 0; k < n; k++) {\n    const [ax, az] = pts[k],\n      [bx, bz] = pts[(k + 1) % n];\n    const ex = bx - ax,\n      ez = bz - az,\n      l = Math.hypot(ex, ez);\n    const cr = (ex * (z - az) - ez * (x - ax)) / l;\n    if (!sign) sign = Math.sign(pts.reduce((s, q, m) => s + (q[0] * pts[(m + 1) % n][1] - pts[(m + 1) % n][0] * q[1]), 0)) || 1;\n    if (cr * sign < -pad) return false;\n  }\n  return true;\n}\n\nfunction makeTexture(THREE, type) {\n  const c = document.createElement(\"canvas\");\n  c.width = c.height = 256;\n  const g = c.getContext(\"2d\");\n  const rnd = mulberry(type.length * 97 + 3);\n  const tone = \"#\" + GROUND_TONE[type].toString(16).padStart(6, \"0\");\n  g.fillStyle = tone;\n  g.fillRect(0, 0, 256, 256);\n  const speck = (n, cols, rmin, rmax, a = 1) => {\n    for (let i = 0; i < n; i++) {\n      g.globalAlpha = a * (0.4 + rnd() * 0.6);\n      g.fillStyle = cols[Math.floor(rnd() * cols.length)];\n      g.beginPath();\n      g.arc(rnd() * 256, rnd() * 256, rmin + rnd() * (rmax - rmin), 0, Math.PI * 2);\n      g.fill();\n    }\n    g.globalAlpha = 1;\n  };\n  const tiles = (sz, grout, jitter, cols) => {\n    for (let y = 0; y < 256; y += sz)\n      for (let x = 0; x < 256; x += sz) {\n        g.fillStyle = cols[Math.floor(rnd() * cols.length)];\n        g.fillRect(x + 1, y + 1, sz - 2, sz - 2);\n        g.globalAlpha = jitter;\n        g.fillStyle = rnd() > 0.5 ? \"#ffffff\" : \"#000000\";\n        g.fillRect(x + 1, y + 1, sz - 2, sz - 2);\n        g.globalAlpha = 1;\n      }\n    g.strokeStyle = grout;\n    g.lineWidth = 2;\n    for (let i = 0; i <= 256; i += sz) {\n      g.beginPath();\n      g.moveTo(i, 0);\n      g.lineTo(i, 256);\n      g.moveTo(0, i);\n      g.lineTo(256, i);\n      g.stroke();\n    }\n  };\n  switch (type) {\n    case \"granite\":\n      tiles(32, \"#bfae95\", 0.04, [\"#dccfb8\", \"#d6c7ae\", \"#e0d3bd\", \"#d2c2a7\"]);\n      speck(400, [\"#b8a68b\", \"#efe4d2\"], 0.4, 1.1, 0.5);\n      break;\n    case \"street\":\n      tiles(21, \"#b3a796\", 0.03, [\"#d0c4b3\", \"#c8bba8\", \"#d6cbbb\"]);\n      break;\n    case \"schoolyard\":\n      g.fillStyle = \"#c9785a\";\n      g.fillRect(0, 0, 256, 256);\n      g.strokeStyle = \"#f6eee6\";\n      g.lineWidth = 3;\n      for (let y = 16; y < 256; y += 32) {\n        g.beginPath();\n        g.moveTo(0, y);\n        g.lineTo(256, y);\n        g.stroke();\n      }\n      speck(900, [\"#b86c50\", \"#d68a6a\"], 0.4, 1.0, 0.6);\n      break;\n    case \"farmland\":\n      for (let y = 0; y < 256; y += 16) {\n        g.fillStyle = (y / 16) % 2 ? \"#9c7a5a\" : \"#a9c47f\";\n        g.fillRect(0, y, 256, 16);\n      }\n      speck(600, [\"#8fb37a\", \"#7f9a6a\"], 0.6, 1.6, 0.7);\n      break;\n    case \"softpad\":\n      for (let y = 0; y < 256; y += 32)\n        for (let x = 0; x < 256; x += 32) {\n          g.fillStyle = [\"#b9d6e6\", \"#f2c4d0\", \"#f6e3a6\", \"#c4e2c4\"][((x + y) / 32) % 4];\n          g.fillRect(x + 1, y + 1, 30, 30);\n        }\n      break;\n    case \"ringtile\":\n      tiles(18, \"#c9c2b8\", 0.035, [\"#f6f3ee\", \"#efebe4\", \"#faf8f4\"]);\n      break;\n    case \"terracotta\":\n      tiles(26, \"#b98d6f\", 0.05, [\"#dcb79a\", \"#d4ab8c\", \"#e1c0a4\"]);\n      break;\n    case \"boardwalk\":\n      for (let y = 0; y < 256; y += 16) {\n        g.fillStyle = [\"#c9a27c\", \"#bf9771\", \"#d1ab86\"][Math.floor(rnd() * 3)];\n        g.fillRect(0, y + 1, 256, 14);\n        g.fillStyle = \"#a9805e\";\n        for (let x = (y * 7) % 64; x < 256; x += 64) g.fillRect(x, y + 1, 2, 14);\n      }\n      break;\n    case \"rubber\":\n      g.fillStyle = \"#e2a46f\";\n      g.fillRect(0, 0, 256, 256);\n      g.fillStyle = \"#e8c06a\";\n      g.fillRect(0, 0, 128, 128);\n      g.fillRect(128, 128, 128, 128);\n      speck(1800, [\"#c98a59\", \"#f1c48f\", \"#d9965f\"], 0.5, 1.3, 0.6);\n      break;\n    case \"wetland\": {\n      // reed-fringed marsh: soft green ground, small blue pools and reed tufts (decorative)\n      speck(2400, [\"#a3c296\", \"#c2d8b1\", \"#93b489\"], 0.4, 1.3, 0.55);\n      for (let i = 0; i < 9; i++) {\n        const x = rnd() * 256, y = rnd() * 256;\n        g.fillStyle = \"#8ec9d4\";\n        g.beginPath();\n        g.ellipse(x, y, 10 + rnd() * 14, 6 + rnd() * 8, rnd() * Math.PI, 0, Math.PI * 2);\n        g.fill();\n        g.fillStyle = \"#c9e6ea\";\n        g.beginPath();\n        g.ellipse(x - 3, y - 2, 4 + rnd() * 4, 2 + rnd() * 2, 0, 0, Math.PI * 2);\n        g.fill();\n      }\n      speck(260, [\"#6f8a5a\", \"#5e7a4c\"], 0.6, 1.4, 0.8);\n      break;\n    }\n    case \"techpad\":\n      // pale paving with thin circuit traces (decorative)\n      tiles(32, \"#b3bfbb\", 0.03, [\"#cdd6d2\", \"#c6d0cc\", \"#d3dbd8\"]);\n      g.strokeStyle = \"#7fb2bb\";\n      g.globalAlpha = 0.55;\n      g.lineWidth = 1.5;\n      for (let i = 0; i < 10; i++) {\n        let x = Math.round(rnd() * 8) * 32 + 16, y = Math.round(rnd() * 8) * 32 + 16;\n        g.beginPath();\n        g.moveTo(x, y);\n        for (let k = 0; k < 3; k++) {\n          if (k % 2) y += (rnd() > 0.5 ? 1 : -1) * 32;\n          else x += (rnd() > 0.5 ? 1 : -1) * 32;\n          g.lineTo(x, y);\n        }\n        g.stroke();\n        g.fillStyle = \"#5f9aa6\";\n        g.fillRect(x - 2, y - 2, 4, 4);\n      }\n      g.globalAlpha = 1;\n      break;\n    case \"lane\":\n      // 巷弄 paving: warm brick courses with lighter cement joints (decorative)\n      for (let y = 0; y < 256; y += 8)\n        for (let x = (y / 8) % 2 ? -8 : 0; x < 256; x += 16) {\n          g.fillStyle = [\"#dcb8a0\", \"#d2aa90\", \"#e2c4ae\", \"#cfa58a\"][Math.floor(rnd() * 4)];\n          g.fillRect(x + 1, y + 1, 14, 6);\n        }\n      speck(500, [\"#c4977b\", \"#ecd6c4\"], 0.4, 1.0, 0.5);\n      break;\n    case \"gravel\":\n      speck(2600, [\"#b29a78\", \"#d8c4a3\", \"#a68c6c\", \"#c9b392\"], 0.5, 1.6, 0.8);\n      break;\n    default: {\n      // grasses\n      const deep = type === \"forest\" ? [\"#8ea873\", \"#a9bf8e\", \"#7e9866\"] : [\"#a9bf8e\", \"#c7d7a8\", \"#9fb684\", \"#b5c995\"];\n      speck(3200, deep, 0.4, 1.4, 0.55);\n      if (type !== \"forest\") speck(70, [\"#f3e7a6\", \"#ffffff\", \"#f2c4b2\", \"#d9c6f0\"], 0.9, 1.6, 0.85);\n    }\n  }\n  const t = new THREE.CanvasTexture(c);\n  t.colorSpace = THREE.SRGBColorSpace;\n  t.wrapS = t.wrapT = THREE.RepeatWrapping;\n  t.anisotropy = 4;\n  return t;\n}\n\n// Rocky hex sides with soil strata, built per edge with noise displacement.\nfunction cliffGeometry(THREE, cx, cz, r, yTop, yBot, grassTone, seed, id, skip = null) {\n  const edges = [];\n  for (let e = 0; e < 6; e++) if (!skip || !skip.has(e)) edges.push([...hexVertex(cx, cz, r, e), ...hexVertex(cx, cz, r, e + 1)]);\n  return wallGeometry(THREE, edges, cx, cz, yTop, yBot, grassTone, seed, id);\n}\n// vertical water-tinted skirt along a list of [ax, az, bx, bz] edges (an island side, or the open ends of a land join)\nfunction wallGeometry(THREE, edges, cx, cz, yTop, yBot, grassTone, seed, id) {\n  const segH = 8,\n    segV = 7;\n  const posA = [],\n    colA = [],\n    idx = [];\n  const rnd = mulberry(seed);\n  const grass = new THREE.Color(grassTone).offsetHSL(0, -0.05, -0.1);\n  // plinth tones derived from the island's own ground colour, fading into the water at the bottom,\n  // so the island side never reads as a brown soil wall (from any angle)\n  const g0 = new THREE.Color(grassTone);\n  const shallowTone = new THREE.Color(SHALLOW_TONE[id] || 0xb9d9d6);\n  const waterTone = new THREE.Color(0x9fcfd6);\n  const soilA = g0.clone().lerp(new THREE.Color(0xf4efe6), 0.35),\n    soilB = g0.clone().lerp(new THREE.Color(0xf4efe6), 0.2),\n    soilC = g0.clone().lerp(waterTone, 0.45),\n    rock = waterTone.clone().offsetHSL(0, -0.05, -0.04);\n  const jit = (x, z, y) => Math.sin(x * 7.1 + z * 3.3 + y * 5.7) * 0.5 + Math.sin(x * 2.3 - z * 6.1 + y * 9.1) * 0.5;\n  for (const [ax, az, bx, bz] of edges) {\n    const nx = (ax + bx) / 2 - cx,\n      nz = (az + bz) / 2 - cz,\n      nl = Math.hypot(nx, nz);\n    const base = posA.length / 3;\n    for (let v = 0; v <= segV; v++) {\n      const t = v / segV; // 0 top .. 1 bottom\n      const y = yTop + (yBot - yTop) * t;\n      const shrink = 1; // vertical skirt: no visible taper wedge\n      for (let h = 0; h <= segH; h++) {\n        const s = h / segH;\n        let x = cx + (ax + (bx - ax) * s - cx) * shrink,\n          z = cz + (az + (bz - az) * s - cz) * shrink;\n        const out = 0;\n        x += (nx / nl) * out;\n        z += (nz / nl) * out;\n        posA.push(x, y, z);\n        // the island's side reads as clear shallow water, not as a wall: tint from the island's shallow-water\n        // colour at the top to the open-water colour below the surface\n        const c = shallowTone.clone().lerp(waterTone, Math.min(1, t * 1.4));\n        colA.push(c.r, c.g, c.b);\n      }\n    }\n    for (let v = 0; v < segV; v++)\n      for (let h = 0; h < segH; h++) {\n        const a = base + v * (segH + 1) + h,\n          b = a + 1,\n          c = a + segH + 1,\n          d = c + 1;\n        idx.push(a, c, b, b, c, d);\n      }\n  }\n  const g = new THREE.BufferGeometry();\n  g.setAttribute(\"position\", new THREE.Float32BufferAttribute(posA, 3));\n  g.setAttribute(\"color\", new THREE.Float32BufferAttribute(colA, 3));\n  g.setIndex(idx);\n  g.computeVertexNormals();\n  return g;\n}\n\nfunction hexRingGeometry(THREE, rOut, rIn) {\n  const s = new THREE.Shape(),\n    h = new THREE.Path();\n  for (let k = 0; k < 6; k++) {\n    const [x, z] = hexVertex(0, 0, rOut, k);\n    k ? s.lineTo(x, -z) : s.moveTo(x, -z);\n    const [x2, z2] = hexVertex(0, 0, rIn, k);\n    k ? h.lineTo(x2, -z2) : h.moveTo(x2, -z2);\n  }\n  s.closePath();\n  h.closePath();\n  s.holes.push(h);\n  const g = new THREE.ShapeGeometry(s);\n  g.rotateX(-Math.PI / 2);\n  return g;\n}\n\n// Cliff-top band pattern per island: the island's \"edge identity\" seen in every close-up.\nconst BAND = {\n  civil: [\"blocks\", \"#d8ccb8\", \"#bfae95\"],\n  institute: [\"glass\", \"#9fc4c6\", \"#e6f0ef\"],\n  renewal: [\"hoarding\", \"#db6a41\", \"#f2efe8\"],\n  transport: [\"hazard\", \"#e8c547\", \"#3b3a42\"],\n  education: [\"mural\", \"#e8c547\", \"#58a6a6\"],\n  lunch: [\"soil\", \"#6c4f3a\", \"#8fb37a\"],\n  family: [\"pastel\", \"#f2b5c6\", \"#9fc4e6\"],\n  card: [\"tiles\", \"#d08a64\", \"#f2d0b4\"],\n  welfare: [\"ivy\", \"#8db86f\", \"#b4c993\"],\n  sport: [\"stripe\", \"#c8775a\", \"#ffffff\"],\n  trails: [\"rubble\", \"#a59a8a\", \"#c8bba4\"],\n  forest: [\"moss\", \"#6f8a62\", \"#9cc27a\"],\n  youth: [\"graffiti\", \"#e7a383\", \"#58a6a6\"],\n  diplomacy: [\"timber\", \"#9a7a5a\", \"#c9a27c\"],\n  hakka: [\"blocks\", \"#c77b5c\", \"#e9d8c0\"],\n  water: [\"moss\", \"#5f9aa6\", \"#9fd0d6\"],\n  ai: [\"glass\", \"#7fb2bb\", \"#eef3f2\"],\n  newcomer: [\"tiles\", \"#c98a6c\", \"#f2e2d0\"],\n  indigenous: [\"weave\", \"#b8323a\", \"#f2e6d8\"],\n};\nfunction bandTexture(THREE, id) {\n  const [kind, a, b] = BAND[id] || [\"blocks\", \"#c8b8a0\", \"#b0a088\"];\n  const c = document.createElement(\"canvas\");\n  c.width = 512;\n  c.height = 64;\n  const g = c.getContext(\"2d\");\n  const rnd = mulberry(id.length * 31 + 7);\n  g.fillStyle = a;\n  g.fillRect(0, 0, 512, 64);\n  switch (kind) {\n    case \"blocks\":\n    case \"tiles\":\n      for (let y = 0; y < 64; y += 21)\n        for (let x = (y / 21) % 2 ? -18 : 0; x < 512; x += 36) {\n          g.fillStyle = rnd() < 0.5 ? a : b;\n          g.fillRect(x + 1, y + 1, 34, 19);\n        }\n      break;\n    case \"glass\":\n      for (let x = 0; x < 512; x += 32) {\n        g.fillStyle = b;\n        g.fillRect(x + 2, 6, 26, 52);\n        g.fillStyle = \"#3e7c8c\";\n        g.fillRect(x, 0, 2, 64);\n      }\n      break;\n    case \"hoarding\":\n    case \"stripe\":\n      for (let x = 0; x < 512; x += 32) {\n        g.fillStyle = (x / 32) % 2 ? a : b;\n        g.fillRect(x, 0, 32, 64);\n      }\n      break;\n    case \"hazard\":\n      g.fillStyle = b;\n      for (let x = -64; x < 576; x += 32) {\n        g.beginPath();\n        g.moveTo(x, 64);\n        g.lineTo(x + 16, 64);\n        g.lineTo(x + 48, 0);\n        g.lineTo(x + 32, 0);\n        g.fill();\n      }\n      break;\n    case \"mural\":\n    case \"graffiti\":\n    case \"pastel\":\n      for (let k = 0; k < 40; k++) {\n        g.fillStyle = [a, b, \"#fcea8b\", \"#db6a41\", \"#ffffff\", \"#6f7fb5\"][k % 6];\n        g.beginPath();\n        g.arc(rnd() * 512, rnd() * 64, 6 + rnd() * 14, 0, Math.PI * 2);\n        g.fill();\n      }\n      break;\n    case \"soil\":\n    case \"ivy\":\n    case \"moss\":\n      for (let x = 0; x < 512; x += 6) {\n        g.fillStyle = b;\n        const h = 10 + rnd() * (kind === \"soil\" ? 14 : 40);\n        g.fillRect(x, 0, 5, h);\n        g.beginPath();\n        g.arc(x + 2.5, h, 3.5, 0, Math.PI * 2);\n        g.fill();\n      }\n      break;\n    case \"rubble\":\n      for (let k = 0; k < 90; k++) {\n        g.fillStyle = rnd() < 0.5 ? a : b;\n        g.beginPath();\n        g.ellipse(rnd() * 512, rnd() * 64, 8 + rnd() * 10, 6 + rnd() * 6, 0, 0, Math.PI * 2);\n        g.fill();\n      }\n      break;\n    case \"weave\":\n      // woven band: rows of diamonds on red with black and white stripes (decorative, no specific group's pattern)\n      g.fillStyle = \"#231c1c\";\n      g.fillRect(0, 6, 512, 5);\n      g.fillRect(0, 53, 512, 5);\n      for (let x = 0; x < 512; x += 32) {\n        g.fillStyle = b;\n        g.beginPath();\n        g.moveTo(x + 16, 16);\n        g.lineTo(x + 30, 32);\n        g.lineTo(x + 16, 48);\n        g.lineTo(x + 2, 32);\n        g.fill();\n        g.fillStyle = \"#231c1c\";\n        g.fillRect(x + 13, 29, 6, 6);\n      }\n      break;\n    case \"timber\":\n      for (let x = 0; x < 512; x += 24) {\n        g.fillStyle = rnd() < 0.5 ? a : b;\n        g.fillRect(x + 1, 0, 22, 64);\n      }\n      break;\n  }\n  const t = new THREE.CanvasTexture(c);\n  t.colorSpace = THREE.SRGBColorSpace;\n  t.wrapS = THREE.RepeatWrapping;\n  t.repeat.set(3, 1);\n  return t;\n}\nexport function buildIslands(THREE, scene, D, kit, colors) {\n  const centers = new Map(),\n    axialMap = new Map(),\n    islandViews = new Map();\n  for (const i of D.islands) {\n    const c = axialToWorld(THREE, ...i.axial);\n    centers.set(i.id, c);\n    axialMap.set(i.axial.join(\",\"), i.id);\n  }\n  const textures = {};\n  const topMats = {};\n  for (const type of new Set(Object.values(GROUND))) {\n    textures[type] = makeTexture(THREE, type);\n    topMats[type] = new THREE.MeshStandardMaterial({ map: textures[type], roughness: 0.92 });\n  }\n  const cliffMat = new THREE.MeshLambertMaterial({ vertexColors: true });\n  const ringMat = new THREE.MeshStandardMaterial({ map: makeTexture(THREE, \"ringtile\"), roughness: 0.9, color: 0xf1e7da, polygonOffset: true, polygonOffsetFactor: -1, polygonOffsetUnits: -2 });\n  const curbMat = new THREE.MeshStandardMaterial({ color: 0xe4d6c3, roughness: 0.8, polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -4 });\n  const foamMat = new THREE.MeshBasicMaterial({ color: 0xf6fbfa, transparent: true, opacity: 0.55, depthWrite: false });\n  const neighbors = new Map();\n  const landMeshes = {};\n  const merged = { ring: [], curb: [], shallow: [], foam: [] };\n  const tinted = (g, hex) => {\n    const col = new THREE.Color(hex), n = g.attributes.position.count, a = new Float32Array(n * 3);\n    for (let k = 0; k < n; k++) a.set([col.r, col.g, col.b], k * 3);\n    g.setAttribute(\"color\", new THREE.BufferAttribute(a, 3));\n    return g;\n  };\n  // edges of each island that face a groupmate (族群與語言): no curb, no band, no cliff there — the land carries on\n  const joined = new Map();\n  for (const i of D.islands) {\n    const set = new Set();\n    for (const [dq, dr] of NEIGHBORS) {\n      const j = axialMap.get([i.axial[0] + dq, i.axial[1] + dr].join(\",\"));\n      if (j && sameGroup(D, i.id, j)) set.add(edgeToward(dq, dr));\n    }\n    joined.set(i.id, set);\n  }\n  // a hex outline as separate edge quads, leaving out the joined edges\n  const hexRingEdges = (rOut, rIn, skip) => {\n    const pos = [];\n    for (let k = 0; k < 6; k++) {\n      if (skip.has(k)) continue;\n      const [ax, az] = hexVertex(0, 0, rOut, k),\n        [bx, bz] = hexVertex(0, 0, rOut, k + 1),\n        [cx2, cz2] = hexVertex(0, 0, rIn, k + 1),\n        [dx2, dz2] = hexVertex(0, 0, rIn, k);\n      pos.push(ax, 0, az, dx2, 0, dz2, bx, 0, bz, bx, 0, bz, dx2, 0, dz2, cx2, 0, cz2);\n    }\n    const g = new THREE.BufferGeometry();\n    g.setAttribute(\"position\", new THREE.Float32BufferAttribute(pos, 3));\n    fixUp(g);\n    g.computeVertexNormals();\n    return g;\n  };\n  // triangles must face up (+y); flip any that came out facing down\n  const fixUp = (g) => {\n    const p = g.attributes.position.array;\n    for (let t = 0; t < p.length; t += 9) {\n      const ux = p[t + 3] - p[t],\n        uz = p[t + 5] - p[t + 2],\n        vx = p[t + 6] - p[t],\n        vz = p[t + 8] - p[t + 2];\n      if (uz * vx - ux * vz < 0)\n        for (let q = 0; q < 3; q++) {\n          const tmp = p[t + 3 + q];\n          p[t + 3 + q] = p[t + 6 + q];\n          p[t + 6 + q] = tmp;\n        }\n    }\n  };\n  for (const i of D.islands) {\n    const c = centers.get(i.id);\n    const type = GROUND[i.id] || \"meadow\";\n    const skip = joined.get(i.id);\n    // top surface with world-space UV (a joined island's top runs right to the hex edge, to meet the land join)\n    const topGeo = new THREE.CircleGeometry(skip.size ? R : R - 0.05, 6);\n    topGeo.rotateZ(Math.PI / 6);\n    topGeo.rotateX(-Math.PI / 2);\n    const uv = topGeo.attributes.uv,\n      p = topGeo.attributes.position;\n    for (let n = 0; n < p.count; n++) uv.setXY(n, (p.getX(n) + c.x) / 2.2, (p.getZ(n) + c.z) / 2.2);\n    const topMesh = new THREE.Mesh(topGeo, topMats[type].clone());\n    topMesh.position.set(c.x, TOP, c.z);\n    topMesh.receiveShadow = true;\n    topMesh.userData = { type: \"island\", id: i.id };\n    scene.add(topMesh);\n    // pedestrian ring paving + curb (2026-10-30: collected here and merged into one mesh each after the loop)\n    merged.ring.push(tinted(hexRingGeometry(THREE, RING_R + 0.14, RING_R - 0.14).translate(c.x, TOP + 0.012, c.z), RING_TINT[i.id] || 0xf1e7da));\n    merged.curb.push((skip.size ? hexRingEdges(R, R - 0.07, skip) : hexRingGeometry(THREE, R, R - 0.07)).translate(c.x, TOP + 0.04, c.z));\n    merged.curb.push(hexRingGeometry(THREE, RING_R - 0.14, RING_R - 0.18).translate(c.x, TOP + 0.02, c.z));\n    // cliffs\n    const cliff = new THREE.Mesh(cliffGeometry(THREE, c.x, c.z, R, TOP + 0.04, WATER_Y - 0.5, GROUND_TONE[type], i.number * 13 + (i.group ? D.islands.indexOf(i) : 0), i.id, skip), cliffMat);\n    cliff.castShadow = true;\n    cliff.receiveShadow = true;\n    cliff.userData = { type: \"island\", id: i.id };\n    scene.add(cliff);\n    // the band is one open six-sided cylinder; a joined island builds it face by face and leaves out the joined faces\n    // (cylinder face j spans theta -60(j+1)°..-60j°, which is hex edge j; u keeps its place on the full band texture)\n    let bandGeo = new THREE.CylinderGeometry(R + 0.012, R - 0.002, 0.16, 6, 1, true);\n    if (skip.size) {\n      const faces = [];\n      for (let e = 0; e < 6; e++) {\n        if (skip.has(e)) continue;\n        const f = new THREE.CylinderGeometry(R + 0.012, R - 0.002, 0.16, 1, 1, true, (-(e + 1) * Math.PI) / 3, Math.PI / 3);\n        const uvs = f.attributes.uv;\n        for (let n = 0; n < uvs.count; n++) uvs.setX(n, (5 - e + uvs.getX(n)) / 6);\n        faces.push(f);\n      }\n      bandGeo = mergeGeometries(faces);\n    }\n    const band = new THREE.Mesh(bandGeo, new THREE.MeshStandardMaterial({ map: bandTexture(THREE, i.id), roughness: 0.85 }));\n    band.position.set(c.x, TOP - 0.04, c.z);\n    band.receiveShadow = true;\n    scene.add(band);\n    // shallow-water and foam rings: merged after the loop. Neighbouring shallow rings overlap in the channels; inside one\n    // mesh they always draw in island order, so the overlap can no longer flicker between two tints (2026-10-29 fix kept).\n    merged.shallow.push(tinted(hexRingGeometry(THREE, R + 0.7, R - 0.02).translate(c.x, WATER_Y + 0.008, c.z), SHALLOW_TONE[i.id] || 0xb9d9d6));\n    merged.foam.push(hexRingGeometry(THREE, R + 0.16, R - 0.02).translate(c.x, WATER_Y + 0.012, c.z));\n    // outline (selection)\n    const pts = Array.from({ length: 7 }, (_, k) => {\n      const [x, z] = hexVertex(c.x, c.z, R + 0.01, k);\n      return new THREE.Vector3(x, TOP + 0.07, z);\n    });\n    const outline = new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), new THREE.LineBasicMaterial({ color: colors.coral }));\n    outline.visible = false;\n    scene.add(outline);\n    const nb = [];\n    for (const [dq, dr] of NEIGHBORS) {\n      const id = axialMap.get([i.axial[0] + dq, i.axial[1] + dr].join(\",\"));\n      nb.push(id ? { id, dq, dr } : { id: null, dq, dr });\n    }\n    neighbors.set(i.id, nb);\n    islandViews.set(i.id, { top: topMesh, cliff, outline, type, topMat: topMats[type], band, frontJoined: skip.has(0) || skip.has(5) });\n  }\n  // 2026-10-30: one mesh per kind for all islands (was one per island: 16 rings + 32 curbs + 16 shallow + 16 foam = 80\n  // draw calls, now 4). Islands are picked by their top and cliff meshes, so nothing here needs its own object.\n  const ring = new THREE.Mesh(mergeGeometries(merged.ring), ringMat.clone());\n  ring.material.vertexColors = true;\n  ring.material.color.setHex(0xffffff); // the per-island tint now lives in the vertex colours\n  ring.receiveShadow = true;\n  // (joined islands build their curb edge by edge, unindexed and without uv: bring every piece to that form first)\n  const curbParts = merged.curb.map((g) => {\n    const n = g.index ? g.toNonIndexed() : g;\n    if (n.attributes.uv) n.deleteAttribute(\"uv\");\n    if (!n.attributes.normal) n.computeVertexNormals();\n    return n;\n  });\n  const curb = new THREE.Mesh(mergeGeometries(curbParts), curbMat);\n  const shallow = new THREE.Mesh(mergeGeometries(merged.shallow), new THREE.MeshBasicMaterial({ vertexColors: true, transparent: true, opacity: 0.55, depthWrite: false }));\n  shallow.renderOrder = -2;\n  const foam = new THREE.Mesh(mergeGeometries(merged.foam), foamMat);\n  foam.renderOrder = -1;\n  for (const m of [ring, curb, shallow, foam]) scene.add(m);\n  for (const v of islandViews.values()) Object.assign(v, { ring, curb });\n  // 族群與語言: the channels between groupmates are paved land (a plaza in the walkway tiles), with a water-tinted skirt\n  // and a low curb only on the open ends that face the sea\n  const land = groupLand(THREE, D, centers);\n  const landMat = new THREE.MeshStandardMaterial({ map: ringMat.map, roughness: 0.9, color: 0xf1e7da });\n  const landCaps = [],\n    landCurbs = [],\n    landWalls = [];\n  for (const piece of land) {\n    const pts = piece.pts,\n      n = pts.length;\n    const pos = [];\n    for (let k = 1; k < n - 1; k++) pos.push(pts[0][0], TOP + 0.002, pts[0][1], pts[k][0], TOP + 0.002, pts[k][1], pts[k + 1][0], TOP + 0.002, pts[k + 1][1]);\n    const cap = new THREE.BufferGeometry();\n    cap.setAttribute(\"position\", new THREE.Float32BufferAttribute(pos, 3));\n    fixUp(cap);\n    const uvA = [];\n    for (let k = 0; k < pos.length; k += 3) uvA.push(pos[k] / 2.2, pos[k + 2] / 2.2);\n    cap.setAttribute(\"uv\", new THREE.Float32BufferAttribute(uvA, 2));\n    cap.computeVertexNormals();\n    landCaps.push(cap);\n    // open ends: an edge of this piece that no hex edge and no other piece covers\n    const onHex = (ax, az, bx, bz) => piece.ids.some((id) => {\n      const c = centers.get(id);\n      for (let k = 0; k < 6; k++) {\n        const [vx, vz] = hexVertex(c.x, c.z, R, k),\n          [wx, wz] = hexVertex(c.x, c.z, R, k + 1);\n        if ((Math.hypot(vx - ax, vz - az) < 1e-3 && Math.hypot(wx - bx, wz - bz) < 1e-3) || (Math.hypot(vx - bx, vz - bz) < 1e-3 && Math.hypot(wx - ax, wz - az) < 1e-3)) return true;\n      }\n      return false;\n    });\n    const shared = (ax, az, bx, bz) => land.some((o) => o !== piece && o.pts.some((p, m) => {\n      const q = o.pts[(m + 1) % o.pts.length];\n      return (Math.hypot(p[0] - ax, p[1] - az) < 1e-3 && Math.hypot(q[0] - bx, q[1] - bz) < 1e-3) || (Math.hypot(p[0] - bx, p[1] - bz) < 1e-3 && Math.hypot(q[0] - ax, q[1] - az) < 1e-3);\n    }));\n    const gx = pts.reduce((s2, p) => s2 + p[0], 0) / n,\n      gz = pts.reduce((s2, p) => s2 + p[1], 0) / n;\n    const open = [];\n    for (let k = 0; k < n; k++) {\n      const [ax, az] = pts[k],\n        [bx, bz] = pts[(k + 1) % n];\n      if (onHex(ax, az, bx, bz) || shared(ax, az, bx, bz)) continue;\n      open.push([ax, az, bx, bz]);\n      const len = Math.hypot(bx - ax, bz - az),\n        yaw = Math.atan2(bx - ax, bz - az);\n      // curb inset 0.035 so it sits on the land, like the hex curb (R .. R-0.07)\n      const ix = gx - (ax + bx) / 2,\n        iz = gz - (az + bz) / 2,\n        il = Math.hypot(ix, iz);\n      landCurbs.push(new THREE.BoxGeometry(0.07, 0.012, len).rotateY(yaw).translate((ax + bx) / 2 + (ix / il) * 0.035, TOP + 0.04, (az + bz) / 2 + (iz / il) * 0.035));\n    }\n    if (open.length) landWalls.push(wallGeometry(THREE, open, gx, gz, TOP + 0.04, WATER_Y - 0.5, GROUND_TONE.courtyard || 0xd8c8b0, 7, piece.ids[0]));\n  }\n  if (land.length) {\n    const capMesh = new THREE.Mesh(mergeGeometries(landCaps), landMat);\n    capMesh.receiveShadow = true;\n    capMesh.userData = { type: \"island\", id: land[0].ids[0], land: true };\n    scene.add(capMesh);\n    if (landCurbs.length) scene.add(new THREE.Mesh(mergeGeometries(landCurbs), curbMat));\n    if (landWalls.length) {\n      const wall = new THREE.Mesh(mergeGeometries(landWalls), cliffMat);\n      wall.receiveShadow = true;\n      scene.add(wall);\n      landMeshes.walls = wall;\n    }\n    landMeshes.cap = capMesh;\n  }\n  // bridges between neighbouring islands\n  const bridges = [];\n  const seen = new Set();\n  for (const [id, nb] of neighbors)\n    for (const n of nb) {\n      if (!n.id) continue;\n      const key = [id, n.id].sort().join(\"|\");\n      if (seen.has(key)) continue;\n      seen.add(key);\n      const a = centers.get(id),\n        b = centers.get(n.id);\n      const [dx, dz] = dirOf(n.dq, n.dr);\n      const ri = RING_R * 0.8660254;\n      const pa = new THREE.Vector3(a.x + dx * ri, TOP, a.z + dz * ri),\n        pb = new THREE.Vector3(b.x - dx * ri, TOP, b.z - dz * ri);\n      if (sameGroup(D, id, n.id)) {\n        // same landmass: the walkway simply carries on across the land join (kept in `bridges` with land: true, so the\n        // walking graph, the viaduct clearances and the QA all still see the crossing)\n        bridges.push({ a: id, b: n.id, pa, pb, land: true });\n        continue;\n      }\n      bridges.push({ a: id, b: n.id, pa, pb });\n      kit.setIsland(null);\n      const len = pa.distanceTo(pb),\n        yaw = Math.atan2(dx, dz);\n      const mid = pa.clone().lerp(pb, 0.5);\n      // bridge style follows the more characteristic of the two islands\n      const owner = BRIDGE_PRIORITY.find((x) => x === id || x === n.id) || id;\n      const st = BRIDGE_STYLE[owner] || BRIDGE_STYLE.default;\n      for (let s = 0; s <= 8; s++) {\n        const t = s / 8;\n        const pnt = pa.clone().lerp(pb, t);\n        const arch = Math.sin(t * Math.PI) * st.arch;\n        const tilt = Math.cos(t * Math.PI) * -st.arch * 2;\n        if (st.log) kit.part(\"cylinder\", [pnt.x, TOP + 0.04 + arch, pnt.z], [0.05, 0.32, 0.05], s % 2 ? st.deck[0] : st.deck[1], null, [0, yaw + Math.PI / 2, Math.PI / 2]);\n        else kit.hbox(pnt.x, TOP + 0.03 + arch, pnt.z, 0.3, 0.035, len / 9 + 0.01, s % 2 ? st.deck[0] : st.deck[1], null, [tilt, yaw, 0]);\n      }\n      for (const side of [-1, 1]) {\n        const ox = Math.cos(yaw) * 0.15 * side,\n          oz = -Math.sin(yaw) * 0.15 * side;\n        if (st.rail === \"wall\") {\n          for (let s = 0; s < 4; s++) {\n            const t = (s + 0.5) / 4,\n              pnt = pa.clone().lerp(pb, t);\n            kit.hbox(pnt.x + ox, TOP + 0.1 + Math.sin(t * Math.PI) * st.arch, pnt.z + oz, 0.04, 0.1, len / 4 + 0.02, st.post, null, [Math.cos(t * Math.PI) * -st.arch * 2, yaw, 0]);\n          }\n          continue;\n        }\n        for (let s = 0; s <= 4; s++) {\n          const t = s / 4,\n            pnt = pa.clone().lerp(pb, t);\n          kit.hbox(pnt.x + ox, TOP + 0.13 + Math.sin(t * Math.PI) * st.arch, pnt.z + oz, 0.022, 0.16, 0.022, st.post);\n          if (st.rail === \"planter\" && s % 2 === 1) {\n            kit.hbox(pnt.x + ox * 1.25, TOP + 0.12 + Math.sin(t * Math.PI) * st.arch, pnt.z + oz * 1.25, 0.08, 0.06, 0.12, 0xb48560, null, [0, yaw, 0]);\n            kit.ico(pnt.x + ox * 1.25, TOP + 0.18 + Math.sin(t * Math.PI) * st.arch, pnt.z + oz * 1.25, [0.09, 0.06, 0.12], s % 4 === 1 ? 0xf2b5c6 : 0x8db86f);\n          }\n        }\n        kit.hbox(mid.x + ox, TOP + 0.21 + st.arch * 0.66, mid.z + oz, st.rail === \"glass\" ? 0.012 : 0.02, st.rail === \"glass\" ? 0.12 : 0.02, len, st.handrail, null, [0, yaw, 0]);\n      }\n    }\n  return { centers, neighbors, islandViews, bridges, textures, topMats, land, landMeshes };\n}\n\n// Pedestrian graph: 12 ring nodes per island (vertices + edge midpoints), bridges connect edge midpoints.\nexport function buildGraph(THREE, D, centers, neighbors) {\n  const nodes = [],\n    adj = [],\n    ringIndex = new Map();\n  const add = (p, island) => {\n    nodes.push({ p, island });\n    adj.push([]);\n    return nodes.length - 1;\n  };\n  const link = (a, b) => {\n    const d = nodes[a].p.distanceTo(nodes[b].p);\n    adj[a].push([b, d]);\n    adj[b].push([a, d]);\n  };\n  for (const i of D.islands) {\n    const c = centers.get(i.id),\n      ids = [];\n    for (let k = 0; k < 6; k++) {\n      const [vx, vz] = hexVertex(c.x, c.z, RING_R, k),\n        [wx, wz] = hexVertex(c.x, c.z, RING_R, k + 1);\n      ids.push(add(new THREE.Vector3(vx, TOP + 0.03, vz), i.id));\n      ids.push(add(new THREE.Vector3((vx + wx) / 2, TOP + 0.03, (vz + wz) / 2), i.id));\n    }\n    for (let k = 0; k < 12; k++) link(ids[k], ids[(k + 1) % 12]);\n    ringIndex.set(i.id, ids);\n  }\n  // edge midpoint index for a direction\n  const midFor = (id, dq, dr) => {\n    const c = centers.get(id),\n      [dx, dz] = dirOf(dq, dr),\n      ids = ringIndex.get(id);\n    let best = null,\n      bd = 1e9;\n    for (let k = 1; k < 12; k += 2) {\n      const p = nodes[ids[k]].p,\n        d = (p.x - c.x - dx * 2) ** 2 + (p.z - c.z - dz * 2) ** 2;\n      if (d < bd) {\n        bd = d;\n        best = ids[k];\n      }\n    }\n    return best;\n  };\n  // 2026-10-29: remember each bridge's arch so walkers and connection lines ride over the deck instead of cutting\n  // through it (a straight line at walkway height sank into arched decks and its dashes flickered against the planks)\n  const bridgeInfo = new Map();\n  const pairKey = (a, b) => (a < b ? a + \"-\" + b : b + \"-\" + a);\n  for (const [id, nb] of neighbors)\n    for (const n of nb)\n      if (n.id && id < n.id) {\n        const a = midFor(id, n.dq, n.dr),\n          b = midFor(n.id, -n.dq, -n.dr);\n        link(a, b);\n        const owner = BRIDGE_PRIORITY.find((x) => x === id || x === n.id) || id;\n        const st = BRIDGE_STYLE[owner] || BRIDGE_STYLE.default;\n        bridgeInfo.set(pairKey(a, b), sameGroup(D, id, n.id) ? { arch: 0, deck: 0 } : { arch: st.arch, deck: st.log ? 0.035 : 0.0175 });\n      }\n  // node path → points, with each bridge crossing following its arched deck (same profile as the deck planks)\n  function pathPoints(ids) {\n    const out = [];\n    for (let k = 0; k < ids.length; k++) {\n      const p = nodes[ids[k]].p;\n      const br = k > 0 && bridgeInfo.get(pairKey(ids[k - 1], ids[k]));\n      if (br) {\n        const a = nodes[ids[k - 1]].p;\n        for (let s = 1; s < 8; s++) {\n          const t = s / 8,\n            q = a.clone().lerp(p, t);\n          q.y = TOP + 0.03 + br.deck + Math.sin(t * Math.PI) * br.arch;\n          out.push(q);\n        }\n      }\n      out.push(p.clone());\n    }\n    return out;\n  }\n  function shortest(a, b) {\n    const dist = new Array(nodes.length).fill(Infinity),\n      prev = new Array(nodes.length).fill(-1),\n      done = new Array(nodes.length).fill(false);\n    dist[a] = 0;\n    for (;;) {\n      let u = -1,\n        best = Infinity;\n      for (let i = 0; i < nodes.length; i++)\n        if (!done[i] && dist[i] < best) {\n          best = dist[i];\n          u = i;\n        }\n      if (u < 0 || u === b) break;\n      done[u] = true;\n      for (const [v, w] of adj[u])\n        if (dist[u] + w < dist[v]) {\n          dist[v] = dist[u] + w;\n          prev[v] = u;\n        }\n    }\n    const path = [];\n    for (let v = b; v >= 0; v = prev[v]) path.unshift(v);\n    return path[0] === a ? path : [a];\n  }\n  // pick the ring node on island `id` closest to world point p\n  function nodeNear(id, p) {\n    let best = null,\n      bd = 1e9;\n    for (const n of ringIndex.get(id)) {\n      const d = nodes[n].p.distanceToSquared(p);\n      if (d < bd) {\n        bd = d;\n        best = n;\n      }\n    }\n    return best;\n  }\n  const isEdge = (a, b) => adj[a].some(([v]) => v === b);\n  return { nodes, ringIndex, shortest, nodeNear, midFor, isEdge, pathPoints };\n}\n\n// Generic slot layout for policy miniatures inside the building zone.\nexport function slotLayout(n, heroSize) {\n  const hh = heroSize / 2,\n    heroZ = -0.58;\n  for (let s = n <= 4 ? 0.62 : n <= 7 ? 0.56 : n <= 10 ? 0.5 : 0.46; s > 0.3; s -= 0.03) {\n    const h = s / 2,\n      gapX = s + 0.1,\n      gapZ = s + 0.08,\n      out = [];\n    for (let zi = -4; zi <= 4; zi++)\n      for (let xi = -5; xi <= 5; xi++) {\n        const z = 0.2 + zi * gapZ,\n          x = (xi + (Math.abs(zi) % 2 ? 0.5 : 0)) * gapX;\n        const cornersOk = [\n          [x - h, z - h],\n          [x + h, z - h],\n          [x - h, z + h],\n          [x + h, z + h],\n        ].every(([px, pz]) => insideHex(px, pz, INNER - 0.04));\n        if (!cornersOk) continue;\n        if (Math.abs(x) < hh + h + 0.06 && Math.abs(z - heroZ) < hh + h + 0.06) continue;\n        out.push([x, z]);\n      }\n    if (out.length >= n) {\n      out.sort((a, b) => Math.hypot(a[0], a[1] - 0.25) - Math.hypot(b[0], b[1] - 0.25));\n      return { size: s, slots: out.slice(0, n).sort((a, b) => a[1] - b[1] || a[0] - b[0]), heroZ };\n    }\n  }\n  throw new Error(\"layout overflow \" + n);\n}\n\n// Keep island rendering resilient when the page and policy data are briefly\n// served