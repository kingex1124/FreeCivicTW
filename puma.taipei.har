"plain\": {\n            \"zh\": \"改善河濱公園的照明、人車動線，以及休憩、急救等設備，成為安全便利的運動場域。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"河濱運動的市民\",\n            \"en\": null\n          }\n        },\n        {\n          \"id\": \"sport-hub\",\n          \"name\": {\n            \"zh\": \"運動驛站\",\n            \"en\": \"Sport hub\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"重點捷運站旁、登山口\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"利用零碎時間運動\",\n              \"en\": null\n            }\n          ],\n          \"phase\": {\n            \"label\": {\n              \"zh\": \"第 1 年盤點捷運站旁與登山口\",\n              \"en\": null\n            },\n            \"stages\": [\n              \"year1\"\n            ],\n            \"basis\": \"official\"\n          },\n          \"flows\": [\n            \"F1\",\n            \"F7\",\n            \"F8\",\n            \"F13\"\n          ],\n          \"sources\": [\n            \"sport\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"在重點捷運站旁與登山口設運動驛站，讓運動能排進行程的空檔。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"通勤族與登山客\",\n            \"en\": null\n          }\n        },\n        {\n          \"id\": \"sport-football\",\n          \"name\": {\n            \"zh\": \"關渡國際足球場\",\n            \"en\": \"Guandu international football stadium\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"符合國際賽事\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"城市主場\",\n              \"en\": null\n            }\n          ],\n          \"phase\": {\n            \"label\": {\n              \"zh\": \"第 1 年啟動、第 2–3 年完成可行性評估\",\n              \"en\": null\n            },\n            \"stages\": [\n              \"year1\",\n              \"year2-3\"\n            ],\n            \"basis\": \"official\"\n          },\n          \"flows\": [\n            \"F1\",\n            \"F7\",\n            \"F8\",\n            \"F13\"\n          ],\n          \"sources\": [\n            \"sport\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"規劃符合國際賽事的關渡國際足球場，建立台北的城市主場。\",\n            \"en\": null\n          },\n          \"who\": null\n        },\n        {\n          \"id\": \"sport-huabo\",\n          \"name\": {\n            \"zh\": \"花博旗艦運動中心\",\n            \"en\": \"Huabo flagship sport center\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"補足大眾運動需求\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"新興與適應運動\",\n              \"en\": null\n            }\n          ],\n          \"phase\": {\n            \"label\": {\n              \"zh\": \"第 1 年啟動、第 2–3 年完成改建可行性評估\",\n              \"en\": null\n            },\n            \"stages\": [\n              \"year1\",\n              \"year2-3\"\n            ],\n            \"basis\": \"official\"\n          },\n          \"flows\": [\n            \"F1\",\n            \"F7\",\n            \"F8\",\n            \"F13\"\n          ],\n          \"sources\": [\n            \"sport\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"改建花博旗艦運動中心，補足大眾運動需求，並增設新興與適應運動空間。\",\n            \"en\": null\n          },\n          \"who\": null\n        },\n        {\n          \"id\": \"sport-intern\",\n          \"name\": {\n            \"zh\": \"國際舞台\",\n            \"en\": \"Overseas sport internships\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"青年體育海外實習\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"國際社區型運動賽事\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"運動平權、運動外交\",\n              \"en\": null\n            }\n          ],\n          \"phase\": {\n            \"label\": {\n              \"zh\": \"第 1 年擴大實習、試辦賽事；第 2–3 年擴大舉辦\",\n              \"en\": null\n            },\n            \"stages\": [\n              \"year1\",\n              \"year2-3\"\n            ],\n            \"basis\": \"official\"\n          },\n          \"flows\": [\n            \"F1\",\n            \"F7\",\n            \"F8\",\n            \"F13\"\n          ],\n          \"sources\": [\n            \"sport\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"市府帶頭推動青年體育海外實習，並舉辦國際社區型運動賽事，讓運動交流常態化。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"台北青年\",\n            \"en\": null\n          }\n        },\n        {\n          \"id\": \"sport-access\",\n          \"name\": {\n            \"zh\": \"場館無障礙與性別友善\",\n            \"en\": null\n          },\n          \"facts\": [\n            {\n              \"zh\": \"全面盤點現有場館\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"無障礙與性別友善\",\n              \"en\": null\n            }\n          ],\n          \"phase\": {\n            \"label\": {\n              \"zh\": \"第 1 年啟動檢討；第 2–3 年完成空間改善\",\n              \"en\": null\n            },\n            \"stages\": [\n              \"year1\",\n              \"year2-3\"\n            ],\n            \"basis\": \"official\"\n          },\n          \"flows\": [\n            \"F1\",\n            \"F7\",\n            \"F8\",\n            \"F13\"\n          ],\n          \"sources\": [\n            \"sport\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"全面盤點並改善現有運動場館的無障礙與性別友善措施，全齡都能參與。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"所有市民\",\n            \"en\": null\n          }\n        }\n      ],\n      \"referenceSummary\": {\n        \"zh\": \"運動政策｜HEART：H、E、T\\n四層：社區運動小巴（到市民身邊，專業運動指導與營養諮詢）；巷口到河濱（每區新增 3–5 處特色運動據點、畸零地改口袋公園、河濱照明動線急救、重點捷運站旁與登山口設運動驛站）；城市主場（關渡國際足球場、花博旗艦運動中心、場館無障礙與性別友善）；國際舞台（運動外交、青年體育海外實習）。\\n藍圖：第 1 年盤點、行動健身小巴試辦、場館檢討、足球場與花博中心可行性評估啟動；第 2–3 年完成 10 項社區微型運動場所改造、擴大小巴路線、完成可行性評估；第 4 年起全市運動生態系啟動。\",\n        \"en\": null\n      },\n      \"referenceSummaryProvenance\": \"appendix-a\",\n      \"unknowns\": [],\n      \"vision\": {\n        \"zh\": \"運動應該能夠包容每一個台北市民，並帶領台北走向國際。\",\n        \"en\": null\n      }\n    },\n    {\n      \"id\": \"trails\",\n      \"number\": 10,\n      \"name\": {\n        \"zh\": \"台北文化徑×山林徑\",\n        \"en\": \"Culture and mountain trails\"\n      },\n      \"summary\": {\n        \"zh\": \"四大文化徑（城市歷史記憶、產業文化遺跡、多元族群、人權）與三大登山觀光中心，把城市歷史與山林串成一體\",\n        \"en\": null\n      },\n      \"heart\": [\n        \"H\",\n        \"A\"\n      ],\n      \"heartLabel\": {\n        \"zh\": \"H、A\",\n        \"en\": null\n      },\n      \"url\": \"https://puma.taipei/policies/台北文化徑×山林徑\",\n      \"sources\": [\n        \"trails\"\n      ],\n      \"sourceKind\": \"official_policy\",\n      \"axial\": [\n        1,\n        0\n      ],\n      \"cells\": [\n        [\n          1,\n          0\n        ]\n      ],\n      \"buildings\": [\n        {\n          \"id\": \"trails-north\",\n          \"name\": {\n            \"zh\": \"劍潭登山觀光中心\",\n            \"en\": \"Jiantan visitor centre\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"串聯士林夜市與故宮\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"裝備租借、置物櫃、更衣室、洗鞋區\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"中英日韓四語導覽、即時步道狀態、生態季節導覽預約\",\n              \"en\": null\n            }\n          ],\n          \"phase\": null,\n          \"flows\": [\n            \"F1\",\n            \"F7\"\n          ],\n          \"sources\": [\n            \"trails\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"整合登山服務的據點，串聯士林夜市與故宮，提供裝備租借、置物更衣與洗鞋，以及四語導覽、即時步道狀態與生態季節導覽預約。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"登山客與旅客\",\n            \"en\": null\n          }\n        },\n        {\n          \"id\": \"trails-east\",\n          \"name\": {\n            \"zh\": \"象山登山觀光中心\",\n            \"en\": \"Xiangshan visitor centre\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"串聯信義商圈與台北 101\",\n              \"en\": null,\n              \"tile\": {\n                \"zh\": \"\",\n                \"en\": null\n              }\n            },\n            {\n              \"zh\": \"裝備租借、置物櫃、更衣室、洗鞋區\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"中英日韓四語導覽、即時步道狀態、生態季節導覽預約\",\n              \"en\": null\n            }\n          ],\n          \"phase\": null,\n          \"flows\": [\n            \"F1\",\n            \"F7\"\n          ],\n          \"sources\": [\n            \"trails\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"整合登山服務的據點，串聯信義商圈與台北 101，提供裝備租借、置物更衣與洗鞋，以及四語導覽、即時步道狀態與生態季節導覽預約。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"登山客與旅客\",\n            \"en\": null\n          }\n        },\n        {\n          \"id\": \"trails-south\",\n          \"name\": {\n            \"zh\": \"貓空登山觀光中心\",\n            \"en\": \"Maokong visitor centre\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"串聯木柵茶園與動物園\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"裝備租借、置物櫃、更衣室、洗鞋區\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"中英日韓四語導覽、即時步道狀態、生態季節導覽預約\",\n              \"en\": null\n            }\n          ],\n          \"phase\": null,\n          \"flows\": [\n            \"F1\",\n            \"F7\"\n          ],\n          \"sources\": [\n            \"trails\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"整合登山服務的據點，串聯木柵茶園與動物園，提供裝備租借、置物更衣與洗鞋，以及四語導覽、即時步道狀態與生態季節導覽預約。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"登山客與旅客\",\n            \"en\": null\n          }\n        },\n        {\n          \"id\": \"trails-history\",\n          \"name\": {\n            \"zh\": \"城市歷史記憶徑\",\n            \"en\": \"City history trail\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"涵蓋「今日台北」\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"代表案例：艋舺、大稻埕、城內三市街\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"剝皮寮、龍山寺、清水祖師廟、大稻埕碼頭、霞海城隍廟、北門、中山堂廣場、二二八紀念公園\",\n              \"en\": null\n            }\n          ],\n          \"phase\": null,\n          \"flows\": [\n            \"F1\",\n            \"F7\"\n          ],\n          \"sources\": [\n            \"trails\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"串起台北不同年代的城市記憶，也包含「今日台北」。艋舺、大稻埕、城內三市街是其中的代表案例，可走過剝皮寮、龍山寺、大稻埕碼頭、北門等節點。\",\n            \"en\": null\n          },\n          \"who\": null\n        },\n        {\n          \"id\": \"trails-industry\",\n          \"name\": {\n            \"zh\": \"產業文化遺跡徑\",\n            \"en\": \"Industrial heritage trail\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"茶葉、糖業、煤礦、打石、溫泉\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"茶葉路徑連結大稻埕、南港與文山\",\n              \"en\": null\n            }\n          ],\n          \"phase\": null,\n          \"flows\": [\n            \"F1\",\n            \"F7\"\n          ],\n          \"sources\": [\n            \"trails\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"把茶葉、糖業、煤礦、打石與溫泉等產業記憶寫進路線，例如從北投街區走進溫泉山徑。\",\n            \"en\": null\n          },\n          \"who\": null\n        },\n        {\n          \"id\": \"trails-diverse\",\n          \"name\": {\n            \"zh\": \"多元族群徑\",\n            \"en\": \"Diverse communities trail\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"凱達格蘭文化館、原住民文化主題公園、臺北市客家文化主題公園\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"四四南村、中心新村、蟾蜍山煥民新村\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"台北車站方格大廳、台北清真寺\",\n              \"en\": null\n            }\n          ],\n          \"phase\": null,\n          \"flows\": [\n            \"F1\",\n            \"F7\",\n            \"F18\"\n          ],\n          \"sources\": [\n            \"trails\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"把原住民、眷村與國宅、客家與新移民的記憶納入文化徑。\",\n            \"en\": null\n          },\n          \"who\": null\n        },\n        {\n          \"id\": \"trails-rights\",\n          \"name\": {\n            \"zh\": \"人權記憶徑\",\n            \"en\": \"Human rights trail\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"馬場町紀念公園、陳文成紀念廣場\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"二二八相關場域\",\n              \"en\": null\n            }\n          ],\n          \"phase\": null,\n          \"flows\": [\n            \"F1\",\n            \"F7\"\n          ],\n          \"sources\": [\n            \"trails\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"把台北的人權記憶串成一條獨立的文化徑，走過紀念公園與相關場域。\",\n            \"en\": null\n          },\n          \"who\": null\n        },\n        {\n          \"id\": \"trails-card\",\n          \"name\": {\n            \"zh\": \"親子同行卡\",\n            \"en\": \"Family card\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"設籍台北 0–18 歲，每人每月 600 點\",\n              \"en\": null,\n              \"tile\": {\n                \"zh\": \"每月 600 點\",\n                \"en\": null\n              }\n            },\n            {\n              \"zh\": \"文化幣、運動幣、分齡閱讀禮袋\",\n              \"en\": null\n            }\n          ],\n          \"phase\": null,\n          \"flows\": [\n            \"F1\",\n            \"F7\"\n          ],\n          \"sources\": [\n            \"trails\",\n            \"card\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"文化徑與山林徑和親子同行卡串聯，支持全家一起探索城市。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"0–18 歲孩子與家長\",\n            \"en\": null\n          }\n        },\n        {\n          \"id\": \"trails-shuttle\",\n          \"name\": {\n            \"zh\": \"最後一哩接駁\",\n            \"en\": \"Metro shuttles\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"捷運站到登山口接駁\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"步道分級與安全資訊\",\n              \"en\": null\n            }\n          ],\n          \"phase\": null,\n          \"flows\": [\n            \"F1\",\n            \"F7\"\n          ],\n          \"sources\": [\n            \"trails\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"從捷運站到登山口補上最後一哩路，增開接駁並重新檢視步道分級與安全資訊。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"長者、行動不便者、不開車的市民\",\n            \"en\": null\n          }\n        }\n      ],\n      \"referenceSummary\": {\n        \"zh\": \"台北文化徑×山林徑｜HEART：H、A\\n目標：亞洲第一觀光登山城。\\n四大文化徑：城市歷史記憶（含今日台北；三市街為代表案例）；產業文化遺跡（茶葉、煤礦、溫泉路徑）；多元族群（原住民、眷村與國宅、客家、新移民）；人權。\\n三大登山觀光中心：劍潭（士林夜市、故宮）、象山（信義商圈、台北 101）、貓空（木柵茶園、動物園）；裝備租借、置物更衣洗鞋、四語導覽、即時步道狀態。\\n捷運站到登山口接駁；步道分級；長者、行動不便者、不開車市民友善。\",\n        \"en\": null\n      },\n      \"referenceSummaryProvenance\": \"appendix-a\",\n      \"unknowns\": [],\n      \"vision\": {\n        \"zh\": \"台北是被群山環抱的盆地，城區歷史與山林地景實際上應該為一體。\",\n        \"en\": null\n      }\n    },\n    {\n      \"id\": \"forest\",\n      \"number\": 11,\n      \"name\": {\n        \"zh\": \"都市微森林\",\n        \"en\": \"Urban forest\"\n      },\n      \"summary\": {\n        \"zh\": \"不只是多種樹，而是讓台北升級成一座能「養出森林」的城市\",\n        \"en\": null\n      },\n      \"heart\": [\n        \"H\",\n        \"R\"\n      ],\n      \"heartLabel\": {\n        \"zh\": \"H、R\",\n        \"en\": null\n      },\n      \"url\": \"https://puma.taipei/policies/都市微森林\",\n      \"sources\": [\n        \"forest\"\n      ],\n      \"sourceKind\": \"official_policy\",\n      \"axial\": [\n        0,\n        1\n      ],\n      \"cells\": [\n        [\n          0,\n          1\n        ]\n      ],\n      \"buildings\": [\n        {\n          \"id\": \"forest-law\",\n          \"name\": {\n            \"zh\": \"都市林自治條例\",\n            \"en\": \"Urban forest ordinance\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"專責、專法、專款、專業\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"先有根域，才准種樹\",\n              \"en\": null\n            }\n          ],\n          \"phase\": {\n            \"label\": {\n              \"zh\": \