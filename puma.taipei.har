        },\n            \"stages\": [\n              \"short\",\n              \"mid\"\n            ],\n            \"basis\": \"official\"\n          },\n          \"flows\": [\n            \"F1\",\n            \"F3\",\n            \"F4\",\n            \"F6\",\n            \"F10\",\n            \"F11\",\n            \"F12\",\n            \"F14\"\n          ],\n          \"sources\": [\n            \"education\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"補上特殊教育的斷點：擴大家庭教育中心串連資源，校園重新檢視特教助理員並增加人力。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"特教學生與家庭\",\n            \"en\": null\n          }\n        },\n        {\n          \"id\": \"education-prevention\",\n          \"name\": {\n            \"zh\": \"校園反毒\",\n            \"en\": \"Drug prevention and safety\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"斷來源、教拒絕、轉治療、司法為輔\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"校園周邊販售熱點與電子煙載具查緝\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"篩檢、簡短處遇及轉介治療（SBIRT）\",\n              \"en\": null\n            }\n          ],\n          \"phase\": null,\n          \"flows\": [\n            \"F1\",\n            \"F3\",\n            \"F4\",\n            \"F6\",\n            \"F10\",\n            \"F11\",\n            \"F12\",\n            \"F14\"\n          ],\n          \"sources\": [\n            \"education\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"反毒採「斷來源、教拒絕、轉治療、司法為輔」四層策略，需要協助的孩子優先進入治療與輔導。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"學生\",\n            \"en\": null\n          }\n        },\n        {\n          \"id\": \"education-ai\",\n          \"name\": {\n            \"zh\": \"AI 教學工具\",\n            \"en\": \"Classroom AI\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"市立高中、國中、國小\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"校管帳號、限定課堂時段、教師在場\",\n              \"en\": null\n            }\n          ],\n          \"phase\": {\n            \"label\": {\n              \"zh\": \"中期建立校園 AI 工具與安全使用機制\",\n              \"en\": null\n            },\n            \"stages\": [\n              \"mid\"\n            ],\n            \"basis\": \"official\"\n          },\n          \"flows\": [\n            \"F1\",\n            \"F3\",\n            \"F4\",\n            \"F6\",\n            \"F10\",\n            \"F11\",\n            \"F12\",\n            \"F14\"\n          ],\n          \"sources\": [\n            \"education\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"補助學校採購教育版 AI 工具，用校管帳號、限定課堂時段、教師在場保護孩子。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"學生\",\n            \"en\": null\n          }\n        },\n        {\n          \"id\": \"education-usr\",\n          \"name\": {\n            \"zh\": \"大學 USR 合作\",\n            \"en\": \"University USR\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"結合大學社會責任（USR）機制\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"大學以計畫模式研究市政議題\",\n              \"en\": null\n            }\n          ],\n          \"phase\": null,\n          \"flows\": [\n            \"F1\",\n            \"F3\",\n            \"F4\",\n            \"F6\",\n            \"F10\",\n            \"F11\",\n            \"F12\",\n            \"F14\"\n          ],\n          \"sources\": [\n            \"education\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"市府列出市政痛點，大學透過社會責任計畫研究議題、提出市政建議。\",\n            \"en\": null\n          },\n          \"who\": null\n        }\n      ],\n      \"referenceSummary\": {\n        \"zh\": \"教育政策｜HEART：E、A\\n背景：115 學年開學 44 個代課缺；國中缺額率六都最高。\\n8 項：①教師不超載：117 學年國小每班 24 人、國中 25 人，「減生不減師」；試辦國小雙導師、導師行政助理；「無痛行政」。②親師衝突：第三方機制、師生調解；擴大教師 EAP。③幼兒：117 學年幼幼班 10 人、幼兒園 24 人；公幼專任園長。④特教：擴大家庭教育中心，串接家庭一站通、育兒解憂、諮商、職場友善；檢討特教助理人力。⑤營養：彈性餐費、保留家長自費加價彈性、食農教育、在地小農。⑥學生安全：反毒四層「斷來源、教拒絕、轉治療、司法為輔」、SBIRT；八年 150 所通學區。⑦AI：補助公立高中、國中、國小購買教育版 AI 工具（學校管理帳號、限制課堂使用、教師督導）。⑧大學 USR：市府列出市政問題，由大學研究並提建議。\",\n        \"en\": null\n      },\n      \"referenceSummaryProvenance\": \"appendix-a\",\n      \"unknowns\": [],\n      \"vision\": {\n        \"zh\": \"教育政策不只關乎孩子在教室裡學到什麼，也取決於老師是否有足夠心力教學、家庭能否獲得支持。\",\n        \"en\": null\n      }\n    },\n    {\n      \"id\": \"lunch\",\n      \"number\": 5,\n      \"name\": {\n        \"zh\": \"營養午餐\",\n        \"en\": \"School meals\"\n      },\n      \"summary\": {\n        \"zh\": \"免費是基本保障，品質、營養與教育一起往上提升\",\n        \"en\": null\n      },\n      \"heart\": [\n        \"R\"\n      ],\n      \"heartLabel\": {\n        \"zh\": \"R\",\n        \"en\": null\n      },\n      \"url\": \"https://puma.taipei/policies/營養午餐\",\n      \"sources\": [\n        \"lunch\"\n      ],\n      \"sourceKind\": \"official_policy\",\n      \"axial\": [\n        0,\n        2\n      ],\n      \"cells\": [\n        [\n          0,\n          2\n        ]\n      ],\n      \"buildings\": [\n        {\n          \"id\": \"lunch-farm\",\n          \"name\": {\n            \"zh\": \"在地小農田\",\n            \"en\": \"Local farms\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"借鏡東京經驗\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"導入商業機制，促進在地小農與校園合作\",\n              \"en\": null\n            }\n          ],\n          \"phase\": {\n            \"label\": {\n              \"zh\": \"第三階段\",\n              \"en\": null\n            },\n            \"stages\": [\n              \"stage3\"\n            ],\n            \"basis\": \"official\"\n          },\n          \"flows\": [\n            \"F1\",\n            \"F14\"\n          ],\n          \"sources\": [\n            \"lunch\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"借鏡東京經驗，導入商業機制促進在地小農與校園合作，讓學生享用優質的在地食材。\",\n            \"en\": null\n          },\n          \"who\": null\n        },\n        {\n          \"id\": \"lunch-literacy\",\n          \"name\": {\n            \"zh\": \"食農教育\",\n            \"en\": \"Food education\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"活化校園閒置空間作為供餐場域\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"了解食物供應及經營管理的知識\",\n              \"en\": null\n            }\n          ],\n          \"phase\": {\n            \"label\": {\n              \"zh\": \"第三階段\",\n              \"en\": null\n            },\n            \"stages\": [\n              \"stage3\"\n            ],\n            \"basis\": \"official\"\n          },\n          \"flows\": [\n            \"F1\",\n            \"F14\"\n          ],\n          \"sources\": [\n            \"lunch\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"營養午餐食農教育可借鏡東京經驗，導入商業機制促進在地小農與校園合作，並進一步活化校園閒置空間作為供餐場域，讓學生享用優質的在地食材，同時了解食物供應及經營管理的知識。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"學生\",\n            \"en\": null\n          }\n        },\n        {\n          \"id\": \"lunch-price\",\n          \"name\": {\n            \"zh\": \"彈性餐費機制\",\n            \"en\": \"Flexible meal pricing\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"回應原物料價格上漲、天然災害、市場供需\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"先盤點現行餐費與供餐成本\",\n              \"en\": null\n            }\n          ],\n          \"phase\": {\n            \"label\": {\n              \"zh\": \"第一階段盤點；第二階段建立調整機制\",\n              \"en\": null\n            },\n            \"stages\": [\n              \"stage1\",\n              \"stage2\"\n            ],\n            \"basis\": \"official\"\n          },\n          \"flows\": [\n            \"F1\",\n            \"F14\"\n          ],\n          \"sources\": [\n            \"lunch\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"餐費能隨原物料價格、天然災害與市場供需調整，避免成本壓力影響孩子的餐食品質。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"學生、學校與供餐業者\",\n            \"en\": null\n          }\n        },\n        {\n          \"id\": \"lunch-subsidy\",\n          \"name\": {\n            \"zh\": \"弱勢補差額\",\n            \"en\": \"Support for disadvantaged students\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"全校決定加價，市府補足弱勢學生價差\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"優先補足弱勢與特殊需求學生\",\n              \"en\": null\n            }\n          ],\n          \"phase\": null,\n          \"flows\": [\n            \"F1\",\n            \"F14\"\n          ],\n          \"sources\": [\n            \"lunch\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"全校決定加價提升品質時，由市府替弱勢學生補足價差，讓每個孩子一起吃得更好。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"弱勢與特殊需求學生\",\n            \"en\": null\n          }\n        }\n      ],\n      \"referenceSummary\": {\n        \"zh\": \"營養午餐｜HEART：R\\n「免費，是讓每個孩子都能吃到午餐；品質，是讓每個孩子都能吃得營養。」\\n彈性餐費調整機制；在地小農與校園合作（借鏡東京經驗）；食農教育（活化校園閒置空間作為供餐場域）。\\n其他：全校決定加價時市府替弱勢學生補足價差。\",\n        \"en\": null\n      },\n      \"referenceSummaryProvenance\": \"appendix-a\",\n      \"unknowns\": [],\n      \"vision\": {\n        \"zh\": \"免費，是讓每個孩子都能吃到午餐；品質，是讓每個孩子都能吃得營養。\",\n        \"en\": null\n      }\n    },\n    {\n      \"id\": \"family\",\n      \"number\": 6,\n      \"name\": {\n        \"zh\": \"家庭一站通\",\n        \"en\": \"Family support\"\n      },\n      \"summary\": {\n        \"zh\": \"育兒的入口網站：從一個地方開始，找到後援與喘息的出口\",\n        \"en\": null\n      },\n      \"heart\": [\n        \"A\",\n        \"R\",\n        \"T\"\n      ],\n      \"heartLabel\": {\n        \"zh\": \"A、R、T\",\n        \"en\": null\n      },\n      \"url\": \"https://puma.taipei/policies/家庭一站通\",\n      \"sources\": [\n        \"family\"\n      ],\n      \"sourceKind\": \"official_policy\",\n      \"axial\": [\n        -1,\n        3\n      ],\n      \"cells\": [\n        [\n          -1,\n          3\n        ]\n      ],\n      \"buildings\": [\n        {\n          \"id\": \"family-station\",\n          \"name\": {\n            \"zh\": \"擴大家庭教育中心\",\n            \"en\": null\n          },\n          \"facts\": [\n            {\n              \"zh\": \"朝每區都有據點推進\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"階段性擴大至 0–18 歲孩子的家庭\",\n              \"en\": null,\n              \"tile\": {\n                \"zh\": \"0–18 歲\",\n                \"en\": null\n              }\n            },\n            {\n              \"zh\": \"孕產知識、產後情緒、職涯與育兒平衡\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"單親及隔代育兒\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"中小學法律、金融、心理通識\",\n              \"en\": null\n            }\n          ],\n          \"phase\": null,\n          \"flows\": [\n            \"F1\",\n            \"F10\",\n            \"F11\"\n          ],\n          \"sources\": [\n            \"family\"\n          ],\n          \"status\"