     \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"個案管理師訪視申請服務的家庭，了解需求、提供協助並轉介政府資源，搭配家庭教育陪伴師。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"申請服務的家庭\",\n            \"en\": null\n          }\n        },\n        {\n          \"id\": \"family-respite\",\n          \"name\": {\n            \"zh\": \"每週免費臨托\",\n            \"en\": \"Weekly respite care\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"滿 6 個月至 6 歲\",\n              \"en\": null,\n              \"tile\": {\n                \"zh\": \"6 個月–6 歲\",\n                \"en\": null\n              }\n            },\n            {\n              \"zh\": \"每週固定時數免費臨托\",\n              \"en\": null\n            }\n          ],\n          \"phase\": null,\n          \"flows\": [\n            \"F1\",\n            \"F10\",\n            \"F11\"\n          ],\n          \"sources\": [\n            \"family\"\n          ],\n          \"status\": {\n            \"zh\": \"政見\",\n            \"en\": \"Proposal\"\n          },\n          \"plain\": {\n            \"zh\": \"滿 6 個月至 6 歲的孩子每週有固定時數的免費臨時托育，讓家長能休息、社交、處理自己的事。\",\n            \"en\": null\n          },\n          \"who\": {\n            \"zh\": \"家長\",\n            \"en\": null\n          }\n        },\n        {\n          \"id\": \"family-counsel\",\n          \"name\": {\n            \"zh\": \"3＋6 心理諮商\",\n            \"en\": \"3+6 counseling\"\n          },\n          \"facts\": [\n            {\n              \"zh\": \"中央 3 次＋市府每胎加碼 6 次\",\n              \"en\": null,\n              \"tile\": {\n                \"zh\": \"每胎加碼 6 次\",\n                \"en\": null\n              }\n            },\n            {\n              \"zh\": \"產後一年內的家長，無條件\",\n              \"en\": null\n            },\n            {\n              \"zh\": \"中央方案依其適用資格辦理\",\n              \"en\": null\n            }\n          ],\n          \"phase\": null,\n          \"flows\": [\n 