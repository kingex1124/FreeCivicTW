            "text": "<!doctype html>\n<html lang=\"zh-Hant\">\n<head>\n<!-- Google tag (gtag.js) -->\n    <script async src=\"https://www.googletagmanager.com/gtag/js?id=G-55HDR9CSS2\"></script>\n    <script>\n        window.dataLayer = window.dataLayer || [];\n        function gtag(){dataLayer.push(arguments);}\n        gtag('js', new Date());\n        gtag('config', 'G-55HDR9CSS2');\n    </script>\n\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#DB6A41\"><title>HEART 政策島｜沈伯洋・台北順起來</title>\n<meta name=\"description\" content=\"一格政見，一座相連的城市。18 項政策主題、122 個細項，從一個改變開始，看見政策之間的關係。\">\n<link rel=\"canonical\" href=\"https://puma.taipei/heart-island\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:url\" content=\"https://puma.taipei/heart-island\">\n<meta property=\"og:locale\" content=\"zh_TW\">\n<meta property=\"og:site_name\" content=\"沈伯洋台北市長競選官方網站\">\n<meta property=\"og:title\" content=\"HEART 政策島｜沈伯洋・台北順起來\">\n<meta property=\"og:description\" content=\"一格政見，一座相連的城市。18 項政策主題、122 個細項，從一個改變開始，看見政策之間的關係。\">\n<meta property=\"og:image\" content=\"https://puma.taipei/images/heart-island-og-20261022.jpg\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"HEART 政策島｜沈伯洋・台北順起來\">\n<meta name=\"twitter:description\" content=\"一格政見，一座相連的城市。18 項政策主題、122 個細項，從一個改變開始，看見政策之間的關係。\">\n<meta name=\"twitter:image\" content=\"https://puma.taipei/images/heart-island-og-20261022.jpg\">\n\n<base href=\"/heart-island-assets/\">\n<link rel=\"stylesheet\" href=\"./ui.css?v=20261112-4\">\n<script type=\"importmap\">{\"imports\":{\"three\":\"./vendor/three/build/three.module.min.js\",\"three/addons/\":\"./vendor/three/examples/jsm/\"}}</script>\n<script>window.HEART_ISLAND_ALLOW_MODS = false;</script>\n<scri